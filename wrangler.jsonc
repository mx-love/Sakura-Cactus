{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sakura-cactus",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-05-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 3 * * 1"]
  },
  "d1_databases": [],
  "r2_buckets": []
}
