{
  "name": "sakura-cactus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "types": "wrangler types",
    "check": "astro check",
    "db:migration:create": "wrangler d1 migrations create sakura_blog_prod",
    "db:migration:apply:local": "wrangler d1 migrations apply sakura_blog_prod --local",
    "db:migration:apply:prod": "wrangler d1 migrations apply sakura_blog_prod --remote",
    "admin:create": "node --experimental-strip-types scripts/create-admin.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "latest",
    "@astrojs/react": "latest",
    "@tailwindcss/vite": "latest",
    "astro": "latest",
    "react": "latest",
    "react-dom": "latest",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "latest",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "wrangler": "latest"
  }
}
