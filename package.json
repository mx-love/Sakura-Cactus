{
  "name": "sakura-cactus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "deploy": "node scripts/prepare-cloudflare-config.mjs && astro build && wrangler deploy",
    "types": "wrangler types --include-runtime false",
    "check": "astro check",
    "db:migration:create": "wrangler d1 migrations create sakura_blog_prod",
    "db:migration:apply:local": "wrangler d1 migrations apply sakura_blog_prod --local",
    "db:migration:apply:prod": "wrangler d1 migrations apply sakura_blog_prod --remote",
    "test:article-image-viewer": "node --experimental-transform-types scripts/article-image-viewer.test.ts",
    "test:experience": "pnpm test:ci-types && pnpm test:d1-config && pnpm test:cache && pnpm test:ui && node --experimental-transform-types --experimental-loader ./scripts/test-alias-loader.mjs scripts/site-time.test.ts && node --experimental-transform-types --experimental-loader ./scripts/test-alias-loader.mjs scripts/site-search.test.ts && node --experimental-transform-types scripts/reading-share.test.ts && node --experimental-transform-types --experimental-loader ./scripts/test-alias-loader.mjs scripts/comments-cache.test.ts",
    "test:security": "node --experimental-transform-types scripts/security-checks.ts",
    "test:ci-types": "node scripts/ci-types.test.mjs",
    "test:cache": "node --experimental-transform-types --experimental-loader ./scripts/test-alias-loader.mjs scripts/public-cache.test.ts",
    "test:ui": "node --experimental-transform-types --experimental-loader ./scripts/test-alias-loader.mjs scripts/site-ui-config.test.ts && node --experimental-transform-types scripts/editor-experience.test.ts",
    "test:posts": "node --experimental-transform-types --experimental-loader ./scripts/test-alias-loader.mjs scripts/post-delete.test.ts",
    "test:data": "node --experimental-transform-types --experimental-loader ./scripts/test-alias-loader.mjs scripts/data-portability.test.ts",
    "test:data:fixtures": "node --experimental-transform-types --experimental-loader ./scripts/test-alias-loader.mjs scripts/data-portability.test.ts --fixtures",
    "test:data:fixtures:verify": "node --experimental-transform-types --experimental-loader ./scripts/test-alias-loader.mjs scripts/data-portability.test.ts --verify-fixtures",
    "test:d1-config": "node scripts/d1-test-config.test.mjs",
    "test:d1": "node scripts/d1-runtime-migration.test.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "13.5.2",
    "@astrojs/react": "5.0.5",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/noto-serif-sc": "5.3.1",
    "@tailwindcss/vite": "4.3.5",
    "astro": "6.4.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "tailwindcss": "4.3.5",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
    "wrangler": "4.92.0"
  }
}
