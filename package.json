{
  "name": "sakura-cactus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "deploy": "node scripts/prepare-cloudflare-config.mjs && astro build && wrangler deploy",
    "types": "wrangler types --include-runtime false",
    "check": "astro check",
    "db:migration:create": "wrangler d1 migrations create sakura_blog_prod",
    "db:migration:apply:local": "wrangler d1 migrations apply sakura_blog_prod --local",
    "db:migration:apply:prod": "wrangler d1 migrations apply sakura_blog_prod --remote",
    "admin:create": "node --experimental-strip-types scripts/create-admin.ts",
    "test:security": "node --experimental-transform-types scripts/security-checks.ts",
    "test:posts": "node --experimental-transform-types --experimental-loader ./scripts/test-alias-loader.mjs scripts/post-delete.test.ts",
    "test:data": "node --experimental-transform-types --experimental-loader ./scripts/test-alias-loader.mjs scripts/data-portability.test.ts",
    "test:data:fixtures": "node --experimental-transform-types --experimental-loader ./scripts/test-alias-loader.mjs scripts/data-portability.test.ts --fixtures",
    "test:data:fixtures:verify": "node --experimental-transform-types --experimental-loader ./scripts/test-alias-loader.mjs scripts/data-portability.test.ts --verify-fixtures",
    "test:d1": "node scripts/d1-runtime-migration.test.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "13.5.2",
    "@astrojs/react": "5.0.5",
    "@tailwindcss/vite": "4.3.0",
    "astro": "6.4.8",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "tailwindcss": "4.3.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@types/node": "26.1.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3",
    "wrangler": "4.92.0"
  }
}
