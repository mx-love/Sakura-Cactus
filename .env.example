# Sakura Cactus local example.
# Production deployment only needs two manually-added Cloudflare Secrets:
# ADMIN_USERNAME and ADMIN_PASSWORD.
#
# Optional public variables, if you want to override the defaults:
# SITE_NAME="Sakura Cactus"
# SITE_TAGLINE="温柔地写，安静地发布。"
# SITE_DESCRIPTION="一些文章、笔记，以及慢慢整理的想法。"
# SITE_AVATAR_URL="https://example.com/avatar.png"

# Required Cloudflare Secrets:
# ADMIN_USERNAME=sakura
# ADMIN_PASSWORD=change-me
