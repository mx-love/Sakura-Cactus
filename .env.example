# Sakura Cactus local example.
# In production, configure these in the Cloudflare Dashboard:
# ADMIN_USERNAME as Text, ADMIN_PASSWORD as Secret, and SITE_URL as Text.
# The login form accepts the same username and password values directly.
# SESSION_SECRET is an optional advanced Secret; when omitted, sessions are
# protected with a key derived from ADMIN_PASSWORD.
#
# SITE_URL may be omitted during local development; localhost:4321 is used.
# SITE_URL=https://blog.example.com
#
# Optional public variables:
# SITE_NAME="Sakura Cactus"
# SITE_TAGLINE="温柔地写，安静地发布。"
# SITE_DESCRIPTION="一些文章、笔记，以及慢慢整理的想法。"
# SITE_AVATAR_URL="https://example.com/avatar.png"
# PUBLIC_COMMENTS_SERVER_URL="https://your-waline.example.com"

# Required administrator credentials:
# ADMIN_USERNAME=sakura
# ADMIN_PASSWORD=change-me
#
# Optional advanced session key (at least 32 characters):
# SESSION_SECRET=replace-with-an-independent-random-secret
