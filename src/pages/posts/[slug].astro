---
import SiteLayout from '@/components/layout/SiteLayout.astro';
import { getPublicPostBySlug } from '@/features/posts/post.service';

export const prerender = false;

const slug = Astro.params.slug;
const post = slug ? await getPublicPostBySlug(slug) : null;

if (!post) {
  return new Response('Not found', { status: 404 });
}

const title = post.seoTitle ?? post.title;
const description = post.seoDescription ?? post.excerpt ?? 'Sakura Cactus post.';
---

<SiteLayout title={`${title} | Sakura Cactus`} description={description}>
  <article class="sc-page">
    <div class="sc-shell">
      <a class="text-sm font-bold text-[var(--color-primary)] hover:underline" href="/articles">← 返回文章</a>
      <header class="py-10">
        <p class="text-sm text-[var(--color-muted)]">
          {post.publishedAt ? new Date(post.publishedAt).toLocaleDateString() : 'Published'}
        </p>
        <h1 class="mt-4 text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl">{post.title}</h1>
        {post.excerpt ? <p class="mt-5 text-lg leading-8 text-[var(--color-muted)]">{post.excerpt}</p> : null}
      </header>
      <div class="sc-prose prose-content" set:html={post.contentHtml} />
      <footer class="mt-12 flex flex-col gap-3 border-t border-[var(--color-border)] py-8 text-sm sm:flex-row sm:items-center sm:justify-between">
        <a class="font-bold text-[var(--color-primary)] hover:underline" href="/articles">返回文章列表</a>
        <a class="font-bold text-[var(--color-muted)] hover:text-[var(--color-primary)]" href="/timeline">查看时间轴</a>
      </footer>
    </div>
  </article>
</SiteLayout>
