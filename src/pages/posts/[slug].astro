---
import SiteLayout from '@/components/layout/SiteLayout.astro';
import '@/styles/prose.css';
import { PostDetailAdminActions } from '@/components/admin/PostDetailAdminActions';
import ArticleShare from '@/components/posts/ArticleShare.astro';
import EntryNav from '@/components/editorial/EntryNav.astro';
import CommentSlot from '@/components/comments/CommentSlot.astro';
import ArticleImageViewer from '@/components/posts/ArticleImageViewer.astro';
import { getCurrentAdminUser } from '@/features/auth/auth.service';
import { getAdjacentPublicPosts, getAdminPostBySlug, getPublicPostBySlug } from '@/features/posts/post.service';
import { addHeadingIdsToHtml } from '@/features/posts/post.renderer';
import { getPostViewCount, getSiteSettings } from '@/features/settings/settings.service';
import { ROBOTS_INDEX_FOLLOW, ROBOTS_NOINDEX_NOFOLLOW, absoluteSiteUrl, summarizeHtml } from '@/lib/seo';
import { formatSiteDate, formatSiteDotDate } from '@/lib/site-time';
import { env } from 'cloudflare:workers';

export const prerender = false;

const slug = Astro.params.slug;

if (slug === 'about') {
  return Astro.redirect(`/about${Astro.url.search}`);
}

const adminUser = await getCurrentAdminUser(Astro);
const publicPost = slug ? await getPublicPostBySlug(slug) : null;
const post = slug ? (publicPost ?? (adminUser ? await getAdminPostBySlug(slug) : null)) : null;

if (!post) {
  return new Response('Not found', { status: 404 });
}

const siteSettings = await getSiteSettings();
const siteName = env.SITE_NAME?.trim() || 'Sakura Cactus';
const viewCount = siteSettings.viewCountEnabled ? await getPostViewCount(post.id) : null;
const title = post.seoTitle ?? post.title;
const description = post.seoDescription ?? post.excerpt ?? summarizeHtml(post.contentHtml, post.title);
const canonicalUrl = absoluteSiteUrl(`/posts/${post.slug}`);
const ogImage = post.coverImageUrl?.startsWith('/')
  ? absoluteSiteUrl(post.coverImageUrl)
  : post.coverImageUrl;
const robots = publicPost ? ROBOTS_INDEX_FOLLOW : ROBOTS_NOINDEX_NOFOLLOW;
const publishedAt = post.publishedAt ? new Date(post.publishedAt) : null;
const updatedAt = new Date(post.updatedAt);
const shouldShowUpdatedAt = publishedAt ? updatedAt.getTime() - publishedAt.getTime() > 60_000 : false;
const { previous: olderPost, next: newerPost } = publicPost
  ? await getAdjacentPublicPosts(publicPost)
  : { previous: null, next: null };
const renderedContent = addHeadingIdsToHtml(post.contentHtml);
const tocHeadings = renderedContent.headings.filter((heading) => heading.depth === 2);
const showToc = tocHeadings.length >= 2;
const commentsServerURL = env.PUBLIC_COMMENTS_SERVER_URL?.trim() || '';
const blogPostingJsonLd = publicPost && post.publishedAt
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: post.title,
      description,
      url: canonicalUrl,
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalUrl
      },
      datePublished: post.publishedAt,
      dateModified: post.updatedAt,
      author: {
        '@type': 'Person',
        name: siteName,
        url: absoluteSiteUrl('/about')
      },
      inLanguage: 'zh-CN',
      ...(ogImage ? { image: ogImage } : {})
    }
  : undefined;

function formatDate(date: Date | null) {
  return formatSiteDate(date, 'long');
}

---

<SiteLayout siteSettings={siteSettings} title={`${title} | ${siteName}`} description={description} canonicalUrl={canonicalUrl} robots={robots} ogImage={ogImage ?? undefined} jsonLd={blogPostingJsonLd} ogType="article" publishedTime={post.publishedAt} modifiedTime={post.updatedAt}>
  <article class="sc-page">
    <div class="sc-reading-progress" aria-hidden="true">
      <span class="sc-reading-progress-bar" data-reading-progress></span>
    </div>
    <div class="sc-page-shell sc-article-shell">
      <a class="sc-article-back sc-label" href="/articles" data-astro-prefetch>← 返回文章</a>
      {showToc ? (
        <aside class="sc-article-toc" aria-label="文章目录">
          <p>纸页书签</p>
          <nav>
            {tocHeadings.map((heading) => (
              <a class={`sc-toc-link sc-toc-depth-${heading.depth}`} href={`#${heading.slug}`} data-toc-link={heading.slug} title={heading.text}>
                {heading.text}
              </a>
            ))}
          </nav>
        </aside>
      ) : null}
      {showToc ? (
        <>
          <button class="sc-mobile-toc-trigger" type="button" aria-label="打开文章目录" title="打开文章目录" aria-expanded="false" data-mobile-toc-trigger hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M8 6h12" />
              <path d="M8 12h12" />
              <path d="M8 18h12" />
              <path d="M4 6h.01" />
              <path d="M4 12h.01" />
              <path d="M4 18h.01" />
            </svg>
          </button>
          <div class="sc-mobile-toc-overlay" data-mobile-toc-overlay hidden>
            <button class="sc-mobile-toc-backdrop" type="button" aria-label="关闭文章目录" data-mobile-toc-close></button>
            <section class="sc-mobile-toc-sheet" role="dialog" aria-modal="true" aria-label="本文目录">
              <span class="sc-mobile-toc-handle" aria-hidden="true"></span>
              <header class="sc-mobile-toc-head">
                <h2>本文目录</h2>
                <button class="sc-mobile-toc-close" type="button" aria-label="关闭文章目录" data-mobile-toc-close>关闭</button>
              </header>
              <nav>
                {tocHeadings.map((heading) => (
                  <a class={`sc-toc-link sc-mobile-toc-link sc-toc-depth-${heading.depth}`} href={`#${heading.slug}`} data-toc-link={heading.slug} title={heading.text}>
                    {heading.text}
                  </a>
                ))}
              </nav>
            </section>
          </div>
        </>
      ) : null}
      <div class="sc-article-paper">
        <div class="sc-article-topbar sc-article-inner">
          <span></span>
          {adminUser ? (
            <PostDetailAdminActions client:load isAdmin={true} postId={post.id} isPinned={Boolean(post.pinnedAt)} />
          ) : (
            <ArticleShare title={post.title} />
          )}
        </div>
        <header class="sc-article-header">
          <div class="sc-article-inner">
            <p class="sc-label sc-article-meta">
              {publishedAt ? (
                <time datetime={post.publishedAt ?? undefined} title={formatDate(publishedAt)}>{formatSiteDotDate(publishedAt)}</time>
              ) : (
                <span>Draft</span>
              )}
              {shouldShowUpdatedAt ? <span>更新于 {formatSiteDotDate(updatedAt)}</span> : null}
              {viewCount !== null ? <span>阅读 {viewCount}</span> : null}
            </p>
            <h1>{post.title}</h1>
            {post.excerpt ? <p class="sc-article-subtitle">{post.excerpt}</p> : null}
            {post.tags.length > 0 ? (
              <div class="sc-tag-list sc-article-tags">
                {post.tags.map((tag) => (
                  <a class="sc-tag-link sc-draw-link" href={`/tags/${tag.slug}`}>{tag.name}</a>
                ))}
              </div>
            ) : null}
          </div>
        </header>
        <div
          class="sc-prose prose-content sc-article-prose sc-article-inner"
          data-article-image-viewer-root={publicPost ? true : undefined}
          set:html={renderedContent.html}
        />
        {publicPost ? <ArticleImageViewer /> : null}
        {publicPost ? (
          <div class="sc-article-inner">
            <EntryNav
              ariaLabel="文章导航"
              newer={newerPost ? { href: `/posts/${newerPost.slug}`, label: 'Newer · 更新的一篇', title: newerPost.title, detail: newerPost.publishedAt ? formatSiteDotDate(newerPost.publishedAt) : null } : null}
              older={olderPost ? { href: `/posts/${olderPost.slug}`, label: 'Older · 更早的一篇', title: olderPost.title, detail: olderPost.publishedAt ? formatSiteDotDate(olderPost.publishedAt) : null } : null}
            />
          </div>
        ) : null}
        <CommentSlot enabled={siteSettings.commentEnabled} serverURL={commentsServerURL} path={`/posts/${post.slug}`} />
        {siteSettings.viewCountEnabled && publicPost ? (
          <script define:vars={{ postId: post.id }} is:inline>
            const storageKey = `sakura:viewed:${postId}`;
            const twelveHours = 12 * 60 * 60 * 1000;
            const trackerKey = `sakura:${postId}`;
            window.__sakuraViewTracker = window.__sakuraViewTracker || {};
            const tracker = window.__sakuraViewTracker;

            function recentlyCounted() {
              try {
                const lastViewedAt = Number(window.localStorage.getItem(storageKey) || '0');
                return Number.isFinite(lastViewedAt) && Date.now() - lastViewedAt < twelveHours;
              } catch {
                return true;
              }
            }

            function markCounted() {
              try {
                window.localStorage.setItem(storageKey, String(Date.now()));
              } catch {
                return;
              }
            }

            if (!tracker[trackerKey] && !recentlyCounted()) {
              tracker[trackerKey] = {
                submitted: false
              };

              window.setTimeout(() => {
                const currentTracker = tracker[trackerKey];

                if (!currentTracker || currentTracker.submitted) {
                  return;
                }

                if (recentlyCounted()) {
                  return;
                }

                currentTracker.submitted = true;
                markCounted();

                fetch(`/api/views/${encodeURIComponent(postId)}`, {
                  method: 'POST',
                  credentials: 'same-origin',
                  keepalive: true
                })
                  .catch(() => undefined);
              }, 8000);
            }
          </script>
        ) : null}
        <script>
          import { bindReadingProgress } from '@/lib/reading-progress';

          bindReadingProgress();
        </script>
        {showToc ? (
          <script>
            // @ts-nocheck -- legacy inline DOM script; tracked for extraction in docs/SECURITY_AUDIT_REPORT.md.
            import { createDialogFocus } from '@/lib/dialog-focus';

            const tocLinks = Array.from(document.querySelectorAll('[data-toc-link]'));
            const headingsById = new Map();

            tocLinks.forEach((link) => {
              const id = link instanceof HTMLElement ? link.dataset.tocLink : '';
              const heading = id ? document.getElementById(id) : null;

              if (id && heading) {
                headingsById.set(id, heading);
              }
            });

            const headings = Array.from(headingsById.values());
            const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            const mobileTocTrigger = document.querySelector('[data-mobile-toc-trigger]');
            const mobileTocOverlay = document.querySelector('[data-mobile-toc-overlay]');
            const mobileTocSheet = mobileTocOverlay?.querySelector('.sc-mobile-toc-sheet');
            const mobileTocFocus = mobileTocSheet instanceof HTMLElement ? createDialogFocus(mobileTocSheet, {
              initialFocus: mobileTocSheet.querySelector('.sc-mobile-toc-close'),
              onEscape: () => closeMobileToc()
            }) : null;
            const siteFooter = document.querySelector('.sc-site-footer');
            const mobileTocCloseControls = Array.from(document.querySelectorAll('[data-mobile-toc-close]'));
            let activeHeadingId = '';
            let tocFrame = 0;

            function getTocOffset() {
              const header = document.querySelector('.sc-site-header');
              const headerHeight = header instanceof HTMLElement ? header.getBoundingClientRect().height : 0;
              return Math.max(96, headerHeight + 28);
            }

            function scrollActiveTocLinksIntoView() {
              document.querySelectorAll('.sc-toc-link-active').forEach((link) => {
                const container = link.closest('.sc-article-toc nav, .sc-mobile-toc-sheet');

                if (!(container instanceof HTMLElement) || !(link instanceof HTMLElement)) {
                  return;
                }

                const containerRect = container.getBoundingClientRect();
                const linkRect = link.getBoundingClientRect();

                if (linkRect.top < containerRect.top || linkRect.bottom > containerRect.bottom) {
                  link.scrollIntoView({ block: 'nearest' });
                }
              });
            }

            function setActiveToc(id) {
              activeHeadingId = id || '';

              tocLinks.forEach((link) => {
                if (!(link instanceof HTMLElement)) {
                  return;
                }

                const isActive = Boolean(activeHeadingId) && link.dataset.tocLink === activeHeadingId;
                link.classList.toggle('sc-toc-link-active', isActive);

                if (isActive) {
                  link.setAttribute('aria-current', 'location');
                } else {
                  link.removeAttribute('aria-current');
                }
              });

              scrollActiveTocLinksIntoView();
            }

            function updateActiveHeading() {
              if (headings.length === 0) {
                return;
              }

              const offset = getTocOffset();
              const documentElement = document.documentElement;
              const nearBottom = window.innerHeight + window.scrollY >= documentElement.scrollHeight - 8;
              let current = headings[0];

              if (nearBottom) {
                setActiveToc(headings[headings.length - 1].id);
                return;
              }

              for (const heading of headings) {
                if (heading.getBoundingClientRect().top <= offset) {
                  current = heading;
                } else {
                  break;
                }
              }

              setActiveToc(current.id);
            }

            function scheduleActiveUpdate() {
              if (tocFrame) {
                return;
              }

              tocFrame = window.requestAnimationFrame(() => {
                tocFrame = 0;
                syncMobileTocTrigger();
                updateActiveHeading();
              });
            }

            function closeMobileToc(restoreFocus = true) {
              if (!(mobileTocOverlay instanceof HTMLElement)) {
                return;
              }

              mobileTocOverlay.hidden = true;
              document.documentElement.classList.remove('sc-mobile-toc-open');
              mobileTocFocus?.deactivate({ restoreFocus });

              if (mobileTocTrigger instanceof HTMLButtonElement) {
                mobileTocTrigger.setAttribute('aria-expanded', 'false');
              }
            }

            function openMobileToc() {
              if (!(mobileTocOverlay instanceof HTMLElement)) {
                return;
              }

              mobileTocOverlay.hidden = false;
              document.documentElement.classList.add('sc-mobile-toc-open');

              if (mobileTocTrigger instanceof HTMLButtonElement) {
                mobileTocTrigger.setAttribute('aria-expanded', 'true');
              }

              updateActiveHeading();
              mobileTocFocus?.activate(mobileTocTrigger);
              const activeMobileLink = mobileTocSheet?.querySelector('.sc-toc-link-active');
              if (activeMobileLink instanceof HTMLElement) {
                activeMobileLink.scrollIntoView({ block: 'center' });
              }
            }

            function syncMobileTocTrigger() {
              if (!(mobileTocTrigger instanceof HTMLButtonElement)) {
                return;
              }

              mobileTocTrigger.hidden = false;
              if (!window.matchMedia('(max-width: 1535px)').matches) {
                closeMobileToc(false);
              }
              const footerIsVisible = siteFooter instanceof HTMLElement && siteFooter.getBoundingClientRect().top < window.innerHeight;
              mobileTocTrigger.classList.toggle('sc-mobile-toc-trigger-visible', window.scrollY > 240 && !footerIsVisible);
            }

            tocLinks.forEach((link) => {
              link.addEventListener('click', (event) => {
                const target = event.currentTarget;

                if (!(target instanceof HTMLAnchorElement)) {
                  return;
                }

                const id = decodeURIComponent(target.hash.slice(1));
                const heading = document.getElementById(id);

                if (!heading) {
                  return;
                }

                event.preventDefault();
                closeMobileToc(false);
                heading.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
                const hadTabIndex = heading.hasAttribute('tabindex');
                if (!hadTabIndex) heading.setAttribute('tabindex', '-1');
                heading.focus({ preventScroll: true });
                if (!hadTabIndex) heading.addEventListener('blur', () => heading.removeAttribute('tabindex'), { once: true });
                history.pushState(null, '', target.hash);
                setActiveToc(id);
              });
            });

            if (mobileTocTrigger instanceof HTMLButtonElement) {
              mobileTocTrigger.addEventListener('click', () => {
                if (mobileTocOverlay instanceof HTMLElement && !mobileTocOverlay.hidden) {
                  closeMobileToc();
                  return;
                }

                openMobileToc();
              });
            }

            mobileTocCloseControls.forEach((control) => {
              control.addEventListener('click', () => closeMobileToc());
            });

            // Trigger: drag it up/down (and across to the other edge) to wherever
            // the thumb is comfortable; the spot is remembered on this device.
            if (mobileTocTrigger instanceof HTMLButtonElement) {
              const POSITION_KEY = 'sc-mobile-toc-trigger-position';
              let suppressClick = false;
              let pointerId = null;
              let startX = 0;
              let startY = 0;
              let startTop = 0;
              let moved = false;

              const clampTop = (top) => {
                const min = 72;
                const max = window.innerHeight - mobileTocTrigger.offsetHeight - 16;
                return Math.min(Math.max(top, min), Math.max(min, max));
              };

              const applyPosition = (position) => {
                if (!position || typeof position.ratio !== 'number') return;
                const top = clampTop(position.ratio * window.innerHeight);
                mobileTocTrigger.style.top = `${top}px`;
                mobileTocTrigger.classList.add('sc-mobile-toc-trigger-placed');
                mobileTocTrigger.classList.toggle('sc-mobile-toc-trigger-left', position.side === 'left');
              };

              try {
                applyPosition(JSON.parse(localStorage.getItem(POSITION_KEY) ?? 'null'));
              } catch {
                // ignore unreadable saved position
              }

              mobileTocTrigger.addEventListener('pointerdown', (event) => {
                if (event.pointerType === 'mouse' && event.button !== 0) return;
                pointerId = event.pointerId;
                startX = event.clientX;
                startY = event.clientY;
                startTop = mobileTocTrigger.getBoundingClientRect().top;
                moved = false;
              });

              window.addEventListener('pointermove', (event) => {
                if (pointerId !== event.pointerId) return;
                const dx = event.clientX - startX;
                const dy = event.clientY - startY;
                if (!moved && Math.hypot(dx, dy) < 8) return;
                if (!moved) {
                  moved = true;
                  mobileTocTrigger.classList.add('sc-mobile-toc-trigger-placed', 'is-dragging');
                }
                event.preventDefault();
                mobileTocTrigger.style.top = `${clampTop(startTop + dy)}px`;
                mobileTocTrigger.classList.toggle('sc-mobile-toc-trigger-left', event.clientX < window.innerWidth / 2);
              });

              const finishDrag = (event) => {
                if (pointerId !== event.pointerId) return;
                pointerId = null;
                mobileTocTrigger.classList.remove('is-dragging');
                if (!moved) return;
                suppressClick = true;
                window.setTimeout(() => { suppressClick = false; }, 350);
                const top = mobileTocTrigger.getBoundingClientRect().top;
                const position = {
                  ratio: top / window.innerHeight,
                  side: mobileTocTrigger.classList.contains('sc-mobile-toc-trigger-left') ? 'left' : 'right'
                };
                try {
                  localStorage.setItem(POSITION_KEY, JSON.stringify(position));
                } catch {
                  // storage may be unavailable (private mode); position still applies for this visit
                }
              };

              window.addEventListener('pointerup', finishDrag);
              window.addEventListener('pointercancel', finishDrag);
              mobileTocTrigger.addEventListener('click', (event) => {
                if (suppressClick) {
                  event.preventDefault();
                  event.stopImmediatePropagation();
                  suppressClick = false;
                }
              }, true);
              window.addEventListener('resize', () => {
                if (!mobileTocTrigger.classList.contains('sc-mobile-toc-trigger-placed')) return;
                mobileTocTrigger.style.top = `${clampTop(mobileTocTrigger.getBoundingClientRect().top)}px`;
              });
            }

            // Drawer: drag the handle/header down to dismiss; the list itself scrolls.
            if (mobileTocSheet instanceof HTMLElement) {
              const dragZone = mobileTocSheet.querySelector('.sc-mobile-toc-head');
              const tocList = mobileTocSheet.querySelector('nav');
              let dragStartY = 0;
              let dragStartTime = 0;
              let dragOffset = 0;
              let dragging = false;

              const beginDrag = (event) => {
                const touch = event.touches?.[0];
                if (!touch) return;
                const fromHandle = event.target instanceof Element && (event.target.closest('.sc-mobile-toc-handle, .sc-mobile-toc-head') !== null);
                const listAtTop = !(tocList instanceof HTMLElement) || tocList.scrollTop <= 0;
                if (!fromHandle && !listAtTop) return;
                dragging = true;
                dragStartY = touch.clientY;
                dragStartTime = performance.now();
                dragOffset = 0;
                mobileTocSheet.classList.add('is-dragging');
              };

              const moveDrag = (event) => {
                if (!dragging) return;
                const touch = event.touches?.[0];
                if (!touch) return;
                dragOffset = Math.max(0, touch.clientY - dragStartY);
                if (dragOffset > 0 && event.cancelable) event.preventDefault();
                mobileTocSheet.style.transform = `translateY(${dragOffset}px)`;
              };

              const endDrag = () => {
                if (!dragging) return;
                dragging = false;
                mobileTocSheet.classList.remove('is-dragging');
                const velocity = dragOffset / Math.max(1, performance.now() - dragStartTime);
                const shouldClose = dragOffset > Math.min(140, mobileTocSheet.offsetHeight * 0.3) || velocity > 0.6;
                mobileTocSheet.style.transform = '';
                if (shouldClose) closeMobileToc();
              };

              mobileTocSheet.addEventListener('touchstart', beginDrag, { passive: true });
              mobileTocSheet.addEventListener('touchmove', moveDrag, { passive: false });
              mobileTocSheet.addEventListener('touchend', endDrag);
              mobileTocSheet.addEventListener('touchcancel', endDrag);
              void dragZone;
            }

            window.addEventListener('scroll', scheduleActiveUpdate, { passive: true });
            window.addEventListener('resize', scheduleActiveUpdate);
            window.addEventListener('hashchange', () => {
              const id = decodeURIComponent(window.location.hash.slice(1));

              if (id && headingsById.has(id)) {
                setActiveToc(id);
                return;
              }

              scheduleActiveUpdate();
            });

            syncMobileTocTrigger();
            if (window.location.hash) {
              const id = decodeURIComponent(window.location.hash.slice(1));

              if (id && headingsById.has(id)) {
                setActiveToc(id);
              } else {
                updateActiveHeading();
              }
            } else {
              updateActiveHeading();
            }
          </script>
        ) : null}
        <script>
          // @ts-nocheck -- legacy inline DOM script; tracked for extraction in docs/SECURITY_AUDIT_REPORT.md.
          import { bindCodeCopyControls } from '@/lib/prose-controls';

          function bindArticleCodeCopyControls() {
            bindCodeCopyControls(document.querySelector('.sc-article-prose, .prose-content') ?? document);
          }

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', bindArticleCodeCopyControls, { once: true });
          } else {
            bindArticleCodeCopyControls();
          }

          window.addEventListener('pageshow', bindArticleCodeCopyControls);
        </script>
      </div>
    </div>
  </article>
</SiteLayout>
