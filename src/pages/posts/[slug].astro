---
import SiteLayout from '@/components/layout/SiteLayout.astro';
import { PostDetailAdminActions } from '@/components/admin/PostDetailAdminActions';
import { getCurrentAdminUser } from '@/features/auth/auth.service';
import { getAdjacentPublicPosts, getAdminPostBySlug, getPublicPostBySlug } from '@/features/posts/post.service';
import { addHeadingIdsToHtml } from '@/features/posts/post.renderer';
import { getPostViewCount, getSiteSettings } from '@/features/settings/settings.service';

export const prerender = false;

const slug = Astro.params.slug;
const adminUser = await getCurrentAdminUser(Astro);
const publicPost = slug ? await getPublicPostBySlug(slug) : null;
const post = slug ? (publicPost ?? (adminUser ? await getAdminPostBySlug(slug) : null)) : null;

if (!post) {
  return new Response('Not found', { status: 404 });
}

const siteSettings = await getSiteSettings();
const viewCount = siteSettings.viewCountEnabled ? await getPostViewCount(post.id) : null;
const title = post.seoTitle ?? post.title;
const description = post.seoDescription ?? post.excerpt ?? 'Sakura Cactus post.';
const canonicalUrl = new URL(`/posts/${post.slug}`, Astro.url.origin).href;
const ogImage = post.coverImageUrl?.startsWith('/')
  ? new URL(post.coverImageUrl, Astro.url.origin).href
  : post.coverImageUrl;
const publishedAt = post.publishedAt ? new Date(post.publishedAt) : null;
const updatedAt = new Date(post.updatedAt);
const shouldShowUpdatedAt = publishedAt ? updatedAt.getTime() - publishedAt.getTime() > 60_000 : false;
const { previous: previousPost, next: nextPost } = publicPost
  ? await getAdjacentPublicPosts(publicPost)
  : { previous: null, next: null };
const renderedContent = addHeadingIdsToHtml(post.contentHtml);
const tocHeadings = renderedContent.headings.filter((heading) => heading.depth === 2);
const showToc = tocHeadings.length >= 2;

const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

function formatDate(date: Date | null) {
  return date ? dateFormatter.format(date) : '';
}

---

<SiteLayout title={`${title} | Sakura Cactus`} description={description} canonicalUrl={canonicalUrl} ogImage={ogImage ?? undefined}>
  <article class="sc-page">
    <div class="sc-article-shell">
      <a class="sc-article-back" href="/articles">← 返回文章</a>
      {showToc ? (
        <aside class="sc-article-toc" aria-label="文章目录">
          <p>纸页书签</p>
          <nav>
            {tocHeadings.map((heading) => (
              <a class={`sc-toc-link sc-toc-depth-${heading.depth}`} href={`#${heading.slug}`} data-toc-link={heading.slug} title={heading.text}>
                {heading.text}
              </a>
            ))}
          </nav>
        </aside>
      ) : null}
      <div class="sc-article-paper">
        <div class="sc-article-topbar">
          <span></span>
          <PostDetailAdminActions client:load isAdmin={Boolean(adminUser)} postId={adminUser ? post.id : undefined} isPinned={Boolean(post.pinnedAt)} />
        </div>
        <header class="sc-article-header">
          <div class="sc-article-inner">
            <p class="sc-post-meta sc-article-meta">
              {publishedAt ? (
                <>
                  <span class="sc-calendar-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M8 2v4" />
                      <path d="M16 2v4" />
                      <path d="M3 10h18" />
                      <rect x="3" y="4" width="18" height="18" rx="2" />
                    </svg>
                  </span>
                  <time datetime={post.publishedAt ?? undefined}>{formatDate(publishedAt)}</time>
                </>
              ) : (
                <span>Published</span>
              )}
              {shouldShowUpdatedAt ? <span> · 更新于 {formatDate(updatedAt)}</span> : null}
              {viewCount !== null ? <span> · 阅读 {viewCount}</span> : null}
            </p>
            <h1>{post.title}</h1>
            {post.excerpt ? <p class="sc-article-subtitle">{post.excerpt}</p> : null}
            {post.tags.length > 0 ? (
              <div class="sc-tag-list sc-article-tags">
                {post.tags.map((tag) => (
                  <a class="sc-tag-pill" href={`/tags/${tag.slug}`}>{tag.name}</a>
                ))}
              </div>
            ) : null}
            {showToc ? (
              <details class="sc-article-toc-mobile">
                <summary>本文目录</summary>
                <nav>
                  {tocHeadings.map((heading) => (
                    <a class={`sc-toc-link sc-toc-depth-${heading.depth}`} href={`#${heading.slug}`} data-toc-link={heading.slug} title={heading.text}>
                      {heading.text}
                    </a>
                  ))}
                </nav>
              </details>
            ) : null}
          </div>
        </header>
        <div class="sc-prose prose-content sc-article-prose sc-article-inner" set:html={renderedContent.html} />
        {siteSettings.commentEnabled && adminUser ? (
          <section class="sc-comments sc-article-inner">
            <h2>留言</h2>
            <p class="sc-comments-note">评论功能将在后续接入。</p>
          </section>
        ) : null}
        {previousPost || nextPost ? (
          <footer class="sc-article-nav sc-article-inner" aria-label="文章导航">
            {previousPost ? (
              <a class="sc-article-nav-card sc-article-nav-prev" href={`/posts/${previousPost.slug}`}>
                <span>上一页</span>
                <strong>{previousPost.title}</strong>
                {previousPost.publishedAt ? <time datetime={previousPost.publishedAt}>{formatDate(new Date(previousPost.publishedAt))}</time> : null}
              </a>
            ) : (
              <div class="sc-article-nav-card sc-article-nav-disabled">
                <span>上一页</span>
                <strong>已是第一页</strong>
              </div>
            )}

            {nextPost ? (
              <a class="sc-article-nav-card sc-article-nav-next" href={`/posts/${nextPost.slug}`}>
                <span>下一页</span>
                <strong>{nextPost.title}</strong>
                {nextPost.publishedAt ? <time datetime={nextPost.publishedAt}>{formatDate(new Date(nextPost.publishedAt))}</time> : null}
              </a>
            ) : (
              <div class="sc-article-nav-card sc-article-nav-disabled sc-article-nav-next">
                <span>下一页</span>
                <strong>已是最后一页</strong>
              </div>
            )}
          </footer>
        ) : null}
        {siteSettings.viewCountEnabled && publicPost ? (
          <script define:vars={{ postId: post.id }}>
            const storageKey = `sakura:viewed:${postId}`;
            const twelveHours = 12 * 60 * 60 * 1000;
            const trackerKey = `sakura:${postId}`;
            window.__sakuraViewTracker = window.__sakuraViewTracker || {};
            const tracker = window.__sakuraViewTracker;

            function recentlyCounted() {
              try {
                const lastViewedAt = Number(window.localStorage.getItem(storageKey) || '0');
                return Number.isFinite(lastViewedAt) && Date.now() - lastViewedAt < twelveHours;
              } catch {
                return true;
              }
            }

            function markCounted() {
              try {
                window.localStorage.setItem(storageKey, String(Date.now()));
              } catch {
                return;
              }
            }

            if (!tracker[trackerKey] && !recentlyCounted()) {
              tracker[trackerKey] = {
                submitted: false
              };

              window.setTimeout(() => {
                const currentTracker = tracker[trackerKey];

                if (!currentTracker || currentTracker.submitted) {
                  return;
                }

                if (recentlyCounted()) {
                  return;
                }

                currentTracker.submitted = true;
                markCounted();

                fetch(`/api/views/${encodeURIComponent(postId)}`, {
                  method: 'POST',
                  credentials: 'same-origin',
                  keepalive: true
                })
                  .catch(() => undefined);
              }, 8000);
            }
          </script>
        ) : null}
        {showToc ? (
          <script>
            const tocLinks = Array.from(document.querySelectorAll('[data-toc-link]'));
            const headings = tocLinks
              .map((link) => {
                const id = link instanceof HTMLElement ? link.dataset.tocLink : '';
                return id ? document.getElementById(id) : null;
              })
              .filter(Boolean);
            const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            if (!reduceMotion) {
              tocLinks.forEach((link) => {
                link.addEventListener('click', (event) => {
                  const target = event.currentTarget;

                  if (!(target instanceof HTMLAnchorElement)) {
                    return;
                  }

                  const id = decodeURIComponent(target.hash.slice(1));
                  const heading = document.getElementById(id);

                  if (!heading) {
                    return;
                  }

                  event.preventDefault();
                  heading.scrollIntoView({ behavior: 'smooth', block: 'start' });
                  history.pushState(null, '', target.hash);
                });
              });
            }

            if ('IntersectionObserver' in window && headings.length > 0) {
              const observer = new IntersectionObserver(
                (entries) => {
                  const visible = entries
                    .filter((entry) => entry.isIntersecting)
                    .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

                  if (!visible?.target?.id) {
                    return;
                  }

                  tocLinks.forEach((link) => {
                    link.classList.toggle('sc-toc-link-active', link instanceof HTMLElement && link.dataset.tocLink === visible.target.id);
                  });
                },
                {
                  rootMargin: '-18% 0px -68% 0px',
                  threshold: [0, 0.2, 0.6, 1]
                }
              );

              headings.forEach((heading) => observer.observe(heading));
            }
          </script>
        ) : null}
        <script>
          import { enhanceCodeBlocks } from '@/lib/prose-controls';

          enhanceCodeBlocks(document);
        </script>
      </div>
    </div>
  </article>
</SiteLayout>
