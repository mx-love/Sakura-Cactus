---
import SiteLayout from '@/components/layout/SiteLayout.astro';
import { PostDetailAdminActions } from '@/components/admin/PostDetailAdminActions';
import CommentSlot from '@/components/comments/CommentSlot.astro';
import ArticleImageViewer from '@/components/posts/ArticleImageViewer.astro';
import { getCurrentAdminUser } from '@/features/auth/auth.service';
import { getAdjacentPublicPosts, getAdminPostBySlug, getPublicPostBySlug } from '@/features/posts/post.service';
import { addHeadingIdsToHtml } from '@/features/posts/post.renderer';
import { getPostViewCount, getSiteSettings } from '@/features/settings/settings.service';
import { ROBOTS_INDEX_FOLLOW, ROBOTS_NOINDEX_NOFOLLOW, absoluteSiteUrl, summarizeHtml } from '@/lib/seo';
import { env } from 'cloudflare:workers';

export const prerender = false;

const slug = Astro.params.slug;

if (slug === 'about') {
  return Astro.redirect(`/about${Astro.url.search}`);
}

const adminUser = await getCurrentAdminUser(Astro);
const publicPost = slug ? await getPublicPostBySlug(slug) : null;
const post = slug ? (publicPost ?? (adminUser ? await getAdminPostBySlug(slug) : null)) : null;

if (!post) {
  return new Response('Not found', { status: 404 });
}

const siteSettings = await getSiteSettings();
const siteName = env.SITE_NAME?.trim() || 'Sakura Cactus';
const viewCount = siteSettings.viewCountEnabled ? await getPostViewCount(post.id) : null;
const title = post.seoTitle ?? post.title;
const description = post.seoDescription ?? post.excerpt ?? summarizeHtml(post.contentHtml, post.title);
const canonicalUrl = absoluteSiteUrl(`/posts/${post.slug}`);
const ogImage = post.coverImageUrl?.startsWith('/')
  ? absoluteSiteUrl(post.coverImageUrl)
  : post.coverImageUrl;
const robots = publicPost ? ROBOTS_INDEX_FOLLOW : ROBOTS_NOINDEX_NOFOLLOW;
const publishedAt = post.publishedAt ? new Date(post.publishedAt) : null;
const updatedAt = new Date(post.updatedAt);
const shouldShowUpdatedAt = publishedAt ? updatedAt.getTime() - publishedAt.getTime() > 60_000 : false;
const { previous: previousPost, next: nextPost } = publicPost
  ? await getAdjacentPublicPosts(publicPost)
  : { previous: null, next: null };
const renderedContent = addHeadingIdsToHtml(post.contentHtml);
const tocHeadings = renderedContent.headings.filter((heading) => heading.depth === 2);
const showToc = tocHeadings.length >= 2;
const commentsServerURL = env.PUBLIC_COMMENTS_SERVER_URL?.trim() || '';
const blogPostingJsonLd = publicPost && post.publishedAt
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: post.title,
      description,
      url: canonicalUrl,
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalUrl
      },
      datePublished: post.publishedAt,
      dateModified: post.updatedAt,
      author: {
        '@type': 'Person',
        name: siteName,
        url: absoluteSiteUrl('/about')
      },
      inLanguage: 'zh-CN',
      ...(ogImage ? { image: ogImage } : {})
    }
  : undefined;

const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

function formatDate(date: Date | null) {
  return date ? dateFormatter.format(date) : '';
}

---

<SiteLayout title={`${title} | ${siteName}`} description={description} canonicalUrl={canonicalUrl} robots={robots} ogImage={ogImage ?? undefined} jsonLd={blogPostingJsonLd}>
  <article class="sc-page">
    <div class="sc-reading-progress" aria-hidden="true">
      <span class="sc-reading-progress-bar" data-reading-progress></span>
    </div>
    <div class="sc-page-shell sc-article-shell">
      <a class="sc-article-back" href="/articles">← 返回文章</a>
      {showToc ? (
        <aside class="sc-article-toc" aria-label="文章目录">
          <p>纸页书签</p>
          <nav>
            {tocHeadings.map((heading) => (
              <a class={`sc-toc-link sc-toc-depth-${heading.depth}`} href={`#${heading.slug}`} data-toc-link={heading.slug} title={heading.text}>
                {heading.text}
              </a>
            ))}
          </nav>
        </aside>
      ) : null}
      {showToc ? (
        <>
          <button class="sc-mobile-toc-trigger" type="button" aria-label="打开文章目录" title="打开文章目录" aria-expanded="false" data-mobile-toc-trigger hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M8 6h12" />
              <path d="M8 12h12" />
              <path d="M8 18h12" />
              <path d="M4 6h.01" />
              <path d="M4 12h.01" />
              <path d="M4 18h.01" />
            </svg>
          </button>
          <div class="sc-mobile-toc-overlay" data-mobile-toc-overlay hidden>
            <button class="sc-mobile-toc-backdrop" type="button" aria-label="关闭文章目录" data-mobile-toc-close></button>
            <section class="sc-mobile-toc-sheet" role="dialog" aria-modal="true" aria-label="本文目录">
              <span class="sc-mobile-toc-handle" aria-hidden="true"></span>
              <header class="sc-mobile-toc-head">
                <h2>本文目录</h2>
                <button class="sc-mobile-toc-close" type="button" aria-label="关闭文章目录" data-mobile-toc-close>关闭</button>
              </header>
              <nav>
                {tocHeadings.map((heading) => (
                  <a class={`sc-toc-link sc-mobile-toc-link sc-toc-depth-${heading.depth}`} href={`#${heading.slug}`} data-toc-link={heading.slug} title={heading.text}>
                    {heading.text}
                  </a>
                ))}
              </nav>
            </section>
          </div>
        </>
      ) : null}
      <div class="sc-article-paper">
        <div class="sc-article-topbar sc-article-inner">
          <span></span>
          <PostDetailAdminActions client:load isAdmin={Boolean(adminUser)} postId={adminUser ? post.id : undefined} isPinned={Boolean(post.pinnedAt)} />
        </div>
        <header class="sc-article-header">
          <div class="sc-article-inner">
            <p class="sc-post-meta sc-article-meta">
              {publishedAt ? (
                <>
                  <span class="sc-calendar-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M8 2v4" />
                      <path d="M16 2v4" />
                      <path d="M3 10h18" />
                      <rect x="3" y="4" width="18" height="18" rx="2" />
                    </svg>
                  </span>
                  <time datetime={post.publishedAt ?? undefined}>{formatDate(publishedAt)}</time>
                </>
              ) : (
                <span>Published</span>
              )}
              {shouldShowUpdatedAt ? <span> · 更新于 {formatDate(updatedAt)}</span> : null}
              {viewCount !== null ? <span> · 阅读 {viewCount}</span> : null}
            </p>
            <h1>{post.title}</h1>
            {post.excerpt ? <p class="sc-article-subtitle">{post.excerpt}</p> : null}
            {post.tags.length > 0 ? (
              <div class="sc-tag-list sc-article-tags">
                {post.tags.map((tag) => (
                  <a class="sc-tag-pill" href={`/tags/${tag.slug}`}>{tag.name}</a>
                ))}
              </div>
            ) : null}
          </div>
        </header>
        <div
          class="sc-prose prose-content sc-article-prose sc-article-inner"
          data-article-image-viewer-root={publicPost ? true : undefined}
          set:html={renderedContent.html}
        />
        {publicPost ? <ArticleImageViewer /> : null}
        <CommentSlot enabled={siteSettings.commentEnabled} serverURL={commentsServerURL} path={`/posts/${post.slug}`} />
        {previousPost || nextPost ? (
          <footer class="sc-article-nav sc-article-inner" aria-label="文章导航">
            {previousPost ? (
              <a class="sc-article-nav-card sc-article-nav-prev" href={`/posts/${previousPost.slug}`}>
                <span>上一页</span>
                <strong>{previousPost.title}</strong>
                {previousPost.publishedAt ? <time datetime={previousPost.publishedAt}>{formatDate(new Date(previousPost.publishedAt))}</time> : null}
              </a>
            ) : (
              <div class="sc-article-nav-card sc-article-nav-disabled">
                <span>上一页</span>
                <strong>已是第一页</strong>
              </div>
            )}

            {nextPost ? (
              <a class="sc-article-nav-card sc-article-nav-next" href={`/posts/${nextPost.slug}`}>
                <span>下一页</span>
                <strong>{nextPost.title}</strong>
                {nextPost.publishedAt ? <time datetime={nextPost.publishedAt}>{formatDate(new Date(nextPost.publishedAt))}</time> : null}
              </a>
            ) : (
              <div class="sc-article-nav-card sc-article-nav-disabled sc-article-nav-next">
                <span>下一页</span>
                <strong>已是最后一页</strong>
              </div>
            )}
          </footer>
        ) : null}
        {siteSettings.viewCountEnabled && publicPost ? (
          <script define:vars={{ postId: post.id }} is:inline>
            const storageKey = `sakura:viewed:${postId}`;
            const twelveHours = 12 * 60 * 60 * 1000;
            const trackerKey = `sakura:${postId}`;
            window.__sakuraViewTracker = window.__sakuraViewTracker || {};
            const tracker = window.__sakuraViewTracker;

            function recentlyCounted() {
              try {
                const lastViewedAt = Number(window.localStorage.getItem(storageKey) || '0');
                return Number.isFinite(lastViewedAt) && Date.now() - lastViewedAt < twelveHours;
              } catch {
                return true;
              }
            }

            function markCounted() {
              try {
                window.localStorage.setItem(storageKey, String(Date.now()));
              } catch {
                return;
              }
            }

            if (!tracker[trackerKey] && !recentlyCounted()) {
              tracker[trackerKey] = {
                submitted: false
              };

              window.setTimeout(() => {
                const currentTracker = tracker[trackerKey];

                if (!currentTracker || currentTracker.submitted) {
                  return;
                }

                if (recentlyCounted()) {
                  return;
                }

                currentTracker.submitted = true;
                markCounted();

                fetch(`/api/views/${encodeURIComponent(postId)}`, {
                  method: 'POST',
                  credentials: 'same-origin',
                  keepalive: true
                })
                  .catch(() => undefined);
              }, 8000);
            }
          </script>
        ) : null}
        <script>
          // @ts-nocheck -- legacy inline DOM script; tracked for extraction in SECURITY_AUDIT_REPORT.md.
          (() => {
            const bar = document.querySelector('[data-reading-progress]');

            if (!(bar instanceof HTMLElement)) {
              return;
            }

            const root = document.documentElement;
            let frame = 0;

            function syncProgressTop() {
              const header = document.querySelector('.sc-site-header');
              const headerHeight = header instanceof HTMLElement ? header.getBoundingClientRect().height : 0;
              root.style.setProperty('--sc-reading-progress-top', `${Math.round(headerHeight)}px`);
            }

            function updateProgress() {
              frame = 0;

              const maxScroll = root.scrollHeight - window.innerHeight;
              const progress = maxScroll <= 0 ? 1 : Math.min(1, Math.max(0, window.scrollY / maxScroll));
              bar.style.transform = `scaleX(${progress})`;
            }

            function scheduleProgressUpdate() {
              if (frame) {
                return;
              }

              frame = window.requestAnimationFrame(updateProgress);
            }

            function syncLayout() {
              syncProgressTop();
              scheduleProgressUpdate();
            }

            window.addEventListener('scroll', scheduleProgressUpdate, { passive: true });
            window.addEventListener('resize', syncLayout);
            window.addEventListener('pageshow', syncLayout);
            syncLayout();
          })();
        </script>
        {showToc ? (
          <script>
            // @ts-nocheck -- legacy inline DOM script; tracked for extraction in SECURITY_AUDIT_REPORT.md.
            const tocLinks = Array.from(document.querySelectorAll('[data-toc-link]'));
            const headingsById = new Map();

            tocLinks.forEach((link) => {
              const id = link instanceof HTMLElement ? link.dataset.tocLink : '';
              const heading = id ? document.getElementById(id) : null;

              if (id && heading) {
                headingsById.set(id, heading);
              }
            });

            const headings = Array.from(headingsById.values());
            const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            const mobileTocTrigger = document.querySelector('[data-mobile-toc-trigger]');
            const mobileTocOverlay = document.querySelector('[data-mobile-toc-overlay]');
            const mobileTocCloseControls = Array.from(document.querySelectorAll('[data-mobile-toc-close]'));
            let activeHeadingId = '';
            let tocFrame = 0;

            function getTocOffset() {
              const header = document.querySelector('.sc-site-header');
              const headerHeight = header instanceof HTMLElement ? header.getBoundingClientRect().height : 0;
              return Math.max(96, headerHeight + 28);
            }

            function scrollActiveTocLinksIntoView() {
              document.querySelectorAll('.sc-toc-link-active').forEach((link) => {
                const container = link.closest('.sc-article-toc nav, .sc-mobile-toc-sheet');

                if (!(container instanceof HTMLElement) || !(link instanceof HTMLElement)) {
                  return;
                }

                const containerRect = container.getBoundingClientRect();
                const linkRect = link.getBoundingClientRect();

                if (linkRect.top < containerRect.top || linkRect.bottom > containerRect.bottom) {
                  link.scrollIntoView({ block: 'nearest' });
                }
              });
            }

            function setActiveToc(id) {
              activeHeadingId = id || '';

              tocLinks.forEach((link) => {
                if (!(link instanceof HTMLElement)) {
                  return;
                }

                const isActive = Boolean(activeHeadingId) && link.dataset.tocLink === activeHeadingId;
                link.classList.toggle('sc-toc-link-active', isActive);

                if (isActive) {
                  link.setAttribute('aria-current', 'location');
                } else {
                  link.removeAttribute('aria-current');
                }
              });

              scrollActiveTocLinksIntoView();
            }

            function updateActiveHeading() {
              if (headings.length === 0) {
                return;
              }

              const offset = getTocOffset();
              const documentElement = document.documentElement;
              const nearBottom = window.innerHeight + window.scrollY >= documentElement.scrollHeight - 8;
              let current = headings[0];

              if (nearBottom) {
                setActiveToc(headings[headings.length - 1].id);
                return;
              }

              for (const heading of headings) {
                if (heading.getBoundingClientRect().top <= offset) {
                  current = heading;
                } else {
                  break;
                }
              }

              setActiveToc(current.id);
            }

            function scheduleActiveUpdate() {
              if (tocFrame) {
                return;
              }

              tocFrame = window.requestAnimationFrame(() => {
                tocFrame = 0;
                syncMobileTocTrigger();
                updateActiveHeading();
              });
            }

            function closeMobileToc() {
              if (!(mobileTocOverlay instanceof HTMLElement)) {
                return;
              }

              mobileTocOverlay.hidden = true;

              if (mobileTocTrigger instanceof HTMLButtonElement) {
                mobileTocTrigger.setAttribute('aria-expanded', 'false');
              }
            }

            function openMobileToc() {
              if (!(mobileTocOverlay instanceof HTMLElement)) {
                return;
              }

              mobileTocOverlay.hidden = false;

              if (mobileTocTrigger instanceof HTMLButtonElement) {
                mobileTocTrigger.setAttribute('aria-expanded', 'true');
              }

              updateActiveHeading();
            }

            function syncMobileTocTrigger() {
              if (!(mobileTocTrigger instanceof HTMLButtonElement)) {
                return;
              }

              mobileTocTrigger.hidden = false;
              mobileTocTrigger.classList.toggle('sc-mobile-toc-trigger-visible', window.scrollY > 240);
            }

            tocLinks.forEach((link) => {
              link.addEventListener('click', (event) => {
                const target = event.currentTarget;

                if (!(target instanceof HTMLAnchorElement)) {
                  return;
                }

                const id = decodeURIComponent(target.hash.slice(1));
                const heading = document.getElementById(id);

                if (!heading) {
                  return;
                }

                event.preventDefault();
                heading.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
                history.pushState(null, '', target.hash);
                setActiveToc(id);
                closeMobileToc();
              });
            });

            if (mobileTocTrigger instanceof HTMLButtonElement) {
              mobileTocTrigger.addEventListener('click', () => {
                if (mobileTocOverlay instanceof HTMLElement && !mobileTocOverlay.hidden) {
                  closeMobileToc();
                  return;
                }

                openMobileToc();
              });
            }

            mobileTocCloseControls.forEach((control) => {
              control.addEventListener('click', closeMobileToc);
            });

            document.addEventListener('keydown', (event) => {
              if (event.key === 'Escape') {
                closeMobileToc();
              }
            });

            window.addEventListener('scroll', scheduleActiveUpdate, { passive: true });
            window.addEventListener('resize', scheduleActiveUpdate);
            window.addEventListener('hashchange', () => {
              const id = decodeURIComponent(window.location.hash.slice(1));

              if (id && headingsById.has(id)) {
                setActiveToc(id);
                return;
              }

              scheduleActiveUpdate();
            });

            syncMobileTocTrigger();
            if (window.location.hash) {
              const id = decodeURIComponent(window.location.hash.slice(1));

              if (id && headingsById.has(id)) {
                setActiveToc(id);
              } else {
                updateActiveHeading();
              }
            } else {
              updateActiveHeading();
            }
          </script>
        ) : null}
        <script>
          // @ts-nocheck -- legacy inline DOM script; tracked for extraction in SECURITY_AUDIT_REPORT.md.
          import { bindCodeCopyControls } from '@/lib/prose-controls';

          function bindArticleCodeCopyControls() {
            bindCodeCopyControls(document.querySelector('.sc-article-prose, .prose-content') ?? document);
          }

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', bindArticleCodeCopyControls, { once: true });
          } else {
            bindArticleCodeCopyControls();
          }

          window.addEventListener('pageshow', bindArticleCodeCopyControls);
        </script>
      </div>
    </div>
  </article>
</SiteLayout>
