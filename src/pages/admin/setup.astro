---
import SiteLayout from '@/components/layout/SiteLayout.astro';
import { SetupForm } from '@/components/admin/SetupForm';
import { getDb } from '@/lib/db';
import { countUsers } from '@/features/auth/user.repo';

const userCount = await countUsers(getDb(Astro));

if (userCount > 0) {
  return Astro.redirect('/admin/login');
}
---

<SiteLayout title="Admin Setup | Sakura Cactus">
  <section class="flex min-h-screen items-center justify-center bg-[var(--color-bg)] px-6 py-12 text-[var(--color-text)]">
    <div class="w-full max-w-sm rounded-lg border border-[var(--color-border)] bg-white/80 p-6 shadow-sm">
      <div class="mb-6 space-y-2">
        <h1 class="text-2xl font-semibold">Admin Setup</h1>
        <p class="text-sm leading-6 text-[var(--color-muted)]">Create the first Sakura Cactus administrator.</p>
      </div>
      <SetupForm client:load />
    </div>
  </section>
</SiteLayout>
