---
import SiteLayout from '@/components/layout/SiteLayout.astro';
import { MediaAssetActions } from '@/components/admin/MediaAssetActions';
import { MediaUploader } from '@/components/admin/MediaUploader';
import { getCurrentAdminUser } from '@/features/auth/auth.service';
import { getAdminAssets } from '@/features/assets/asset.service';

const user = await getCurrentAdminUser(Astro);

if (!user) {
  return Astro.redirect('/admin/login');
}

const assets = await getAdminAssets();

function formatSize(bytes: number): string {
  if (bytes < 1024) {
    return `${bytes} B`;
  }

  if (bytes < 1024 * 1024) {
    return `${(bytes / 1024).toFixed(1)} KB`;
  }

  return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
}
---

<SiteLayout title="Media | Sakura Cactus">
  <section class="min-h-screen bg-[var(--color-bg)] px-6 py-10 text-[var(--color-text)]">
    <div class="mx-auto max-w-6xl space-y-6">
      <div class="flex flex-col gap-4 rounded-lg border border-[var(--color-border)] bg-white/80 p-6 shadow-sm sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-sm text-[var(--color-muted)]">Admin</p>
          <h1 class="mt-1 text-2xl font-semibold">Media</h1>
        </div>
        <div class="flex flex-wrap gap-3">
          <a class="rounded-lg border border-[var(--color-border)] bg-white px-4 py-2 text-sm font-semibold" href="/admin">
            Dashboard
          </a>
          <a class="rounded-lg border border-[var(--color-border)] bg-white px-4 py-2 text-sm font-semibold" href="/admin/posts">
            Posts
          </a>
        </div>
      </div>

      <div class="rounded-lg border border-[var(--color-border)] bg-white/80 p-6 shadow-sm">
        <MediaUploader client:load />
      </div>

      {
        assets.length === 0 ? (
          <div class="rounded-lg border border-[var(--color-border)] bg-white/80 p-6 text-sm text-[var(--color-muted)] shadow-sm">
            No images uploaded yet.
          </div>
        ) : (
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {assets.map((asset) => (
              <article class="overflow-hidden rounded-lg border border-[var(--color-border)] bg-white/80 shadow-sm">
                <div class="aspect-[4/3] bg-white">
                  <img
                    alt={asset.original_filename ?? asset.id}
                    class="h-full w-full object-cover"
                    loading="lazy"
                    src={`/i/${asset.token}`}
                  />
                </div>
                <div class="space-y-3 p-4">
                  <div>
                    <h2 class="truncate text-sm font-semibold">{asset.original_filename ?? asset.id}</h2>
                    <p class="mt-1 text-xs text-[var(--color-muted)]">
                      {asset.mime_type} · {formatSize(asset.size_bytes)}
                    </p>
                  </div>
                  <div class="flex flex-wrap gap-2 text-xs text-[var(--color-muted)]">
                    <span class="rounded-full border border-[var(--color-border)] bg-white px-2 py-1">
                      {asset.visibility}
                    </span>
                    <span class="rounded-full border border-[var(--color-border)] bg-white px-2 py-1">
                      /i/{asset.token}
                    </span>
                  </div>
                  <MediaAssetActions client:load assetId={asset.id} token={asset.token} visibility={asset.visibility} />
                </div>
              </article>
            ))}
          </div>
        )
      }
    </div>
  </section>
</SiteLayout>
