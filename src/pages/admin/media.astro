---
import AdminLayout from '@/components/layout/AdminLayout.astro';
import { MediaAssetActions } from '@/components/admin/MediaAssetActions';
import { MediaUploader } from '@/components/admin/MediaUploader';
import { getAdminAssets } from '@/features/assets/asset.service';

const assets = await getAdminAssets();

function formatSize(bytes: number): string {
  if (bytes < 1024) {
    return `${bytes} B`;
  }

  if (bytes < 1024 * 1024) {
    return `${(bytes / 1024).toFixed(1)} KB`;
  }

  return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
}

function formatUsage(count: number): string {
  if (count === 0) {
    return 'Unused';
  }

  if (count === 1) {
    return 'Used by 1 post';
  }

  return `Used by ${count} posts`;
}
---

<AdminLayout title="Media | Sakura Cactus" heading="Media">
  <div class="space-y-6">
      <div class="rounded-[24px] border border-[var(--color-border)] bg-white/82 p-5 shadow-[var(--shadow-soft)]">
        <MediaUploader client:load />
      </div>

      {
        assets.length === 0 ? (
          <div class="rounded-[24px] border border-[var(--color-border)] bg-white/82 p-8 text-center shadow-[var(--shadow-soft)]">
            <p class="font-semibold">No images uploaded yet</p>
            <p class="mt-2 text-sm text-[var(--color-muted)]">Upload images here, or paste them directly into the post editor.</p>
          </div>
        ) : (
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {assets.map((asset) => (
              <article class="overflow-hidden rounded-[24px] border border-[var(--color-border)] bg-white/82 shadow-[var(--shadow-soft)]">
                <div class="aspect-[4/3] bg-white">
                  <img
                    alt={asset.original_filename ?? asset.id}
                    class="h-full w-full object-cover"
                    loading="lazy"
                    src={`/i/${asset.token}`}
                  />
                </div>
                <div class="space-y-3 p-4">
                  <div>
                    <h2 class="truncate text-sm font-semibold">{asset.original_filename ?? asset.id}</h2>
                    <p class="mt-1 text-xs text-[var(--color-muted)]">
                      {asset.mime_type} · {formatSize(asset.size_bytes)}
                    </p>
                  </div>
                  <div class="flex flex-wrap gap-2 text-xs text-[var(--color-muted)]">
                    <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-bg)] px-2 py-1 font-semibold text-[var(--color-text)]">
                      {asset.visibility}
                    </span>
                    <span class="rounded-full border border-[var(--color-border)] bg-white px-2 py-1">
                      {formatUsage(asset.usage_count)}
                    </span>
                    <span class="rounded-full border border-[var(--color-border)] bg-white px-2 py-1">
                      /i/{asset.token}
                    </span>
                  </div>
                  <MediaAssetActions client:load assetId={asset.id} token={asset.token} visibility={asset.visibility} />
                </div>
              </article>
            ))}
          </div>
        )
      }
  </div>
</AdminLayout>
