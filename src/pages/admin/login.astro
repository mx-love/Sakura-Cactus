---
import SiteLayout from '@/components/layout/SiteLayout.astro';
import { LoginForm } from '@/components/admin/LoginForm';

const next = Astro.url.searchParams.get('next') ?? '/write';
---

<SiteLayout title="登录 | Sakura Cactus" showHeader={false}>
  <section class="sc-page flex min-h-screen items-center px-4 py-12 text-[var(--color-text)]">
    <div class="mx-auto w-full max-w-sm">
      <a class="mb-10 block text-center text-lg font-extrabold tracking-tight" href="/">Sakura Cactus</a>
      <div class="rounded-lg border border-[var(--color-border)] bg-white px-5 py-6">
        <div class="mb-6 text-center">
          <h1 class="text-2xl font-extrabold">登录</h1>
          <p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">温柔地写，安静地收录。</p>
        </div>
        <LoginForm client:load next={next} />
      </div>
      <p class="mt-5 text-center text-xs leading-5 text-[var(--color-muted)]">
        使用 HttpOnly Secure Cookie 保存登录会话。
      </p>
    </div>
  </section>
</SiteLayout>
