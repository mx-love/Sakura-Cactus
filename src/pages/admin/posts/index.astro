---
import SiteLayout from '@/components/layout/SiteLayout.astro';
import { PostRowActions } from '@/components/admin/PostRowActions';
import { getCurrentAdminUser } from '@/features/auth/auth.service';
import { getAdminPosts } from '@/features/posts/post.service';

const user = await getCurrentAdminUser(Astro);

if (!user) {
  return Astro.redirect('/admin/login');
}

const posts = await getAdminPosts();
---

<SiteLayout title="Posts | Sakura Cactus">
  <section class="min-h-screen bg-[var(--color-bg)] px-6 py-10 text-[var(--color-text)]">
    <div class="mx-auto max-w-6xl space-y-6">
      <div class="flex flex-col gap-4 rounded-lg border border-[var(--color-border)] bg-white/80 p-6 shadow-sm sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-sm text-[var(--color-muted)]">Admin</p>
          <h1 class="mt-1 text-2xl font-semibold">Posts</h1>
        </div>
        <div class="flex flex-wrap gap-3">
          <a class="rounded-lg border border-[var(--color-border)] bg-white px-4 py-2 text-sm font-semibold" href="/admin">
            Dashboard
          </a>
          <a class="rounded-lg bg-[var(--color-text)] px-4 py-2 text-sm font-semibold text-white" href="/admin/posts/new">
            New post
          </a>
        </div>
      </div>

      <div class="overflow-hidden rounded-lg border border-[var(--color-border)] bg-white/80 shadow-sm">
        {
          posts.length === 0 ? (
            <div class="p-6 text-sm text-[var(--color-muted)]">No posts yet.</div>
          ) : (
            <div class="overflow-x-auto">
              <table class="w-full min-w-[760px] text-left text-sm">
                <thead class="border-b border-[var(--color-border)] text-xs uppercase text-[var(--color-muted)]">
                  <tr>
                    <th class="px-4 py-3">Title</th>
                    <th class="px-4 py-3">Slug</th>
                    <th class="px-4 py-3">Status</th>
                    <th class="px-4 py-3">Visibility</th>
                    <th class="px-4 py-3">Updated</th>
                    <th class="px-4 py-3">Published</th>
                    <th class="px-4 py-3">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {posts.map((post) => (
                    <tr class="border-b border-[var(--color-border)] last:border-0">
                      <td class="px-4 py-3 font-medium">{post.title}</td>
                      <td class="px-4 py-3 text-[var(--color-muted)]">{post.slug}</td>
                      <td class="px-4 py-3">{post.status}</td>
                      <td class="px-4 py-3">{post.visibility}</td>
                      <td class="px-4 py-3 text-[var(--color-muted)]">{new Date(post.updated_at).toLocaleString()}</td>
                      <td class="px-4 py-3 text-[var(--color-muted)]">
                        {post.published_at ? new Date(post.published_at).toLocaleString() : '-'}
                      </td>
                      <td class="px-4 py-3">
                        <PostRowActions client:load postId={post.id} status={post.status} />
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )
        }
      </div>
    </div>
  </section>
</SiteLayout>
