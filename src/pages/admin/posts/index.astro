---
import AdminLayout from '@/components/layout/AdminLayout.astro';
import { getAdminPosts } from '@/features/posts/post.service';
import type { PostRow } from '@/features/posts/post.types';

const posts = await getAdminPosts();
const now = Date.now();
const currentFilter = normalizeFilter(Astro.url.searchParams.get('filter'));

type ManageFilter = 'all' | 'published' | 'draft' | 'private' | 'scheduled';

const filterOptions: Array<{ key: ManageFilter; label: string }> = [
  { key: 'all', label: '全部' },
  { key: 'published', label: '已发布' },
  { key: 'draft', label: '草稿' },
  { key: 'private', label: '私密' },
  { key: 'scheduled', label: '定时' }
];

function normalizeFilter(value: string | null): ManageFilter {
  return value === 'published' || value === 'draft' || value === 'private' || value === 'scheduled' ? value : 'all';
}

function timestamp(value: string | null): number | null {
  if (!value) {
    return null;
  }

  const time = new Date(value).getTime();
  return Number.isNaN(time) ? null : time;
}

function isScheduledPost(post: PostRow): boolean {
  const publishedAt = timestamp(post.published_at);
  return post.status === 'published' && publishedAt !== null && publishedAt > now;
}

function isLivePublicPost(post: PostRow): boolean {
  const publishedAt = timestamp(post.published_at);
  return post.status === 'published' && post.visibility === 'public' && publishedAt !== null && publishedAt <= now;
}

function matchesFilter(post: PostRow, filter: ManageFilter): boolean {
  if (filter === 'published') {
    return isLivePublicPost(post);
  }

  if (filter === 'draft') {
    return post.status === 'draft';
  }

  if (filter === 'private') {
    return post.visibility === 'private';
  }

  if (filter === 'scheduled') {
    return isScheduledPost(post);
  }

  return true;
}

const filteredPosts = posts.filter((post) => matchesFilter(post, currentFilter));

const counts: Record<ManageFilter, number> = {
  all: posts.length,
  published: posts.filter(isLivePublicPost).length,
  draft: posts.filter((post) => post.status === 'draft').length,
  private: posts.filter((post) => post.visibility === 'private').length,
  scheduled: posts.filter(isScheduledPost).length
};

const dateTimeFormatter = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
  hour: '2-digit',
  minute: '2-digit',
  hour12: false
});

function formatDateTime(value: string | null): string {
  const time = timestamp(value);
  return time === null ? '-' : dateTimeFormatter.format(new Date(time));
}

function postTitle(post: PostRow): string {
  const title = post.title.trim();
  return title.length > 0 ? title : '未命名草稿';
}

function postState(post: PostRow): { label: string; className: string } {
  if (post.status === 'draft') {
    return { label: '草稿', className: 'sc-badge-draft' };
  }

  if (post.status === 'archived') {
    return { label: '已下架', className: 'sc-badge-archived' };
  }

  if (isScheduledPost(post)) {
    return { label: '定时', className: 'sc-badge-scheduled' };
  }

  if (post.visibility === 'private') {
    return { label: '私密', className: 'sc-badge-private' };
  }

  if (post.status === 'published') {
    return { label: '已发布', className: 'sc-badge-published' };
  }

  return { label: post.status, className: 'sc-badge' };
}

function postEditHref(post: PostRow): string {
  return post.slug === 'about' ? '/write?type=about' : `/write?post=${post.id}`;
}

function postPublicHref(post: PostRow): string {
  return post.slug === 'about' ? '/about' : `/posts/${post.slug}`;
}

function filterHref(filter: ManageFilter): string {
  return filter === 'all' ? '/admin/posts' : `/admin/posts?filter=${filter}`;
}
---

<AdminLayout title="文章管理 | Sakura Cactus" heading="文章管理" eyebrow="Writing desk">
  <div class="space-y-6">
    <div class="sc-card-polished flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6">
      <div>
        <p class="text-sm font-bold text-[var(--color-muted)]">内容管理</p>
        <h2 class="mt-1 text-2xl font-black">所有文章</h2>
        <p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">找回草稿，继续编辑，确认已发布、私密和定时文章。</p>
      </div>
      <a class="sc-button sc-button-primary" href="/admin/posts/new">新建文章</a>
    </div>

    <nav class="sc-admin-post-filters" aria-label="文章状态筛选">
      {filterOptions.map((item) => (
        <a class:list={['sc-admin-filter-link', currentFilter === item.key && 'sc-admin-filter-link-active']} href={filterHref(item.key)}>
          <span>{item.label}</span>
          <span>{counts[item.key]}</span>
        </a>
      ))}
    </nav>

    {
      posts.length === 0 ? (
        <div class="sc-card-polished p-10 text-center">
          <p class="mt-5 text-xl font-black">还没有文章</p>
          <p class="mx-auto mt-2 max-w-md text-sm leading-7 text-[var(--color-muted)]">先保存一篇草稿，它会出现在这里。</p>
          <a class="sc-button sc-button-primary mt-6" href="/admin/posts/new">开始写作</a>
        </div>
      ) : filteredPosts.length === 0 ? (
        <div class="sc-card-polished p-10 text-center">
          <p class="mt-5 text-xl font-black">当前筛选下没有文章</p>
          <p class="mx-auto mt-2 max-w-md text-sm leading-7 text-[var(--color-muted)]">切换状态筛选，或新建一篇草稿。</p>
          <a class="sc-button sc-button-secondary mt-6" href="/admin/posts">查看全部</a>
        </div>
      ) : (
        <>
          <div class="sc-card hidden overflow-hidden lg:block">
            <div class="overflow-x-auto">
              <table class="sc-admin-table w-full min-w-[820px] text-left text-sm">
                <thead>
                  <tr>
                    <th>标题</th>
                    <th>状态</th>
                    <th>Slug</th>
                    <th>更新时间</th>
                    <th>发布 / 定时</th>
                    <th>操作</th>
                  </tr>
                </thead>
                <tbody>
                  {filteredPosts.map((post) => {
                    const state = postState(post);
                    const canViewPublic = isLivePublicPost(post);

                    return (
                    <tr>
                      <td>
                        <a class="sc-admin-post-title" href={postEditHref(post)}>{postTitle(post)}</a>
                      </td>
                      <td>
                        <span class={`sc-badge ${state.className}`}>{state.label}</span>
                      </td>
                      <td><code class="sc-admin-slug">{post.slug || '未生成'}</code></td>
                      <td class="text-[var(--color-muted)]">{formatDateTime(post.updated_at)}</td>
                      <td class="text-[var(--color-muted)]">{formatDateTime(post.published_at)}</td>
                      <td>
                        <div class="sc-admin-row-actions">
                          <a class="sc-button sc-button-secondary sc-button-small" href={postEditHref(post)}>编辑</a>
                          {canViewPublic ? (
                            <a class="sc-button sc-button-secondary sc-button-small" href={postPublicHref(post)}>查看</a>
                          ) : (
                            <span class="sc-admin-action-muted">未公开</span>
                          )}
                        </div>
                      </td>
                    </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>

          <div class="grid gap-4 lg:hidden">
            {filteredPosts.map((post) => {
              const state = postState(post);
              const canViewPublic = isLivePublicPost(post);

              return (
              <article class="sc-card p-5">
                <div class="flex flex-wrap gap-2">
                  <span class={`sc-badge ${state.className}`}>{state.label}</span>
                  <span class={`sc-badge sc-badge-${post.visibility}`}>{post.visibility === 'private' ? '仅自己' : '公开'}</span>
                </div>
                <h3 class="mt-3 text-xl font-black">
                  <a href={postEditHref(post)}>{postTitle(post)}</a>
                </h3>
                <p class="mt-2 text-xs text-[var(--color-muted)]">Slug: <code class="sc-admin-slug">{post.slug || '未生成'}</code></p>
                <p class="mt-4 text-xs text-[var(--color-muted)]">更新于 {formatDateTime(post.updated_at)}</p>
                <div class="sc-admin-row-actions mt-4">
                  <a class="sc-button sc-button-secondary sc-button-small" href={postEditHref(post)}>编辑</a>
                  {canViewPublic ? (
                    <a class="sc-button sc-button-secondary sc-button-small" href={postPublicHref(post)}>查看</a>
                  ) : (
                    <span class="sc-admin-action-muted">未公开</span>
                  )}
                </div>
              </article>
              );
            })}
          </div>
        </>
      )
    }
  </div>
</AdminLayout>
