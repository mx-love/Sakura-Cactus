---
import AdminLayout from '@/components/layout/AdminLayout.astro';
import { PostEditor } from '@/components/admin/PostEditor';
import { getAdminPost } from '@/features/posts/post.service';

const id = Astro.params.id;
const post = id ? await getAdminPost(id) : null;

if (!post) {
  return new Response('Not found', { status: 404 });
}
---

<AdminLayout title={`Edit ${post.title} | Sakura Cactus`} heading="Edit post" eyebrow="Posts" wide>
  <PostEditor client:load post={post} />
</AdminLayout>
