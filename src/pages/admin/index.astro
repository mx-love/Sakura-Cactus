---
import AdminLayout from '@/components/layout/AdminLayout.astro';
---

<AdminLayout title="Admin | Sakura Cactus" heading="Dashboard">
  <div class="grid gap-4 md:grid-cols-3">
    <a class="rounded-[24px] border border-[var(--color-border)] bg-white/80 p-5 shadow-[var(--shadow-soft)] transition hover:-translate-y-0.5" href="/admin/posts">
      <p class="text-sm text-[var(--color-muted)]">Write</p>
      <h2 class="mt-2 text-xl font-semibold">Posts</h2>
      <p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">Create drafts, publish articles, and manage the archive.</p>
    </a>
    <a class="rounded-[24px] border border-[var(--color-border)] bg-white/80 p-5 shadow-[var(--shadow-soft)] transition hover:-translate-y-0.5" href="/admin/media">
      <p class="text-sm text-[var(--color-muted)]">Images</p>
      <h2 class="mt-2 text-xl font-semibold">Media</h2>
      <p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">Upload private R2 images and copy safe token URLs.</p>
    </a>
    <a class="rounded-[24px] border border-[var(--color-border)] bg-white/80 p-5 shadow-[var(--shadow-soft)] transition hover:-translate-y-0.5" href="/admin/settings">
      <p class="text-sm text-[var(--color-muted)]">Later</p>
      <h2 class="mt-2 text-xl font-semibold">Settings</h2>
      <p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">Site settings placeholder for a future configuration stage.</p>
    </a>
  </div>
</AdminLayout>
