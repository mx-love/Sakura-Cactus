---
import SiteLayout from '@/components/layout/SiteLayout.astro';
---

<SiteLayout title="标签 | Sakura Cactus">
  <section class="sc-page">
    <div class="sc-shell">
      <header class="py-10">
        <h1 class="text-4xl font-extrabold tracking-tight">标签</h1>
        <p class="mt-4 leading-8 text-[var(--color-muted)]">标签系统会在后续阶段接入。这里先保留 AstroPaper 风格入口。</p>
      </header>

      <div class="flex flex-wrap gap-2">
        <span class="sc-badge">writing</span>
        <span class="sc-badge">notes</span>
        <span class="sc-badge">life</span>
      </div>
    </div>
  </section>
</SiteLayout>
