---
import SiteLayout from '@/components/layout/SiteLayout.astro';
import { getPublicTags } from '@/features/tags/tag.service';

export const prerender = false;

function isAboutTag(tag: { name: string; slug: string }) {
  return tag.slug === 'about' || tag.name.toLowerCase() === 'about';
}

const tags = (await getPublicTags())
  .filter((tag) => !isAboutTag(tag) && tag.post_count > 0)
  .map((tag) => ({ name: tag.name, slug: tag.slug, postCount: tag.post_count }))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<SiteLayout title="标签 | Sakura Cactus" description="按主题浏览公开文章。">
  <section class="sc-page">
    <div class="sc-public-shell sc-paper-public-shell">
      <nav class="sc-breadcrumb" aria-label="面包屑">
        <a href="/">首页</a>
        <span>»</span>
        <span>标签</span>
      </nav>

      <header class="sc-page-header">
        <h1>标签</h1>
        <p>按主题浏览公开文章。</p>
      </header>

      {tags.length === 0 ? (
        <div class="sc-empty">
          <p>暂无公开标签。</p>
        </div>
      ) : (
        <div class="sc-tags-index sc-tags-compact sc-sticker-tags">
          {tags.map((tag) => (
            <a class="sc-tag-topic" href={`/tags/${tag.slug}`}>
              <span>{tag.name}</span>
              <span>{tag.postCount} 篇</span>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</SiteLayout>
