---
import SiteLayout from '@/components/layout/SiteLayout.astro';
import PageHero from '@/components/editorial/PageHero.astro';
import { getPublicTags } from '@/features/tags/tag.service';
import { ROBOTS_NOINDEX_FOLLOW, absoluteSiteUrl } from '@/lib/seo';

export const prerender = false;

// Most-used subjects first; ties fall back to a stable, locale-aware name order.
const tags = (await getPublicTags())
  .filter((tag) => tag.post_count > 0)
  .map((tag) => ({ name: tag.name, slug: tag.slug, postCount: tag.post_count }))
  .sort((a, b) => b.postCount - a.postCount || a.name.localeCompare(b.name, 'zh-CN'));
const leadTags = tags.slice(0, 6);
const canonicalUrl = absoluteSiteUrl('/tags');
---

<SiteLayout title="标签 | Sakura Cactus" description="按主题浏览公开文章。" canonicalUrl={canonicalUrl} robots={ROBOTS_NOINDEX_FOLLOW}>
  <section class="sc-page">
    <div class="sc-page-shell">
      <PageHero label="The Index" title="标签" subtitle="按主题浏览公开文章。" count={tags.length} countLabel="个标签" />

      {tags.length === 0 ? (
        <div class="sc-empty">
          <p>暂无公开标签。</p>
        </div>
      ) : (
        <>
          {tags.length > 12 ? (
            <section class="sc-tag-lead" aria-labelledby="tag-lead-heading">
              <h2 class="sc-label" id="tag-lead-heading">Most Written · 常写的主题</h2>
              <ol class="sc-tag-lead-list">
                {leadTags.map((tag) => (
                  <li>
                    <a class="sc-tag-lead-link" href={`/tags/${tag.slug}`}>
                      <span class="sc-draw-text">{tag.name}</span>
                      <span class="sc-tag-lead-count">{tag.postCount} 篇</span>
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          ) : null}
          <section aria-label="全部标签">
            {tags.length > 12 ? <h2 class="sc-label sc-tag-index-heading">All Subjects · 全部标签</h2> : null}
            <ul class="sc-tag-index">
              {tags.map((tag) => (
                <li>
                  <a class="sc-tag-index-link" href={`/tags/${tag.slug}`}>
                    <span class="sc-tag-index-name">{tag.name}</span>
                    <span class="sc-tag-index-leader" aria-hidden="true"></span>
                    <span class="sc-tag-index-count">{tag.postCount}<span class="sr-only"> 篇</span></span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        </>
      )}
    </div>
  </section>
</SiteLayout>
