---
import SiteLayout from '@/components/layout/SiteLayout.astro';
import { getPublicTags } from '@/features/tags/tag.service';

export const prerender = false;

const tags = await getPublicTags();
---

<SiteLayout title="标签 | Sakura Cactus" description="按主题整理公开文章。">
  <section class="sc-page">
    <div class="sc-public-shell">
      <nav class="sc-breadcrumb" aria-label="面包屑">
        <a href="/">首页</a>
        <span>»</span>
        <span>标签</span>
      </nav>

      <header class="sc-page-header">
        <h1>标签</h1>
        <p>按主题整理公开文章。</p>
      </header>

      {tags.length === 0 ? (
        <div class="sc-empty">
          <p>暂无公开标签。</p>
        </div>
      ) : (
        <div class="sc-tags-index">
          {tags.map((tag) => (
            <a class="sc-tag-row" href={`/tags/${tag.slug}`}>
              <span>{tag.name}</span>
              <span>{tag.post_count} 篇</span>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</SiteLayout>
