---
import SiteLayout from '@/components/layout/SiteLayout.astro';
import PageHero from '@/components/editorial/PageHero.astro';
import { ROBOTS_NOINDEX_NOFOLLOW } from '@/lib/seo';

Astro.response.status = 404;
---

<SiteLayout title="纸页未寻得 | Sakura Cactus" description="没有找到这张纸页。" robots={ROBOTS_NOINDEX_NOFOLLOW}>
  <section class="sc-page">
    <div class="sc-page-shell">
      <PageHero label="Errata · 404" title="这里暂时没有文字" subtitle="可能是地址写错了，也可能这张纸页已经被收起。" />
      <div class="sc-empty sc-empty-links">
        <a class="sc-draw-link" href="/">← 返回首页</a>
        <a class="sc-draw-link" href="/articles">浏览文章 →</a>
      </div>
    </div>
  </section>
</SiteLayout>
