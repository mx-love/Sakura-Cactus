---
import SiteLayout from '@/components/layout/SiteLayout.astro';
import { getPublicPosts } from '@/features/posts/post.service';

export const prerender = false;

function isAboutPost(post: Awaited<ReturnType<typeof getPublicPosts>>[number]) {
  return post.tags.some((tag) => tag.slug === 'about' || tag.name.toLowerCase() === 'about');
}

function getSearchDateTerms(value: string | null) {
  if (!value) {
    return [];
  }

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return [];
  }

  const year = date.getFullYear();
  const month = date.getMonth() + 1;
  const day = date.getDate();
  const mm = String(month).padStart(2, '0');
  const dd = String(day).padStart(2, '0');

  return [
    `${year}/${mm}/${dd}`,
    `${year}-${mm}-${dd}`,
    `${year}年${month}月${day}日`,
    `${year}年${mm}月${dd}日`,
    `${month}月${day}日`,
    `${mm}/${dd}`,
    `${month}/${day}`,
    `${day}日`,
    `${day}号`,
    `${year}年${month}月`,
    `${year}年${mm}月`,
    `${year}/${mm}`,
    `${year}-${month}`,
    `${year}-${mm}`,
    String(year)
  ];
}

const posts = (await getPublicPosts()).filter((post) => !isAboutPost(post));
const searchPosts = posts.map((post) => {
  const tags = post.tags.map((tag) => tag.name);

  return {
    title: post.title,
    excerpt: post.excerpt ?? '',
    slug: post.slug,
    publishedAt: post.publishedAt,
    tags,
    searchableText: [post.title, post.excerpt ?? '', ...tags, ...getSearchDateTerms(post.publishedAt)].join(' ').toLowerCase()
  };
});
const searchJson = JSON.stringify(searchPosts).replace(/</g, '\\u003c');
---

<SiteLayout title="搜索 | Sakura Cactus" description="搜索公开文章。">
  <section class="sc-page">
    <div class="sc-public-shell">
      <nav class="sc-breadcrumb" aria-label="面包屑">
        <a href="/">首页</a>
        <span>»</span>
        <span>搜索</span>
      </nav>

      <header class="sc-page-header">
        <h1>搜索</h1>
      </header>

      <div class="sc-search">
        <input id="search-input" class="sc-search-input" type="search" placeholder="请输入关键字" autocomplete="off" aria-label="搜索公开文章" />
        <p id="search-count" class="sc-search-count"></p>
      </div>

      <div id="search-results" class="sc-post-list"></div>

      <template id="search-empty-template">
        <div class="sc-empty">
          <p>没有找到匹配的文章。</p>
        </div>
      </template>

      <script id="search-posts" type="application/json" set:html={searchJson}></script>
      <script is:inline>
        const postsElement = document.getElementById('search-posts');
        const input = document.getElementById('search-input');
        const results = document.getElementById('search-results');
        const count = document.getElementById('search-count');
        const emptyTemplate = document.getElementById('search-empty-template');
        const posts = JSON.parse(postsElement?.textContent || '[]');
        const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
          year: 'numeric',
          month: '2-digit',
          day: '2-digit'
        });

        function createCalendarIcon() {
          const span = document.createElement('span');
          span.className = 'sc-calendar-icon';
          span.setAttribute('aria-hidden', 'true');
          span.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 2v4" /><path d="M16 2v4" /><path d="M3 10h18" /><rect x="3" y="4" width="18" height="18" rx="2" /></svg>';
          return span;
        }

        function render(items) {
          if (!results || !count || !emptyTemplate) return;

          results.textContent = '';
          count.textContent = items.length ? `${items.length} 篇文章` : '';

          if (!input?.value.trim()) {
            count.textContent = '';
            return;
          }

          if (items.length === 0) {
            results.append(emptyTemplate.content.cloneNode(true));
            return;
          }

          for (const post of items) {
            const article = document.createElement('article');
            article.className = 'sc-post-entry';

            const title = document.createElement('h2');
            const link = document.createElement('a');
            link.href = `/posts/${post.slug}`;
            link.textContent = post.title;
            title.append(link);
            article.append(title);

            if (post.publishedAt) {
              const meta = document.createElement('p');
              meta.className = 'sc-post-meta';
              const time = document.createElement('time');
              time.dateTime = post.publishedAt;
              time.textContent = dateFormatter.format(new Date(post.publishedAt));
              meta.append(createCalendarIcon(), time);
              article.append(meta);
            }

            if (post.excerpt) {
              const excerpt = document.createElement('p');
              excerpt.className = 'sc-post-excerpt';
              excerpt.textContent = post.excerpt;
              article.append(excerpt);
            }

            if (post.tags.length) {
              const tagList = document.createElement('div');
              tagList.className = 'sc-tag-list';
              for (const tag of post.tags) {
                const tagItem = document.createElement('span');
                tagItem.className = 'sc-tag-link sc-tag-link-static';
                tagItem.textContent = tag;
                tagList.append(tagItem);
              }
              article.append(tagList);
            }

            results.append(article);
          }
        }

        function search() {
          const query = input?.value.trim().toLowerCase() || '';
          if (!query) {
            render([]);
            return;
          }

          render(posts.filter((post) => {
            return String(post.searchableText || '').includes(query);
          }));
        }

        input?.addEventListener('input', search);
        render([]);
      </script>
    </div>
  </section>
</SiteLayout>
