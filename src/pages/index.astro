---
import SiteLayout from '@/components/layout/SiteLayout.astro';
import { getPublicPosts } from '@/features/posts/post.service';
import { ROBOTS_INDEX_FOLLOW, absoluteSiteUrl } from '@/lib/seo';
import { env } from 'cloudflare:workers';

export const prerender = false;

const posts = await getPublicPosts({ limit: 12, excludeAbout: true, pinnedFirst: true });
const latestPosts = posts.slice(0, 5);
const siteName = env.SITE_NAME?.trim() || 'Sakura Cactus';
const tagline = env.SITE_TAGLINE?.trim() || '温柔地写，安静地收录。';
const siteDescription = env.SITE_DESCRIPTION?.trim() || '一些文章、笔记，以及慢慢整理的想法。';
const homeCanonicalUrl = absoluteSiteUrl('/');
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  description: siteDescription,
  url: homeCanonicalUrl,
  inLanguage: 'zh-CN'
};
const leadPost = latestPosts[0] ?? null;
const notePosts = latestPosts.slice(1);
type PaperQuote = {
  text: string;
  author: string;
  work: string;
};

const paperQuotes: PaperQuote[] = [
  { text: '明月松间照，清泉石上流。', author: '王维', work: '山居秋暝' },
  { text: '行到水穷处，坐看云起时。', author: '王维', work: '终南别业' },
  { text: '山光悦鸟性，潭影空人心。', author: '常建', work: '题破山寺后禅院' },
  { text: '星垂平野阔，月涌大江流。', author: '杜甫', work: '旅夜书怀' },
  { text: '春水碧于天，画船听雨眠。', author: '韦庄', work: '菩萨蛮·人人尽说江南好' },
  { text: '小楼一夜听春雨，深巷明朝卖杏花。', author: '陆游', work: '临安春雨初霁' },
  { text: '竹杖芒鞋轻胜马，谁怕？一蓑烟雨任平生。', author: '苏轼', work: '定风波·莫听穿林打叶声' },
  { text: '人生如逆旅，我亦是行人。', author: '苏轼', work: '临江仙·送钱穆父' },
  { text: '晚来天欲雪，能饮一杯无。', author: '白居易', work: '问刘十九' },
  { text: '疏影横斜水清浅，暗香浮动月黄昏。', author: '林逋', work: '山园小梅二首·其一' }
];
const leadCoverOrigin = getExternalOrigin(leadPost?.coverImageUrl);
const preconnectOrigins = leadCoverOrigin ? [leadCoverOrigin] : [];
const now = new Date();
const calendarYear = now.getFullYear();
const calendarMonth = now.getMonth();
const daysInMonth = new Date(calendarYear, calendarMonth + 1, 0).getDate();
const monthStartDay = new Date(calendarYear, calendarMonth, 1).getDay();
const weekdays = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];
const heavenlyStems = ['甲', '乙', '丙', '丁', '戊', '己', '庚', '辛', '壬', '癸'];
const earthlyBranches = [
  { branch: '子', zodiac: '鼠' },
  { branch: '丑', zodiac: '牛' },
  { branch: '寅', zodiac: '虎' },
  { branch: '卯', zodiac: '兔' },
  { branch: '辰', zodiac: '龙' },
  { branch: '巳', zodiac: '蛇' },
  { branch: '午', zodiac: '马' },
  { branch: '未', zodiac: '羊' },
  { branch: '申', zodiac: '猴' },
  { branch: '酉', zodiac: '鸡' },
  { branch: '戌', zodiac: '狗' },
  { branch: '亥', zodiac: '猪' }
];
const dayOfYear = Math.floor((Date.UTC(calendarYear, calendarMonth, now.getDate()) - Date.UTC(calendarYear, 0, 1)) / 86_400_000) + 1;
const isoWeekDate = new Date(Date.UTC(calendarYear, calendarMonth, now.getDate()));
const isoDay = isoWeekDate.getUTCDay() || 7;
isoWeekDate.setUTCDate(isoWeekDate.getUTCDate() + 4 - isoDay);
const isoYearStart = new Date(Date.UTC(isoWeekDate.getUTCFullYear(), 0, 1));
const isoWeek = Math.ceil(((isoWeekDate.getTime() - isoYearStart.getTime()) / 86_400_000 + 1) / 7);
const stem = heavenlyStems[(calendarYear - 4) % 10];
const branchInfo = earthlyBranches[(calendarYear - 4) % 12];
const ganzhiYear = `${stem}${branchInfo.branch}${branchInfo.zodiac}年`;

const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit'
});

function formatDate(value: string | null) {
  return value ? dateFormatter.format(new Date(value)) : '';
}

function formatCalendarDate(year: number, monthIndex: number, day: number) {
  return `${year}-${String(monthIndex + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
}

function formatPaperQuote(quote: PaperQuote) {
  return `${quote.text} —— ${quote.author}《${quote.work}》`;
}

function getExternalOrigin(value: string | null | undefined): string | null {
  if (!value) {
    return null;
  }

  try {
    const url = new URL(value);
    return url.protocol === 'http:' || url.protocol === 'https:' ? url.origin : null;
  } catch {
    return null;
  }
}

---

<SiteLayout canonicalUrl={homeCanonicalUrl} robots={ROBOTS_INDEX_FOLLOW} jsonLd={websiteJsonLd} preconnectOrigins={preconnectOrigins}>
  <section class="sc-page">
    <div class="sc-public-shell">
      <header class="sc-home-editorial">
        <div class="sc-home-desk">
          <div class="sc-home-intro sc-paper-piece">
            <span class="sc-paper-kicker">窗边纸页</span>
            <h1>{siteName}</h1>
            <p class="sc-home-signature">{tagline}</p>
            <p class="sc-home-description">{siteDescription}</p>
          </div>

          <aside class="sc-calendar-note" aria-label="今日纸页">
            <div class="sc-calendar-note-head">
              <span>今日纸页</span>
              <strong data-calendar-title>{calendarYear}年{calendarMonth + 1}月 · {weekdays[now.getDay()]}</strong>
            </div>
            <div class="sc-calendar-weekdays" aria-hidden="true">
              {['日', '一', '二', '三', '四', '五', '六'].map((day) => (
                <span>{day}</span>
              ))}
            </div>
            <div class="sc-calendar-grid" aria-hidden="true" data-calendar-grid>
              {Array.from({ length: monthStartDay }).map(() => <span class="sc-calendar-empty"></span>)}
              {Array.from({ length: daysInMonth }).map((_, index) => {
                const day = index + 1;
                return (
                  <span class="sc-calendar-day" data-date={formatCalendarDate(calendarYear, calendarMonth, day)}>
                    {day}
                  </span>
                );
              })}
            </div>
            <div class="sc-calendar-note-foot">
              <span data-calendar-day-week>第{dayOfYear}天 第{isoWeek}周</span>
              <span data-calendar-ganzhi>{ganzhiYear}</span>
            </div>
            <script>
              const calendarTitle = document.querySelector('[data-calendar-title]');
              const calendarGrid = document.querySelector('[data-calendar-grid]');
              const calendarDayWeek = document.querySelector('[data-calendar-day-week]');
              const calendarGanzhi = document.querySelector('[data-calendar-ganzhi]');
              const weekdays = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];
              const stems = ['甲', '乙', '丙', '丁', '戊', '己', '庚', '辛', '壬', '癸'];
              const branches = [
                ['子', '鼠'],
                ['丑', '牛'],
                ['寅', '虎'],
                ['卯', '兔'],
                ['辰', '龙'],
                ['巳', '蛇'],
                ['午', '马'],
                ['未', '羊'],
                ['申', '猴'],
                ['酉', '鸡'],
                ['戌', '狗'],
                ['亥', '猪']
              ];

              function formatLocalDate(date) {
                return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
              }

              function getDayOfYear(date) {
                const start = new Date(date.getFullYear(), 0, 1);
                return Math.floor((date.getTime() - start.getTime()) / 86400000) + 1;
              }

              function getIsoWeek(date) {
                const utcDate = new Date(Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()));
                const isoDay = utcDate.getUTCDay() || 7;
                utcDate.setUTCDate(utcDate.getUTCDate() + 4 - isoDay);
                const yearStart = new Date(Date.UTC(utcDate.getUTCFullYear(), 0, 1));
                return Math.ceil(((utcDate.getTime() - yearStart.getTime()) / 86400000 + 1) / 7);
              }

              function getGanzhiYear(year) {
                const stem = stems[(year - 4) % 10];
                const [branch, zodiac] = branches[(year - 4) % 12];
                return `${stem}${branch}${zodiac}年`;
              }

              function renderCalendar() {
                const today = new Date();
                const year = today.getFullYear();
                const month = today.getMonth();
                const todayKey = formatLocalDate(today);
                const daysInMonth = new Date(year, month + 1, 0).getDate();
                const monthStartDay = new Date(year, month, 1).getDay();

                if (calendarTitle) {
                  calendarTitle.textContent = `${year}年${month + 1}月 · ${weekdays[today.getDay()]}`;
                }

                if (calendarDayWeek) {
                  calendarDayWeek.textContent = `第${getDayOfYear(today)}天 第${getIsoWeek(today)}周`;
                }

                if (calendarGanzhi) {
                  calendarGanzhi.textContent = getGanzhiYear(year);
                }

                if (!calendarGrid) {
                  return;
                }

                calendarGrid.replaceChildren();

                for (let index = 0; index < monthStartDay; index += 1) {
                  const empty = document.createElement('span');
                  empty.className = 'sc-calendar-empty';
                  calendarGrid.append(empty);
                }

                for (let day = 1; day <= daysInMonth; day += 1) {
                  const date = new Date(year, month, day);
                  const cell = document.createElement('span');
                  cell.className = 'sc-calendar-day';
                  cell.dataset.date = formatLocalDate(date);
                  cell.textContent = String(day);

                  if (cell.dataset.date === todayKey) {
                    cell.classList.add('sc-calendar-today');
                  }

                  calendarGrid.append(cell);
                }
              }

              renderCalendar();
            </script>
          </aside>
        </div>
      </header>

      <section class="sc-section sc-home-articles">
        <div class="sc-section-heading">
          <h2>最近文章</h2>
          <a href="/articles">所有文章 →</a>
        </div>

        {latestPosts.length === 0 ? (
          <div class="sc-empty">
            <p>还没有公开文章。</p>
            <p>第一篇文章收录后会显示在这里。</p>
          </div>
        ) : (
          <div class="sc-home-posts">
            {leadPost ? (
              <article class:list={['sc-featured-paper', leadPost.coverImageUrl && 'sc-featured-paper-with-cover']}>
                {leadPost.coverImageUrl ? (
                  <a class="sc-featured-cover" href={`/posts/${leadPost.slug}`} aria-label={leadPost.title}>
                    <img
                      src={leadPost.coverImageUrl}
                      alt=""
                      width="960"
                      height="540"
                      loading="eager"
                      decoding="async"
                      fetchpriority="high"
                    />
                  </a>
                ) : null}
                <div class="sc-featured-paper-body">
                  <h3>
                    <a href={`/posts/${leadPost.slug}`}>{leadPost.title}</a>
                  </h3>
                  {leadPost.publishedAt ? <time datetime={leadPost.publishedAt}>{formatDate(leadPost.publishedAt)}</time> : null}
                  {leadPost.excerpt ? <p>{leadPost.excerpt}</p> : null}
                  {leadPost.tags.length > 0 ? (
                    <div class="sc-tag-list">
                      {leadPost.tags.map((tag) => (
                        <a class="sc-tag-link" href={`/tags/${tag.slug}`}>{tag.name}</a>
                      ))}
                    </div>
                  ) : null}
                </div>
              </article>
            ) : null}

            {notePosts.length > 0 ? (
              <div class="sc-paper-strip-list">
                {notePosts.map((post) => (
                  <article class="sc-paper-strip">
                    <div>
                      <h3>
                        <a href={`/posts/${post.slug}`}>{post.title}</a>
                      </h3>
                      {post.excerpt ? <p>{post.excerpt}</p> : null}
                    </div>
                    {post.publishedAt ? <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time> : null}
                  </article>
                ))}
              </div>
            ) : null}
          </div>
        )}
      </section>

      <section class="sc-home-quote" aria-label="纸页摘句" data-paper-quotes={JSON.stringify(paperQuotes)} data-animate="false">
        <span class="sc-home-quote-label">纸页摘句</span>
        <span class="sc-home-quote-separator" aria-hidden="true">｜</span>
        <div class="sc-home-quote-body" data-paper-quote-body>
          <span
            class="sc-home-quote-content"
            data-paper-quote-content
            aria-label={formatPaperQuote(paperQuotes[0])}
            data-paper-quote-full={formatPaperQuote(paperQuotes[0])}
          >
            <span class="sc-home-quote-text" data-paper-quote-text>{paperQuotes[0].text}</span>
            <span class="sc-home-quote-meta" data-paper-quote-meta> —— {paperQuotes[0].author}《{paperQuotes[0].work}》</span>
          </span>
        </div>
        <script>
          const quoteRoot = document.querySelector('[data-paper-quotes]');
          const quoteBody = quoteRoot?.querySelector('[data-paper-quote-body]');
          const quoteContent = quoteRoot?.querySelector('[data-paper-quote-content]');
          const quoteText = quoteRoot?.querySelector('[data-paper-quote-text]');
          const quoteMeta = quoteRoot?.querySelector('[data-paper-quote-meta]');

          if (
            quoteRoot instanceof HTMLElement &&
            quoteBody instanceof HTMLElement &&
            quoteContent instanceof HTMLElement &&
            quoteText instanceof HTMLElement &&
            quoteMeta instanceof HTMLElement
          ) {
            let quotes = [];

            try {
              const parsed = JSON.parse(quoteRoot.dataset.paperQuotes || '[]');
              quotes = Array.isArray(parsed)
                ? parsed.filter(
                    (item) =>
                      item &&
                      typeof item === 'object' &&
                      typeof item.text === 'string' &&
                      item.text.trim() &&
                      typeof item.author === 'string' &&
                      item.author.trim() &&
                      typeof item.work === 'string' &&
                      item.work.trim()
                  )
                : [];
            } catch {
              quotes = [];
            }

            if (quotes.length > 0) {
              const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
              const hoverPauseQuery = window.matchMedia('(hover: hover) and (pointer: fine)');
              const fadeDuration = 220;
              const initialPauseGuardUntil = Date.now() + 1200;
              let currentIndex = Math.floor(Math.random() * quotes.length);
              let rotationTimer = 0;
              let fadeTimer = 0;
              let resizeTimer = 0;
              let paused = false;

              function formatQuote(quote) {
                return `${quote.text} —— ${quote.author}《${quote.work}》`;
              }

              function clearTimers() {
                window.clearTimeout(rotationTimer);
                window.clearTimeout(fadeTimer);
                rotationTimer = 0;
                fadeTimer = 0;
              }

              function scheduleAdvance(delay) {
                clearTimers();

                if (paused) {
                  return;
                }

                rotationTimer = window.setTimeout(() => {
                  if (!reducedMotionQuery.matches) {
                    quoteRoot.classList.add('is-fading');
                  }

                  fadeTimer = window.setTimeout(() => {
                    quoteRoot.classList.remove('is-fading');
                    applyQuote(currentIndex + 1);
                  }, reducedMotionQuery.matches ? 0 : fadeDuration);
                }, delay);
              }

              function applyQuote(index) {
                currentIndex = (index + quotes.length) % quotes.length;
                quoteRoot.classList.remove('is-fading');
                quoteRoot.dataset.animate = 'false';
                quoteRoot.style.removeProperty('--sc-quote-shift');
                quoteRoot.style.removeProperty('--sc-quote-duration');
                quoteText.textContent = quotes[currentIndex].text;
                quoteMeta.textContent = ` —— ${quotes[currentIndex].author}《${quotes[currentIndex].work}》`;
                quoteContent.setAttribute('aria-label', formatQuote(quotes[currentIndex]));
                quoteContent.dataset.paperQuoteFull = formatQuote(quotes[currentIndex]);

                requestAnimationFrame(() => {
                  const overflow = Math.max(0, Math.ceil(quoteContent.scrollWidth - quoteBody.clientWidth));
                  const allowScroll = !reducedMotionQuery.matches && overflow > 12;
                  let displayDuration = reducedMotionQuery.matches ? 10000 : 7800;

                  if (allowScroll) {
                    const distance = overflow + 32;
                    const durationSeconds = Math.max(20, 7 + distance / 16);
                    quoteRoot.dataset.animate = 'true';
                    quoteRoot.style.setProperty('--sc-quote-shift', `-${distance}px`);
                    quoteRoot.style.setProperty('--sc-quote-duration', `${durationSeconds}s`);
                    displayDuration = Math.round(durationSeconds * 1000 + 1200);
                  }

                  scheduleAdvance(displayDuration);
                });
              }

              function pauseQuotes() {
                if (!hoverPauseQuery.matches || Date.now() < initialPauseGuardUntil) {
                  return;
                }

                paused = true;
                quoteRoot.classList.add('is-paused');
                quoteRoot.classList.remove('is-fading');
                clearTimers();
              }

              function resumeQuotes() {
                if (!hoverPauseQuery.matches) {
                  return;
                }

                paused = false;
                quoteRoot.classList.remove('is-paused');
                applyQuote(currentIndex);
              }

              function handleEnvironmentChange() {
                paused = false;
                quoteRoot.classList.remove('is-paused', 'is-fading');
                clearTimers();
                applyQuote(currentIndex);
              }

              function bindMediaChange(mediaQuery, handler) {
                if ('addEventListener' in mediaQuery) {
                  mediaQuery.addEventListener('change', handler);
                  return;
                }

                mediaQuery.addListener(handler);
              }

              quoteRoot.addEventListener('mouseenter', pauseQuotes);
              quoteRoot.addEventListener('mouseleave', resumeQuotes);

              bindMediaChange(reducedMotionQuery, handleEnvironmentChange);
              bindMediaChange(hoverPauseQuery, handleEnvironmentChange);

              window.addEventListener('resize', () => {
                window.clearTimeout(resizeTimer);
                resizeTimer = window.setTimeout(() => {
                  quoteRoot.classList.remove('is-fading');
                  clearTimers();
                  applyQuote(currentIndex);
                }, 120);
              });

              applyQuote(currentIndex);
            }
          }
        </script>
      </section>
    </div>
  </section>
</SiteLayout>
