---
import SiteLayout from '@/components/layout/SiteLayout.astro';
---

<SiteLayout>
  <section class="min-h-screen bg-[var(--color-bg)] px-6 py-16 text-[var(--color-text)]">
    <div class="mx-auto flex max-w-4xl flex-col gap-8">
      <p class="text-sm font-medium uppercase tracking-[0.18em] text-[var(--color-muted)]">
        Cloudflare native blog
      </p>
      <div class="space-y-5">
        <h1 class="text-4xl font-semibold sm:text-6xl">Sakura Cactus</h1>
        <p class="max-w-2xl text-lg leading-8 text-[var(--color-muted)]">
          一个基于 Astro、Cloudflare Workers、D1 和 R2 的个人博客系统。当前为阶段 1 骨架页面。
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-3">
        <div class="rounded-lg border border-[var(--color-border)] bg-white/70 p-5 shadow-sm">
          <h2 class="text-base font-semibold">Astro</h2>
          <p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">前台页面和服务端路由。</p>
        </div>
        <div class="rounded-lg border border-[var(--color-border)] bg-white/70 p-5 shadow-sm">
          <h2 class="text-base font-semibold">Cloudflare</h2>
          <p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">Workers、D1、R2 部署目标。</p>
        </div>
        <div class="rounded-lg border border-[var(--color-border)] bg-white/70 p-5 shadow-sm">
          <h2 class="text-base font-semibold">Admin</h2>
          <p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">后续阶段实现自带后台。</p>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
