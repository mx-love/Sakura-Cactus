---
import SiteLayout from '@/components/layout/SiteLayout.astro';
import { getPublicPosts } from '@/features/posts/post.service';

export const prerender = false;

const posts = await getPublicPosts();
const latestPosts = posts.slice(0, 5);
---

<SiteLayout>
  <section class="sc-page">
    <div class="sc-shell">
      <header class="py-10 sm:py-14">
        <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl">Sakura Cactus</h1>
        <p class="mt-4 text-xl leading-8 text-[var(--color-muted)]">温柔地写，安静地发布。</p>
        <p class="mt-5 max-w-2xl leading-8 text-[var(--color-muted)]">
          一个 AstroPaper 式高级极简博客，背后接着 Cloudflare D1、私有 R2 和自己的写作系统。这里收集文章、笔记和长期保存的想法。
        </p>
      </header>

      <section class="py-6">
        <div class="mb-8 flex items-end justify-between gap-4">
          <div>
            <p class="text-sm font-bold uppercase tracking-[0.12em] text-[var(--color-subtle)]">Latest posts</p>
            <h2 class="mt-1 text-2xl font-extrabold">最近文章</h2>
          </div>
          <a class="text-sm font-bold text-[var(--color-primary)] hover:underline" href="/articles">全部文章</a>
        </div>

        {latestPosts.length === 0 ? (
          <p class="rounded-md border border-dashed border-[var(--color-border)] px-4 py-5 text-sm text-[var(--color-muted)]">
            还没有公开文章。发布第一篇文章后，它会出现在这里。
          </p>
        ) : (
          <div class="sc-post-list">
            {latestPosts.map((post) => (
              <article class="sc-post-item">
                <p class="text-sm text-[var(--color-muted)]">
                  {post.publishedAt ? new Date(post.publishedAt).toLocaleDateString() : 'Published'}
                </p>
                <h3 class="mt-2 text-2xl font-extrabold tracking-tight">
                  <a class="hover:text-[var(--color-primary)]" href={`/posts/${post.slug}`}>{post.title}</a>
                </h3>
                {post.excerpt ? <p class="mt-3 leading-7 text-[var(--color-muted)]">{post.excerpt}</p> : null}
              </article>
            ))}
          </div>
        )}
      </section>

      <footer class="mt-12 flex flex-col gap-2 border-t border-[var(--color-border)] py-8 text-sm text-[var(--color-muted)] sm:flex-row sm:items-center sm:justify-between">
        <p>Sakura Cactus</p>
        <p>RSS · Copyright {new Date().getFullYear()}</p>
      </footer>
    </div>
  </section>
</SiteLayout>
