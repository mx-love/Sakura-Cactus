---
import SiteLayout from '@/components/layout/SiteLayout.astro';
import { getPublicPosts } from '@/features/posts/post.service';
import { env } from 'cloudflare:workers';

export const prerender = false;

const posts = await getPublicPosts({ limit: 12, excludeAbout: true, pinnedFirst: true });
const latestPosts = posts.slice(0, 5);
const siteName = env.SITE_NAME?.trim() || 'Sakura Cactus';
const tagline = env.SITE_TAGLINE?.trim() || '温柔地写，安静地发布。';
const siteDescription = env.SITE_DESCRIPTION?.trim() || '一些文章、笔记，以及慢慢整理的想法。';
const leadPost = latestPosts[0] ?? null;
const notePosts = latestPosts.slice(1);
const leadCoverOrigin = getExternalOrigin(leadPost?.coverImageUrl);
const preconnectOrigins = leadCoverOrigin ? [leadCoverOrigin] : [];
const now = new Date();
const calendarYear = now.getFullYear();
const calendarMonth = now.getMonth();
const daysInMonth = new Date(calendarYear, calendarMonth + 1, 0).getDate();
const monthStartDay = new Date(calendarYear, calendarMonth, 1).getDay();
const weekdays = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];
const heavenlyStems = ['甲', '乙', '丙', '丁', '戊', '己', '庚', '辛', '壬', '癸'];
const earthlyBranches = [
  { branch: '子', zodiac: '鼠' },
  { branch: '丑', zodiac: '牛' },
  { branch: '寅', zodiac: '虎' },
  { branch: '卯', zodiac: '兔' },
  { branch: '辰', zodiac: '龙' },
  { branch: '巳', zodiac: '蛇' },
  { branch: '午', zodiac: '马' },
  { branch: '未', zodiac: '羊' },
  { branch: '申', zodiac: '猴' },
  { branch: '酉', zodiac: '鸡' },
  { branch: '戌', zodiac: '狗' },
  { branch: '亥', zodiac: '猪' }
];
const dayOfYear = Math.floor((Date.UTC(calendarYear, calendarMonth, now.getDate()) - Date.UTC(calendarYear, 0, 1)) / 86_400_000) + 1;
const isoWeekDate = new Date(Date.UTC(calendarYear, calendarMonth, now.getDate()));
const isoDay = isoWeekDate.getUTCDay() || 7;
isoWeekDate.setUTCDate(isoWeekDate.getUTCDate() + 4 - isoDay);
const isoYearStart = new Date(Date.UTC(isoWeekDate.getUTCFullYear(), 0, 1));
const isoWeek = Math.ceil(((isoWeekDate.getTime() - isoYearStart.getTime()) / 86_400_000 + 1) / 7);
const stem = heavenlyStems[(calendarYear - 4) % 10];
const branchInfo = earthlyBranches[(calendarYear - 4) % 12];
const ganzhiYear = `${stem}${branchInfo.branch}${branchInfo.zodiac}年`;
const tagMap = new Map<string, { name: string; slug: string; count: number }>();

for (const post of posts) {
  for (const tag of post.tags) {
    const current = tagMap.get(tag.slug);

    if (current) {
      current.count += 1;
    } else {
      tagMap.set(tag.slug, { name: tag.name, slug: tag.slug, count: 1 });
    }
  }
}

const tagCloud = [...tagMap.values()].sort((a, b) => b.count - a.count || a.name.localeCompare(b.name)).slice(0, 8);

const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit'
});

function formatDate(value: string | null) {
  return value ? dateFormatter.format(new Date(value)) : '';
}

function formatCalendarDate(year: number, monthIndex: number, day: number) {
  return `${year}-${String(monthIndex + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
}

function getExternalOrigin(value: string | null | undefined): string | null {
  if (!value) {
    return null;
  }

  try {
    const url = new URL(value);
    return url.protocol === 'http:' || url.protocol === 'https:' ? url.origin : null;
  } catch {
    return null;
  }
}

---

<SiteLayout preconnectOrigins={preconnectOrigins}>
  <section class="sc-page">
    <div class="sc-public-shell">
      <div class="sc-home-desk">
        <header class="sc-home-intro sc-paper-piece">
          <span class="sc-paper-kicker">窗边纸页</span>
          <h1>{siteName}</h1>
          <p class="sc-home-signature">{tagline}</p>
          <p class="sc-home-description">{siteDescription}</p>
        </header>

        <aside class="sc-calendar-note" aria-label="今日纸页">
          <div class="sc-calendar-note-head">
            <span>今日纸页</span>
            <strong data-calendar-title>{calendarYear}年{calendarMonth + 1}月 · {weekdays[now.getDay()]}</strong>
          </div>
          <div class="sc-calendar-weekdays" aria-hidden="true">
            {['日', '一', '二', '三', '四', '五', '六'].map((day) => (
              <span>{day}</span>
            ))}
          </div>
          <div class="sc-calendar-grid" aria-hidden="true" data-calendar-grid>
            {Array.from({ length: monthStartDay }).map(() => <span class="sc-calendar-empty"></span>)}
            {Array.from({ length: daysInMonth }).map((_, index) => {
              const day = index + 1;
              return (
                <span class="sc-calendar-day" data-date={formatCalendarDate(calendarYear, calendarMonth, day)}>
                  {day}
                </span>
              );
            })}
          </div>
          <div class="sc-calendar-note-foot">
            <span data-calendar-day-week>第{dayOfYear}天 第{isoWeek}周</span>
            <span data-calendar-ganzhi>{ganzhiYear}</span>
          </div>
          <script>
            const calendarTitle = document.querySelector('[data-calendar-title]');
            const calendarGrid = document.querySelector('[data-calendar-grid]');
            const calendarDayWeek = document.querySelector('[data-calendar-day-week]');
            const calendarGanzhi = document.querySelector('[data-calendar-ganzhi]');
            const weekdays = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];
            const stems = ['甲', '乙', '丙', '丁', '戊', '己', '庚', '辛', '壬', '癸'];
            const branches = [
              ['子', '鼠'],
              ['丑', '牛'],
              ['寅', '虎'],
              ['卯', '兔'],
              ['辰', '龙'],
              ['巳', '蛇'],
              ['午', '马'],
              ['未', '羊'],
              ['申', '猴'],
              ['酉', '鸡'],
              ['戌', '狗'],
              ['亥', '猪']
            ];

            function formatLocalDate(date) {
              return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
            }

            function getDayOfYear(date) {
              const start = new Date(date.getFullYear(), 0, 1);
              return Math.floor((date.getTime() - start.getTime()) / 86400000) + 1;
            }

            function getIsoWeek(date) {
              const utcDate = new Date(Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()));
              const isoDay = utcDate.getUTCDay() || 7;
              utcDate.setUTCDate(utcDate.getUTCDate() + 4 - isoDay);
              const yearStart = new Date(Date.UTC(utcDate.getUTCFullYear(), 0, 1));
              return Math.ceil(((utcDate.getTime() - yearStart.getTime()) / 86400000 + 1) / 7);
            }

            function getGanzhiYear(year) {
              const stem = stems[(year - 4) % 10];
              const [branch, zodiac] = branches[(year - 4) % 12];
              return `${stem}${branch}${zodiac}年`;
            }

            function renderCalendar() {
              const today = new Date();
              const year = today.getFullYear();
              const month = today.getMonth();
              const todayKey = formatLocalDate(today);
              const daysInMonth = new Date(year, month + 1, 0).getDate();
              const monthStartDay = new Date(year, month, 1).getDay();

              if (calendarTitle) {
                calendarTitle.textContent = `${year}年${month + 1}月 · ${weekdays[today.getDay()]}`;
              }

              if (calendarDayWeek) {
                calendarDayWeek.textContent = `第${getDayOfYear(today)}天 第${getIsoWeek(today)}周`;
              }

              if (calendarGanzhi) {
                calendarGanzhi.textContent = getGanzhiYear(year);
              }

              if (!calendarGrid) {
                return;
              }

              calendarGrid.replaceChildren();

              for (let index = 0; index < monthStartDay; index += 1) {
                const empty = document.createElement('span');
                empty.className = 'sc-calendar-empty';
                calendarGrid.append(empty);
              }

              for (let day = 1; day <= daysInMonth; day += 1) {
                const date = new Date(year, month, day);
                const cell = document.createElement('span');
                cell.className = 'sc-calendar-day';
                cell.dataset.date = formatLocalDate(date);
                cell.textContent = String(day);

                if (cell.dataset.date === todayKey) {
                  cell.classList.add('sc-calendar-today');
                }

                calendarGrid.append(cell);
              }
            }

            renderCalendar();
          </script>
        </aside>
      </div>

      <section class="sc-section">
        <div class="sc-section-heading">
          <h2>最近文章</h2>
          <a href="/articles">所有文章 →</a>
        </div>

        {latestPosts.length === 0 ? (
          <div class="sc-empty">
            <p>还没有公开文章。</p>
            <p>第一篇文章发布后会显示在这里。</p>
          </div>
        ) : (
          <div class="sc-home-posts">
            {leadPost ? (
              <article class:list={['sc-featured-paper', leadPost.coverImageUrl && 'sc-featured-paper-with-cover']}>
                {leadPost.coverImageUrl ? (
                  <a class="sc-featured-cover" href={`/posts/${leadPost.slug}`} aria-label={leadPost.title}>
                    <img
                      src={leadPost.coverImageUrl}
                      alt=""
                      width="960"
                      height="540"
                      loading="eager"
                      decoding="async"
                      fetchpriority="high"
                    />
                  </a>
                ) : null}
                <div class="sc-featured-paper-body">
                  <span class="sc-paper-kicker">最新整理</span>
                  <h3>
                    <a href={`/posts/${leadPost.slug}`}>{leadPost.title}</a>
                  </h3>
                  {leadPost.publishedAt ? <time datetime={leadPost.publishedAt}>{formatDate(leadPost.publishedAt)}</time> : null}
                  {leadPost.excerpt ? <p>{leadPost.excerpt}</p> : null}
                  {leadPost.tags.length > 0 ? (
                    <div class="sc-tag-list">
                      {leadPost.tags.map((tag) => (
                        <a class="sc-tag-link" href={`/tags/${tag.slug}`}>{tag.name}</a>
                      ))}
                    </div>
                  ) : null}
                </div>
              </article>
            ) : null}

            {notePosts.length > 0 ? (
              <div class="sc-paper-strip-list">
                {notePosts.map((post) => (
                  <article class="sc-paper-strip">
                    <div>
                      <h3>
                        <a href={`/posts/${post.slug}`}>{post.title}</a>
                      </h3>
                      {post.excerpt ? <p>{post.excerpt}</p> : null}
                    </div>
                    {post.publishedAt ? <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time> : null}
                  </article>
                ))}
              </div>
            ) : null}
          </div>
        )}
      </section>

      {tagCloud.length > 0 ? (
        <section class="sc-home-tags" aria-label="标签纸片">
          <span>纸页标签</span>
          <div class="sc-tag-list">
            {tagCloud.map((tag) => (
              <a class="sc-tag-pill" href={`/tags/${tag.slug}`}>{tag.name}</a>
            ))}
          </div>
        </section>
      ) : null}
    </div>
  </section>
</SiteLayout>
