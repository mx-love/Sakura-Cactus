---
import SiteLayout from '@/components/layout/SiteLayout.astro';
import { getPublicPosts } from '@/features/posts/post.service';

export const prerender = false;

const posts = await getPublicPosts();
const latestPosts = posts.slice(0, 5);

const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit'
});

function formatDate(value: string | null) {
  return value ? dateFormatter.format(new Date(value)) : '';
}
---

<SiteLayout>
  <section class="sc-page">
    <div class="sc-public-shell">
      <header class="sc-home-intro">
        <h1>Sakura Cactus</h1>
        <p class="sc-home-signature">温柔地写，安静地发布。</p>
        <p class="sc-home-description">一些文章、笔记，以及慢慢整理的想法。</p>
      </header>

      <section class="sc-section">
        <div class="sc-section-heading">
          <h2>最近文章</h2>
          <a href="/articles">所有文章 →</a>
        </div>

        {latestPosts.length === 0 ? (
          <div class="sc-empty">
            <p>还没有公开文章。</p>
            <p>第一篇文章发布后会显示在这里。</p>
          </div>
        ) : (
          <div class="sc-post-list">
            {latestPosts.map((post) => (
              <article class="sc-post-entry">
                <h3>
                  <a href={`/posts/${post.slug}`}>{post.title}</a>
                </h3>
                {post.publishedAt ? (
                  <p class="sc-post-meta">
                    <span class="sc-calendar-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M8 2v4" />
                        <path d="M16 2v4" />
                        <path d="M3 10h18" />
                        <rect x="3" y="4" width="18" height="18" rx="2" />
                      </svg>
                    </span>
                    <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
                  </p>
                ) : null}
                {post.excerpt ? <p class="sc-post-excerpt">{post.excerpt}</p> : null}
                {post.tags.length > 0 ? (
                  <div class="sc-tag-list">
                    {post.tags.map((tag) => (
                      <a class="sc-tag-link" href={`/tags/${tag.slug}`}>{tag.name}</a>
                    ))}
                  </div>
                ) : null}
              </article>
            ))}
          </div>
        )}
      </section>
    </div>
  </section>
</SiteLayout>
