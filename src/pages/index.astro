---
import SiteLayout from '@/components/layout/SiteLayout.astro';
import { getPublicMonthlyPostDates, getPublicMonthlyPostStats, getPublicPosts } from '@/features/posts/post.service';
import { ROBOTS_INDEX_FOLLOW, absoluteSiteUrl } from '@/lib/seo';
import { env } from 'cloudflare:workers';
import { getSiteCalendar, getSiteDateParts, getSiteMonthRange } from '@/lib/site-time';
import { getGanzhiYear } from '@/lib/ganzhi-year';
import PostIndex from '@/components/editorial/PostIndex.astro';
import { formatSiteDotDate } from '@/lib/site-time';

export const prerender = false;

const now = new Date();
const calendar = getSiteCalendar(now);
const calendarYear = calendar.year;
const calendarMonth = calendar.month - 1;
const { monthStart, nextMonthStart } = getSiteMonthRange(now);
const monthRange = { monthStart, nextMonthStart, currentTime: now.toISOString() };
const [posts, monthlyStats, publishedDates] = await Promise.all([
  getPublicPosts({ limit: 12, excludeAbout: true, pinnedFirst: true }),
  getPublicMonthlyPostStats(monthRange),
  getPublicMonthlyPostDates(monthRange)
]);
const postsByDay = new Map<number, number>();
for (const date of publishedDates) {
  const { day } = getSiteDateParts(date);
  postsByDay.set(day, (postsByDay.get(day) ?? 0) + 1);
}
const timelineMonthHref = `/timeline#y${calendarYear}-m${String(calendarMonth + 1).padStart(2, '0')}`;
const latestPosts = posts.slice(0, 5);
const siteName = env.SITE_NAME?.trim() || 'Sakura Cactus';
const tagline = env.SITE_TAGLINE?.trim() || '温柔地写，安静地收录。';
const siteDescription = env.SITE_DESCRIPTION?.trim() || '一些文章、笔记，以及慢慢整理的想法。';
const homeCanonicalUrl = absoluteSiteUrl('/');
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  description: siteDescription,
  url: homeCanonicalUrl,
  inLanguage: 'zh-CN'
};
const leadPost = latestPosts[0] ?? null;
const notePosts = latestPosts.slice(1);
type PaperQuote = {
  text: string;
  author: string;
  work: string;
};

const paperQuotes: PaperQuote[] = [
  { text: '明月松间照，清泉石上流。', author: '王维', work: '山居秋暝' },
  { text: '行到水穷处，坐看云起时。', author: '王维', work: '终南别业' },
  { text: '山光悦鸟性，潭影空人心。', author: '常建', work: '题破山寺后禅院' },
  { text: '星垂平野阔，月涌大江流。', author: '杜甫', work: '旅夜书怀' },
  { text: '春水碧于天，画船听雨眠。', author: '韦庄', work: '菩萨蛮·人人尽说江南好' },
  { text: '小楼一夜听春雨，深巷明朝卖杏花。', author: '陆游', work: '临安春雨初霁' },
  { text: '竹杖芒鞋轻胜马，谁怕？一蓑烟雨任平生。', author: '苏轼', work: '定风波·莫听穿林打叶声' },
  { text: '人生如逆旅，我亦是行人。', author: '苏轼', work: '临江仙·送钱穆父' },
  { text: '晚来天欲雪，能饮一杯无。', author: '白居易', work: '问刘十九' },
  { text: '疏影横斜水清浅，暗香浮动月黄昏。', author: '林逋', work: '山园小梅二首·其一' }
];
const leadCoverOrigin = getExternalOrigin(leadPost?.coverImageUrl);
const preconnectOrigins = leadCoverOrigin ? [leadCoverOrigin] : [];
const monthNames = [
  'JANUARY',
  'FEBRUARY',
  'MARCH',
  'APRIL',
  'MAY',
  'JUNE',
  'JULY',
  'AUGUST',
  'SEPTEMBER',
  'OCTOBER',
  'NOVEMBER',
  'DECEMBER'
];
const issueNumber = String(calendarMonth + 1).padStart(2, '0');
const issueLabel = `${calendarYear} · ${monthNames[calendarMonth]} / ISSUE ${issueNumber}`;
const formattedPostCount = String(monthlyStats.postCount).padStart(2, '0');
const formattedWordCount = new Intl.NumberFormat('zh-CN').format(monthlyStats.wordCount);
const { daysInMonth, monthStartDay, dayOfYear, isoWeek } = calendar;
const weekdays = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];
const ganzhiYear = getGanzhiYear(calendar);

function formatCalendarDate(year: number, monthIndex: number, day: number) {
  return `${year}-${String(monthIndex + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
}

function formatPaperQuote(quote: PaperQuote) {
  return `${quote.text} —— ${quote.author}《${quote.work}》`;
}

function getExternalOrigin(value: string | null | undefined): string | null {
  if (!value) {
    return null;
  }

  try {
    const url = new URL(value);
    return url.protocol === 'http:' || url.protocol === 'https:' ? url.origin : null;
  } catch {
    return null;
  }
}

---

<SiteLayout canonicalUrl={homeCanonicalUrl} robots={ROBOTS_INDEX_FOLLOW} jsonLd={websiteJsonLd} preconnectOrigins={preconnectOrigins}>
  <section class="sc-page">
    <div class="sc-page-shell sc-home-shell">
      <header class="sc-cover">
        <div class="sc-cover-main">
          <p class="sc-label sc-cover-issue">{issueLabel}</p>
          <h1 class="sc-cover-title">{siteName}</h1>
          <p class="sc-cover-tagline">{tagline}</p>
          <p class="sc-cover-description">{siteDescription}</p>
          {monthlyStats.postCount > 0 ? (
            <p class="sc-cover-stats">
              本月落笔{' '}<strong>{formattedPostCount}</strong>{' '}篇{' '}
              <span aria-hidden="true">·</span>{' '}<strong>{formattedWordCount}</strong>{' '}字
            </p>
          ) : (
            <p class="sc-cover-stats">本月留白，静候落笔。</p>
          )}
        </div>

        <aside class="sc-calendar-note sc-home-calendar" aria-label="今日纸页">
          <div class="sc-calendar-note-head">
            <span class="sc-label">今日纸页</span>
            <strong data-calendar-title>{calendarYear}年{calendarMonth + 1}月 · {weekdays[calendar.weekday]}</strong>
          </div>
          <div class="sc-calendar-weekdays" aria-hidden="true">
            {['日', '一', '二', '三', '四', '五', '六'].map((day) => (
              <span>{day}</span>
            ))}
          </div>
          <div class="sc-calendar-grid" aria-label={`${calendarYear}年${calendarMonth + 1}月文章日历`} data-calendar-grid>
            {Array.from({ length: monthStartDay }).map(() => <span class="sc-calendar-empty"></span>)}
            {Array.from({ length: daysInMonth }).map((_, index) => {
              const day = index + 1;
              const postCount = postsByDay.get(day) ?? 0;
              return (
                postCount > 0 ? (
                  <a class:list={['sc-calendar-day', 'sc-calendar-has-posts', day === calendar.day && 'sc-calendar-today']} href={timelineMonthHref} data-date={formatCalendarDate(calendarYear, calendarMonth, day)} aria-current={day === calendar.day ? 'date' : undefined} aria-label={`${calendarMonth + 1} 月 ${day} 日，${postCount} 篇文章`}>
                    {day}<span class="sc-calendar-post-dot" aria-hidden="true"></span>
                  </a>
                ) : (
                  <span class:list={['sc-calendar-day', day === calendar.day && 'sc-calendar-today']} data-date={formatCalendarDate(calendarYear, calendarMonth, day)} aria-current={day === calendar.day ? 'date' : undefined}>{day}</span>
                )
              );
            })}
          </div>
          <div class="sc-calendar-note-foot sc-label">
            <span data-calendar-day-week>第{dayOfYear}天 第{isoWeek}周</span>
            <span data-calendar-ganzhi>{ganzhiYear}</span>
          </div>
        </aside>
      </header>

      <section class="sc-home-articles" aria-labelledby="home-latest-heading">
        <div class="sc-section-heading">
          <h2 class="sc-label" id="home-latest-heading">Latest · 最近文章</h2>
          <a class="sc-label sc-draw-link" href="/articles" data-astro-prefetch>所有文章 →</a>
        </div>

        {latestPosts.length === 0 ? (
          <div class="sc-empty">
            <p>还没有公开文章。</p>
            <p>第一篇文章收录后会显示在这里。</p>
          </div>
        ) : (
          <>
            {leadPost ? (
              <article class:list={['sc-lead', leadPost.coverImageUrl && 'sc-lead-with-cover']}>
                {leadPost.coverImageUrl ? (
                  <a class="sc-lead-plate" href={`/posts/${leadPost.slug}`} tabindex="-1" aria-hidden="true" data-astro-prefetch>
                    <img
                      src={leadPost.coverImageUrl}
                      alt=""
                      width="960"
                      height="540"
                      loading="eager"
                      decoding="async"
                      fetchpriority="high"
                    />
                  </a>
                ) : null}
                <div class="sc-lead-body">
                  <p class="sc-label sc-index-meta">
                    <span class="sc-lead-kicker">No.01 · Lead</span>
                    {leadPost.publishedAt ? <time datetime={leadPost.publishedAt}>{formatSiteDotDate(leadPost.publishedAt)}</time> : null}
                    {leadPost.tags.map((tag) => (
                      <a class="sc-index-tag" href={`/tags/${tag.slug}`}>#{tag.name}</a>
                    ))}
                  </p>
                  <h3 class="sc-lead-title">
                    <a class="sc-draw-link" href={`/posts/${leadPost.slug}`} data-astro-prefetch>{leadPost.title}</a>
                  </h3>
                  {leadPost.excerpt ? <p class="sc-lead-excerpt">{leadPost.excerpt}</p> : null}
                  <a class="sc-label sc-lead-more sc-draw-link" href={`/posts/${leadPost.slug}`} data-astro-prefetch>阅读全文 →</a>
                </div>
              </article>
            ) : null}
            {notePosts.length > 0 ? <PostIndex posts={notePosts} startNumber={2} headingLevel="h3" showCovers={false} /> : null}
          </>
        )}
      </section>

      <section class="sc-home-quote" aria-label="纸页摘句" data-paper-quotes={JSON.stringify(paperQuotes)} data-animate="false">
        <span class="sc-home-quote-label sc-label">纸页摘句</span>
        <span class="sc-home-quote-separator" aria-hidden="true">｜</span>
        <div class="sc-home-quote-body" data-paper-quote-body>
          <span
            class="sc-home-quote-content"
            data-paper-quote-content
            aria-label={formatPaperQuote(paperQuotes[0])}
            data-paper-quote-full={formatPaperQuote(paperQuotes[0])}
          >
            <span class="sc-home-quote-text" data-paper-quote-text>{paperQuotes[0].text}</span>
            <span class="sc-home-quote-meta" data-paper-quote-meta> —— {paperQuotes[0].author}《{paperQuotes[0].work}》</span>
          </span>
        </div>
        <script>
          // @ts-nocheck -- legacy inline DOM script; tracked for extraction in docs/SECURITY_AUDIT_REPORT.md.
          const quoteRoot = document.querySelector('[data-paper-quotes]');
          const quoteBody = quoteRoot?.querySelector('[data-paper-quote-body]');
          const quoteContent = quoteRoot?.querySelector('[data-paper-quote-content]');
          const quoteText = quoteRoot?.querySelector('[data-paper-quote-text]');
          const quoteMeta = quoteRoot?.querySelector('[data-paper-quote-meta]');

          if (
            quoteRoot instanceof HTMLElement &&
            quoteBody instanceof HTMLElement &&
            quoteContent instanceof HTMLElement &&
            quoteText instanceof HTMLElement &&
            quoteMeta instanceof HTMLElement
          ) {
            let quotes = [];

            try {
              const parsed = JSON.parse(quoteRoot.dataset.paperQuotes || '[]');
              quotes = Array.isArray(parsed)
                ? parsed.filter(
                    (item) =>
                      item &&
                      typeof item === 'object' &&
                      typeof item.text === 'string' &&
                      item.text.trim() &&
                      typeof item.author === 'string' &&
                      item.author.trim() &&
                      typeof item.work === 'string' &&
                      item.work.trim()
                  )
                : [];
            } catch {
              quotes = [];
            }

            if (quotes.length > 0) {
              const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
              const hoverPauseQuery = window.matchMedia('(hover: hover) and (pointer: fine)');
              const fadeDuration = 220;
              const initialPauseGuardUntil = Date.now() + 1200;
              let currentIndex = Math.floor(Math.random() * quotes.length);
              let rotationTimer = 0;
              let fadeTimer = 0;
              let resizeTimer = 0;
              let paused = false;
              let inView = !('IntersectionObserver' in window);

              function formatQuote(quote) {
                return `${quote.text} —— ${quote.author}《${quote.work}》`;
              }

              function clearTimers() {
                window.clearTimeout(rotationTimer);
                window.clearTimeout(fadeTimer);
                rotationTimer = 0;
                fadeTimer = 0;
              }

              function scheduleAdvance(delay) {
                clearTimers();

                const shouldPause = paused || !inView || document.hidden;
                quoteRoot.classList.toggle('is-paused', shouldPause);

                if (shouldPause) {
                  return;
                }

                rotationTimer = window.setTimeout(() => {
                  if (!reducedMotionQuery.matches) {
                    quoteRoot.classList.add('is-fading');
                  }

                  fadeTimer = window.setTimeout(() => {
                    quoteRoot.classList.remove('is-fading');
                    applyQuote(currentIndex + 1);
                  }, reducedMotionQuery.matches ? 0 : fadeDuration);
                }, delay);
              }

              function applyQuote(index) {
                currentIndex = (index + quotes.length) % quotes.length;
                quoteRoot.classList.remove('is-fading');
                quoteRoot.dataset.animate = 'false';
                quoteRoot.style.removeProperty('--sc-quote-shift');
                quoteRoot.style.removeProperty('--sc-quote-duration');
                quoteText.textContent = quotes[currentIndex].text;
                quoteMeta.textContent = ` —— ${quotes[currentIndex].author}《${quotes[currentIndex].work}》`;
                quoteContent.setAttribute('aria-label', formatQuote(quotes[currentIndex]));
                quoteContent.dataset.paperQuoteFull = formatQuote(quotes[currentIndex]);

                requestAnimationFrame(() => {
                  const overflow = Math.max(0, Math.ceil(quoteContent.scrollWidth - quoteBody.clientWidth));
                  const allowScroll = !reducedMotionQuery.matches && overflow > 12;
                  let displayDuration = reducedMotionQuery.matches ? 10000 : 7800;

                  if (allowScroll) {
                    const distance = overflow + 32;
                    const durationSeconds = Math.max(20, 7 + distance / 16);
                    quoteRoot.dataset.animate = 'true';
                    quoteRoot.style.setProperty('--sc-quote-shift', `-${distance}px`);
                    quoteRoot.style.setProperty('--sc-quote-duration', `${durationSeconds}s`);
                    displayDuration = Math.round(durationSeconds * 1000 + 1200);
                  }

                  scheduleAdvance(displayDuration);
                });
              }

              function pauseQuotes() {
                if (!hoverPauseQuery.matches || Date.now() < initialPauseGuardUntil) {
                  return;
                }

                paused = true;
                quoteRoot.classList.add('is-paused');
                quoteRoot.classList.remove('is-fading');
                clearTimers();
              }

              function resumeQuotes() {
                if (!hoverPauseQuery.matches) {
                  return;
                }

                paused = false;
                quoteRoot.classList.remove('is-paused');
                applyQuote(currentIndex);
              }

              function handleEnvironmentChange() {
                paused = false;
                quoteRoot.classList.remove('is-paused', 'is-fading');
                clearTimers();
                applyQuote(currentIndex);
              }

              function syncPlayback() {
                if (paused || !inView || document.hidden) {
                  quoteRoot.classList.add('is-paused');
                  quoteRoot.classList.remove('is-fading');
                  clearTimers();
                  return;
                }

                quoteRoot.classList.remove('is-paused');
                applyQuote(currentIndex);
              }

              function bindMediaChange(mediaQuery, handler) {
                if ('addEventListener' in mediaQuery) {
                  mediaQuery.addEventListener('change', handler);
                  return;
                }

                mediaQuery.addListener(handler);
              }

              quoteRoot.addEventListener('mouseenter', pauseQuotes);
              quoteRoot.addEventListener('mouseleave', resumeQuotes);

              bindMediaChange(reducedMotionQuery, handleEnvironmentChange);
              bindMediaChange(hoverPauseQuery, handleEnvironmentChange);

              document.addEventListener('visibilitychange', syncPlayback);

              if ('IntersectionObserver' in window) {
                const visibilityObserver = new IntersectionObserver(([entry]) => {
                  inView = entry.isIntersecting;
                  syncPlayback();
                });
                visibilityObserver.observe(quoteRoot);
              }

              window.addEventListener('pagehide', () => {
                clearTimers();
                window.clearTimeout(resizeTimer);
              });
              window.addEventListener('pageshow', syncPlayback);

              window.addEventListener('resize', () => {
                window.clearTimeout(resizeTimer);
                resizeTimer = window.setTimeout(() => {
                  quoteRoot.classList.remove('is-fading');
                  clearTimers();
                  applyQuote(currentIndex);
                }, 120);
              });

              applyQuote(currentIndex);
            }
          }
        </script>
      </section>
    </div>
  </section>
</SiteLayout>
