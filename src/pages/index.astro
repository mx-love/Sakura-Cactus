---
import SiteLayout from '@/components/layout/SiteLayout.astro';

import { getPublicPosts } from '@/features/posts/post.service';

export const prerender = false;

const posts = await getPublicPosts();
---

<SiteLayout>
  <section class="min-h-screen bg-[var(--color-bg)] px-6 py-16 text-[var(--color-text)]">
    <div class="mx-auto flex max-w-4xl flex-col gap-8">
      <p class="text-sm font-medium uppercase tracking-[0.18em] text-[var(--color-muted)]">
        Cloudflare native blog
      </p>
      <div class="space-y-5">
        <h1 class="text-4xl font-semibold sm:text-6xl">Sakura Cactus</h1>
        <p class="max-w-2xl text-lg leading-8 text-[var(--color-muted)]">
          一个基于 Astro、Cloudflare Workers、D1 和 R2 的个人博客系统。文章由后台写入 D1，访客只看到公开发布内容。
        </p>
      </div>
      <div class="space-y-4">
        <h2 class="text-xl font-semibold">Latest posts</h2>
        {
          posts.length === 0 ? (
            <div class="rounded-lg border border-[var(--color-border)] bg-white/70 p-5 shadow-sm">
              <p class="text-sm leading-6 text-[var(--color-muted)]">No published posts yet.</p>
            </div>
          ) : (
            <div class="grid gap-4">
              {posts.map((post) => (
                <article class="rounded-lg border border-[var(--color-border)] bg-white/70 p-5 shadow-sm">
                  <p class="text-xs uppercase text-[var(--color-muted)]">
                    {post.publishedAt ? new Date(post.publishedAt).toLocaleDateString() : 'Published'}
                  </p>
                  <h3 class="mt-2 text-xl font-semibold">
                    <a href={`/posts/${post.slug}`}>{post.title}</a>
                  </h3>
                  {post.excerpt ? <p class="mt-3 text-sm leading-6 text-[var(--color-muted)]">{post.excerpt}</p> : null}
                </article>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </section>
</SiteLayout>
