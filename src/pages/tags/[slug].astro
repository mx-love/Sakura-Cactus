---
import SiteLayout from '@/components/layout/SiteLayout.astro';
import PageHero from '@/components/editorial/PageHero.astro';
import PostIndex from '@/components/editorial/PostIndex.astro';
import Pagination from '@/components/editorial/Pagination.astro';
import { getPublicPostsPage } from '@/features/posts/post.service';
import { getPublicTags } from '@/features/tags/tag.service';
import { ROBOTS_NOINDEX_FOLLOW, absoluteSiteUrl } from '@/lib/seo';

export const prerender = false;

const pageSize = 10;
const slug = Astro.params.slug;
const tags = await getPublicTags();
const tag = slug ? tags.find((item) => item.slug === slug) : null;

if (!slug || !tag) {
  return new Response('Not found', { status: 404 });
}

const pageValue = Number.parseInt(Astro.url.searchParams.get('page') ?? '1', 10);
const currentPage = Number.isFinite(pageValue) && pageValue > 0 ? pageValue : 1;
const { posts, totalCount, newer, older } = await getPublicPostsPage(currentPage, pageSize, { tagSlug: tag.slug });
const totalPages = Math.max(1, Math.ceil(totalCount / pageSize));
const isOutOfRange = totalCount > 0 && currentPage > totalPages;
const basePath = `/tags/${tag.slug}`;
const canonicalUrl = absoluteSiteUrl(currentPage > 1 ? `${basePath}?page=${currentPage}` : basePath);
---

<SiteLayout title={`${tag.name} | Sakura Cactus`} description={`${tag.name} 标签下的公开文章。`} canonicalUrl={canonicalUrl} robots={ROBOTS_NOINDEX_FOLLOW} folio={{ current: Math.min(currentPage, totalPages), total: totalPages }}>
  <section class="sc-page">
    <div class="sc-page-shell">
      <PageHero label="Subject" backHref="/tags" backLabel="The Index" title={tag.name} subtitle={`${tag.name} 标签下的公开文章。`} count={totalCount} />

      {totalCount === 0 ? (
        <div class="sc-empty">
          <p>这个标签下暂无公开文章。</p>
        </div>
      ) : isOutOfRange ? (
        <div class="sc-empty">
          <p>这一页暂时没有文章。</p>
          <a class="sc-inline-link sc-draw-link" href={basePath}>返回第一页 →</a>
        </div>
      ) : (
        <>
          <PostIndex posts={posts} startNumber={(currentPage - 1) * pageSize + 1} />
          {totalPages > 1 ? <Pagination currentPage={currentPage} totalPages={totalPages} basePath={basePath} newer={newer} older={older} label={`${tag.name} 分页`} /> : null}
        </>
      )}
    </div>
  </section>
</SiteLayout>
