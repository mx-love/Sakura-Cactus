---
import SiteLayout from '@/components/layout/SiteLayout.astro';
import { getPublicPosts } from '@/features/posts/post.service';
import { getPublicTags } from '@/features/tags/tag.service';

export const prerender = false;

const slug = Astro.params.slug;
const tags = await getPublicTags();
const tag = slug ? tags.find((item) => item.slug === slug) : null;

const posts = slug
  ? await getPublicPosts({ limit: 100, excludeAbout: true, pinnedFirst: true, tagSlug: slug })
  : [];

if (!slug || !tag) {
  return new Response('Not found', { status: 404 });
}

const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit'
});

function formatDate(value: string | null) {
  return value ? dateFormatter.format(new Date(value)) : '';
}
---

<SiteLayout title={`${tag.name} | Sakura Cactus`} description={`${tag.name} 标签下的公开文章。`}>
  <section class="sc-page">
    <div class="sc-public-shell sc-paper-public-shell">
      <nav class="sc-breadcrumb" aria-label="面包屑">
        <a href="/">首页</a>
        <span>»</span>
        <a href="/tags">标签</a>
        <span>»</span>
        <span>{tag.name}</span>
      </nav>

      <header class="sc-page-header">
        <h1>{tag.name}</h1>
        <p>{posts.length} 篇公开文章</p>
      </header>

      {posts.length === 0 ? (
        <div class="sc-empty">
          <p>这个标签下暂无公开文章。</p>
        </div>
      ) : (
        <div class="sc-post-list sc-paper-index-list">
          {posts.map((post) => (
            <article class="sc-post-entry">
              <h2>
                <a href={`/posts/${post.slug}`}>{post.title}</a>
              </h2>
              {post.publishedAt ? (
                <p class="sc-post-meta">
                  <span class="sc-calendar-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M8 2v4" />
                      <path d="M16 2v4" />
                      <path d="M3 10h18" />
                      <rect x="3" y="4" width="18" height="18" rx="2" />
                    </svg>
                  </span>
                  <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
                </p>
              ) : null}
              {post.excerpt ? <p class="sc-post-excerpt">{post.excerpt}</p> : null}
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</SiteLayout>
