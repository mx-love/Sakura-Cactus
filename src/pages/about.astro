---
import SiteLayout from '@/components/layout/SiteLayout.astro';
import { getPublicPostBySlug, getPublicPosts } from '@/features/posts/post.service';

export const prerender = false;

const posts = await getPublicPosts();
const aboutSummary = posts.find((post) => post.tags.some((tag) => tag.name.toLowerCase() === 'about' || tag.slug === 'about'));
const aboutPost = aboutSummary ? await getPublicPostBySlug(aboutSummary.slug) : null;
---

<SiteLayout
  title={aboutPost ? `${aboutPost.title} | Sakura Cactus` : '关于 | Sakura Cactus'}
  description={aboutPost?.excerpt ?? '关于 Sakura Cactus。'}
  ogImage={aboutPost?.coverImageUrl ?? undefined}
>
  <section class="sc-page">
    <div class="sc-public-shell sc-prose-shell">
      <nav class="sc-breadcrumb" aria-label="面包屑">
        <a href="/">首页</a>
        <span>»</span>
        <span>关于</span>
      </nav>

      {aboutPost ? (
        <article>
          <header class="sc-page-header">
            <h1>{aboutPost.title}</h1>
            {aboutPost.excerpt ? <p>{aboutPost.excerpt}</p> : null}
          </header>
          <div class="sc-prose prose-content" set:html={aboutPost.contentHtml} />
        </article>
      ) : (
        <>
          <header class="sc-page-header">
            <h1>关于</h1>
          </header>
          <div class="sc-empty">
            <p>还没有关于页面。</p>
            <p>发布一篇带 about 标签的文章后，它会显示在这里。</p>
          </div>
        </>
      )}
    </div>
  </section>
</SiteLayout>
