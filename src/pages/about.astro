---
import SiteLayout from '@/components/layout/SiteLayout.astro';
---

<SiteLayout title="About | Sakura Cactus">
  <section class="min-h-screen bg-[var(--color-bg)] px-5 py-12 text-[var(--color-text)]">
    <div class="mx-auto max-w-4xl rounded-[28px] border border-[var(--color-border)] bg-white/75 p-8 shadow-[var(--shadow-soft)]">
      <p class="text-sm text-[var(--color-muted)]">About</p>
      <h1 class="mt-2 text-3xl font-semibold">关于 Sakura Cactus</h1>
      <p class="mt-4 max-w-2xl text-sm leading-7 text-[var(--color-muted)]">
        这里将用于放置个人介绍、站点说明和联系方式。当前是阶段 6 的静态占位页。
      </p>
    </div>
  </section>
</SiteLayout>
