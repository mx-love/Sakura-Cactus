---
import SiteLayout from '@/components/layout/SiteLayout.astro';
import PageHero from '@/components/editorial/PageHero.astro';
import { getPublicArchivePosts } from '@/features/posts/post.service';
import { ROBOTS_NOINDEX_FOLLOW, absoluteSiteUrl } from '@/lib/seo';
import { getSiteDateParts } from '@/lib/site-time';

export const prerender = false;

const posts = await getPublicArchivePosts();
type ArchivePost = (typeof posts)[number] & { day: string };
const monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];

// Group the full public index into year -> month buckets in the site time zone.
const archive = new Map<number, Map<number, ArchivePost[]>>();
for (const post of posts) {
  const parts = getSiteDateParts(new Date(post.publishedAt));
  const months = archive.get(parts.year) ?? new Map<number, ArchivePost[]>();
  const entries = months.get(parts.month) ?? [];
  entries.push({ ...post, day: `${String(parts.month).padStart(2, '0')}.${String(parts.day).padStart(2, '0')}` });
  months.set(parts.month, entries);
  archive.set(parts.year, months);
}

const years = [...archive.keys()].sort((a, b) => b - a).map((year) => {
  const months = archive.get(year)!;
  const monthKeys = [...months.keys()].sort((a, b) => b - a);
  return {
    year,
    count: monthKeys.reduce((sum, month) => sum + months.get(month)!.length, 0),
    months: monthKeys.map((month) => ({ month, posts: months.get(month)! }))
  };
});
const canonicalUrl = absoluteSiteUrl('/timeline');
---

<SiteLayout title="时间轴 | Sakura Cactus" description="公开文章按收录时间归档。" canonicalUrl={canonicalUrl} robots={ROBOTS_NOINDEX_FOLLOW}>
  <section class="sc-page">
    <div class="sc-page-shell">
      <PageHero label="The Chronology" title="时间轴" subtitle="公开文章按收录时间归档。" count={posts.length} />

      {years.length === 0 ? (
        <div class="sc-empty">
          <p>暂无可归档文章。</p>
        </div>
      ) : (
        <>
          {years.length > 1 ? (
            <nav class="sc-year-jump" aria-label="按年份跳转">
              {years.map(({ year }) => <a class="sc-draw-link" href={`#y${year}`}>{year}</a>)}
            </nav>
          ) : null}
          <div class="sc-year-table">
            {years.map(({ year, count, months }) => (
              <section class="sc-year" id={`y${year}`} aria-labelledby={`y${year}-heading`}>
                <header class="sc-year-head">
                  <h2 id={`y${year}-heading`} class="sc-year-title">{year}</h2>
                  <p class="sc-label sc-year-count">{count} 篇</p>
                </header>
                <div class="sc-year-body">
                  {months.map(({ month, posts: monthPosts }) => (
                    <section class="sc-year-month" id={`y${year}-m${String(month).padStart(2, '0')}`}>
                      <h3 class="sc-label sc-year-month-title">{month} 月 · {monthNames[month - 1]}</h3>
                      <ol class="sc-year-list">
                        {monthPosts.map((post) => (
                          <li class="sc-year-entry">
                            <time class="sc-label" datetime={post.publishedAt}>{post.day}</time>
                            <a class="sc-draw-link" href={`/posts/${post.slug}`} data-astro-prefetch>{post.title}</a>
                          </li>
                        ))}
                      </ol>
                    </section>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </>
      )}
    </div>
  </section>
</SiteLayout>
