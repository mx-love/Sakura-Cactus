---
import SiteLayout from '@/components/layout/SiteLayout.astro';
import { getPublicPosts } from '@/features/posts/post.service';
import { ROBOTS_NOINDEX_FOLLOW, absoluteSiteUrl } from '@/lib/seo';
import { formatSiteDate as formatDate, getSiteDateParts } from '@/lib/site-time';

export const prerender = false;

const posts = await getPublicPosts({ limit: 200, excludeAbout: true });

const archive = posts.reduce<Record<string, Record<string, typeof posts>>>((acc, post) => {
  if (!post.publishedAt) {
    return acc;
  }

  const parts = getSiteDateParts(new Date(post.publishedAt));
  const year = String(parts.year);
  const month = String(parts.month).padStart(2, '0');
  acc[year] = acc[year] ?? {};
  acc[year][month] = acc[year][month] ?? [];
  acc[year][month].push(post);
  return acc;
}, {});

const years = Object.keys(archive).sort((a, b) => Number(b) - Number(a));
const canonicalUrl = absoluteSiteUrl('/timeline');
---

<SiteLayout title="时间轴 | Sakura Cactus" description="公开文章按收录时间归档。" canonicalUrl={canonicalUrl} robots={ROBOTS_NOINDEX_FOLLOW}>
  <section class="sc-page">
    <div class="sc-page-shell">
      <div class="sc-paper-public-shell sc-public-page-paper">
      <nav class="sc-breadcrumb" aria-label="面包屑">
        <a href="/">首页</a>
        <span>»</span>
        <span>时间轴</span>
      </nav>

      <header class="sc-page-header">
        <h1>时间轴</h1>
        <p>公开文章按收录时间归档。</p>
      </header>

      {years.length === 0 ? (
        <div class="sc-empty">
          <p>暂无可归档文章。</p>
        </div>
      ) : (
        <div class="sc-archive sc-paper-archive">
          {years.map((year) => (
            <section class="sc-archive-year">
              <h2>{year}</h2>
              {Object.keys(archive[year]).sort((a, b) => Number(b) - Number(a)).map((month) => (
                <section class="sc-archive-month" id={`y${year}-m${month}`}>
                  <h3>{Number(month)}月</h3>
                  <div class="sc-archive-list">
                    {archive[year][month].map((post) => (
                      <article class="sc-archive-entry">
                        <div class="sc-archive-date" aria-label={post.publishedAt ? formatDate(post.publishedAt) : undefined}>
                          {post.publishedAt ? (
                            <time datetime={post.publishedAt}>{formatDate(post.publishedAt, 'month-day')}</time>
                          ) : null}
                        </div>
                        <div class="sc-archive-content">
                          <h4>
                            <a href={`/posts/${post.slug}`} data-astro-prefetch>{post.title}</a>
                          </h4>
                          {post.excerpt ? <p>{post.excerpt}</p> : null}
                        </div>
                      </article>
                    ))}
                  </div>
                </section>
              ))}
            </section>
          ))}
        </div>
      )}
      </div>
    </div>
  </section>
</SiteLayout>
