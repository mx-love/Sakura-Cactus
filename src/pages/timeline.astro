---
import SiteLayout from '@/components/layout/SiteLayout.astro';
import { getPublicPosts } from '@/features/posts/post.service';

export const prerender = false;

const posts = await getPublicPosts({ limit: 200, excludeAbout: true });

const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit'
});

function formatDate(value: string | null) {
  return value ? dateFormatter.format(new Date(value)) : '';
}

function formatMonth(date: Date) {
  return `${date.getMonth() + 1}月`;
}

const archive = posts.reduce<Record<string, Record<string, typeof posts>>>((acc, post) => {
  if (!post.publishedAt) {
    return acc;
  }

  const date = new Date(post.publishedAt);
  const year = String(date.getFullYear());
  const month = String(date.getMonth() + 1).padStart(2, '0');
  acc[year] = acc[year] ?? {};
  acc[year][month] = acc[year][month] ?? [];
  acc[year][month].push(post);
  return acc;
}, {});

const years = Object.keys(archive).sort((a, b) => Number(b) - Number(a));
---

<SiteLayout title="时间轴 | Sakura Cactus" description="所有公开文章按发布时间归档。">
  <section class="sc-page">
    <div class="sc-public-shell sc-paper-public-shell">
      <nav class="sc-breadcrumb" aria-label="面包屑">
        <a href="/">首页</a>
        <span>»</span>
        <span>时间轴</span>
      </nav>

      <header class="sc-page-header">
        <h1>时间轴</h1>
        <p>所有公开文章按发布时间归档。</p>
      </header>

      {years.length === 0 ? (
        <div class="sc-empty">
          <p>暂无可归档文章。</p>
        </div>
      ) : (
        <div class="sc-archive sc-paper-archive">
          {years.map((year) => (
            <section class="sc-archive-year">
              <h2>{year}</h2>
              {Object.keys(archive[year]).sort((a, b) => Number(b) - Number(a)).map((month) => (
                <section class="sc-archive-month">
                  <h3>{formatMonth(new Date(Number(year), Number(month) - 1, 1))}</h3>
                  <div class="sc-archive-list">
                    {archive[year][month].map((post) => (
                      <article class="sc-archive-entry">
                        <div class="sc-archive-date" aria-label={post.publishedAt ? formatDate(post.publishedAt) : undefined}>
                          {post.publishedAt ? (
                            <time datetime={post.publishedAt}>{String(new Date(post.publishedAt).getMonth() + 1).padStart(2, '0')}/{String(new Date(post.publishedAt).getDate()).padStart(2, '0')}</time>
                          ) : null}
                        </div>
                        <div class="sc-archive-content">
                          <h4>
                            <a href={`/posts/${post.slug}`}>{post.title}</a>
                          </h4>
                          {post.excerpt ? <p>{post.excerpt}</p> : null}
                        </div>
                      </article>
                    ))}
                  </div>
                </section>
              ))}
            </section>
          ))}
        </div>
      )}
    </div>
  </section>
</SiteLayout>
