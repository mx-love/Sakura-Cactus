---
import SiteLayout from '@/components/layout/SiteLayout.astro';
import PageHero from '@/components/editorial/PageHero.astro';
import { getPublicArchivePosts, type PublicArchivePost } from '@/features/posts/post.service';
import { ROBOTS_NOINDEX_FOLLOW, absoluteSiteUrl } from '@/lib/seo';
import { getSiteDateParts } from '@/lib/site-time';

export const prerender = false;

const posts = await getPublicArchivePosts();
type ArchiveEntry = PublicArchivePost & { day: string };
const monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const pad = (value: number) => String(value).padStart(2, '0');

// Group the full public index into year -> month buckets in the site time zone.
const archive = new Map<number, Map<number, ArchiveEntry[]>>();
for (const post of posts) {
  const parts = getSiteDateParts(new Date(post.publishedAt));
  const months = archive.get(parts.year) ?? new Map<number, ArchiveEntry[]>();
  const entries = months.get(parts.month) ?? [];
  entries.push({ ...post, excerpt: post.excerpt === post.title ? '' : post.excerpt, day: pad(parts.day) });
  months.set(parts.month, entries);
  archive.set(parts.year, months);
}

// Month bars share one scale across every year so their heights stay comparable.
const busiestMonth = Math.max(1, ...[...archive.values()].flatMap((months) => [...months.values()].map((entries) => entries.length)));
const years = [...archive.keys()].sort((a, b) => b - a).map((year) => {
  const months = archive.get(year)!;
  const monthKeys = [...months.keys()].sort((a, b) => b - a);
  return {
    year,
    count: monthKeys.reduce((sum, month) => sum + months.get(month)!.length, 0),
    bars: monthNames.map((_, index) => {
      const count = months.get(index + 1)?.length ?? 0;
      return { month: index + 1, count, scale: (count / busiestMonth).toFixed(3) };
    }),
    months: monthKeys.map((month) => ({ month, posts: months.get(month)! }))
  };
});
const canonicalUrl = absoluteSiteUrl('/timeline');
---

<SiteLayout title="时间轴 | Sakura Cactus" description="公开文章按收录时间归档。" canonicalUrl={canonicalUrl} robots={ROBOTS_NOINDEX_FOLLOW}>
  <section class="sc-page">
    <div class="sc-page-shell">
      <PageHero label="The Chronology" title="时间轴" subtitle="公开文章按收录时间归档。" count={posts.length} />

      {years.length === 0 ? (
        <div class="sc-empty">
          <p>暂无可归档文章。</p>
        </div>
      ) : (
        <>
          {years.length > 1 ? (
            <nav class="sc-year-jump" aria-label="按年份跳转">
              {years.map(({ year, count }) => (
                <a href={`#y${year}`}>
                  {year}<sup class="sc-year-jump-count" aria-hidden="true">{count}</sup><span class="sr-only">，{count} 篇</span>
                </a>
              ))}
            </nav>
          ) : null}
          <div class="sc-chronology">
            {years.map(({ year, count, bars, months }, yearIndex) => (
              <section class="sc-year" id={`y${year}`} aria-labelledby={`y${year}-heading`} style={`--sc-entry-index:${Math.min(yearIndex, 3)}`}>
                <header class="sc-year-head">
                  <h2 id={`y${year}-heading`} class="sc-year-title">{year}</h2>
                  <div class="sc-year-side">
                    <ol class="sc-month-bars" aria-hidden="true">
                      {bars.map((bar) => (
                        <li class:list={['sc-month-bar', bar.count > 0 && 'sc-month-bar-filled']} style={`--sc-bar:${bar.scale}`}>
                          <span class="sc-month-bar-fill"></span>
                          <span class="sc-month-bar-label">{bar.month}</span>
                        </li>
                      ))}
                    </ol>
                    <p class="sc-label sc-year-count">{count} 篇 · {months.length} 个月</p>
                  </div>
                </header>
                {months.map(({ month, posts: monthPosts }) => (
                  <section class="sc-month" id={`y${year}-m${pad(month)}`} aria-labelledby={`y${year}-m${pad(month)}-heading`}>
                    <header class="sc-month-head">
                      <h3 class="sc-month-no" id={`y${year}-m${pad(month)}-heading`}>
                        <span aria-hidden="true">{pad(month)}</span><span class="sr-only">{year} 年 {month} 月</span>
                      </h3>
                      <p class="sc-label sc-month-name" aria-hidden="true">{monthNames[month - 1]}</p>
                      <p class="sc-label sc-month-count">{monthPosts.length} 篇</p>
                    </header>
                    <ol class="sc-month-list">
                      {monthPosts.map((post) => (
                        <li class="sc-month-entry">
                          <time class="sc-month-day" datetime={post.publishedAt}>{post.day}</time>
                          <div class="sc-month-body">
                            <a class="sc-month-title" href={`/posts/${post.slug}`} data-astro-prefetch>
                              <span class="sc-draw-text">{post.title}</span>
                            </a>
                            {post.excerpt ? <p class="sc-month-excerpt">{post.excerpt}</p> : null}
                          </div>
                          {post.tag ? (
                            <a class="sc-month-tag sc-tag-link" href={`/tags/${post.tag.slug}`} title={post.tag.name}>{post.tag.name}</a>
                          ) : null}
                        </li>
                      ))}
                    </ol>
                  </section>
                ))}
              </section>
            ))}
          </div>
        </>
      )}
    </div>
  </section>
</SiteLayout>
