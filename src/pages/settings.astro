---
import SiteLayout from '@/components/layout/SiteLayout.astro';
import { getCurrentAdminUser } from '@/features/auth/auth.service';

export const prerender = false;

const adminUser = await getCurrentAdminUser(Astro);

if (!adminUser) {
  return Astro.redirect(`/admin/login?next=${encodeURIComponent('/settings')}`);
}

const friendSettings = [
  {
    title: '友链申请',
    description: '允许其他用户申请友链，需要审核。',
    control: 'switch',
    status: '后续接入'
  },
  {
    title: '友链健康监测',
    description: '启用朋友链接可访问性检查。',
    control: 'switch',
    status: '后续接入'
  },
  {
    title: '友链健康监测 User-Agent',
    description: '设置友链可访问性检查时使用的 User-Agent。',
    control: 'button',
    action: '更新',
    status: '后续接入'
  }
];

const otherSettings = [
  {
    title: '启用右上角登录按钮',
    description: '开启后右上角显示登录入口。',
    control: 'switch',
    checked: true,
    status: 'V1 固定启用'
  },
  {
    title: '启用评论',
    description: '开启/关闭文章底部评论入口与评论区。',
    control: 'switch',
    status: '后续接入'
  },
  {
    title: '启用访问量统计',
    description: '启用统计文章 PV 与 UV 功能。',
    control: 'switch',
    status: '计划实现'
  },
  {
    title: 'RSS 订阅链接',
    description: '启用站点底部 RSS 订阅链接。',
    control: 'button',
    action: '查看',
    status: '后续接入'
  },
  {
    title: '网站图标',
    description: '设置显示于浏览器地址栏的图标 Favicon。',
    control: 'button',
    action: '上传',
    status: '计划实现'
  },
  {
    title: '站点底部内容',
    description: '设置显示于站点底部的内容 HTML。',
    control: 'button',
    action: '更新',
    status: '后续接入'
  },
  {
    title: '清除缓存',
    description: '清除缓存文件或过期临时内容，不会删除真实文章、图片或数据。',
    control: 'button',
    action: '清除',
    status: '后续接入',
    danger: true
  },
  {
    title: '从 WordPress 导入',
    description: '上传 WordPress 导出的 XML 文件。',
    control: 'button',
    action: '上传',
    status: '计划实现'
  }
];
---

<SiteLayout title="设置 | Sakura Cactus" description="Sakura Cactus 设置">
  <section class="sc-settings-page">
    <div class="sc-settings-shell">
      <header class="sc-settings-header">
        <h1>设置</h1>
        <p>这些开关和操作会在后续版本逐步接入。</p>
      </header>

      <div class="sc-settings-container">
        <section class="sc-settings-group">
          <h2>友链设置</h2>
          <div class="sc-settings-list">
            {friendSettings.map((item) => (
              <article class="sc-settings-row">
                <div class="sc-settings-copy">
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </div>
                <div class="sc-settings-control">
                  {item.control === 'switch' ? (
                    <label class="sc-switch">
                      <input type="checkbox" checked={Boolean(item.checked)} disabled />
                      <span></span>
                    </label>
                  ) : (
                    <button class="sc-settings-button" type="button" disabled>{item.action}</button>
                  )}
                  <small>{item.status}</small>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="sc-settings-group">
          <h2>其他设置</h2>
          <div class="sc-settings-list">
            {otherSettings.map((item) => (
              <article class="sc-settings-row">
                <div class="sc-settings-copy">
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </div>
                <div class="sc-settings-control">
                  {item.control === 'switch' ? (
                    <label class="sc-switch">
                      <input type="checkbox" checked={Boolean(item.checked)} disabled />
                      <span></span>
                    </label>
                  ) : (
                    <button class={item.danger ? 'sc-settings-button sc-settings-button-danger' : 'sc-settings-button'} type="button" disabled>
                      {item.action}
                    </button>
                  )}
                  <small>{item.status}</small>
                </div>
              </article>
            ))}
          </div>
        </section>
      </div>
    </div>
  </section>
</SiteLayout>
