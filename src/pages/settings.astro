---
import SiteLayout from '@/components/layout/SiteLayout.astro';
import { getCurrentAdminUser } from '@/features/auth/auth.service';
import { getSiteSettings } from '@/features/settings/settings.service';

export const prerender = false;

const adminUser = await getCurrentAdminUser(Astro);

if (!adminUser) {
  return Astro.redirect(`/admin/login?next=${encodeURIComponent('/settings')}`);
}

const settings = await getSiteSettings();
const settingsJson = JSON.stringify(settings).replaceAll('<', '\\u003c');
---

<SiteLayout title="设置 | Sakura Cactus" description="Sakura Cactus 设置">
  <section class="sc-settings-page">
    <div class="sc-settings-shell">
      <header class="sc-settings-header">
        <h1>设置</h1>
      </header>

      <div class="sc-settings-container sc-settings-rows-container">
        <section class="sc-settings-group">
          <h2>友人帐设置</h2>
          <div class="sc-settings-row-list">
            <article class="sc-settings-compact-row">
              <div>
                <h3>友链申请</h3>
                <p>开启后访客可以提交友链申请，提交后需要审核。</p>
              </div>
              <label class="sc-switch">
                <input id="friend-apply-enabled" type="checkbox" checked={settings.friendApplyEnabled} />
                <span></span>
              </label>
            </article>
            <article class="sc-settings-compact-row">
              <div>
                <h3>友链健康监测</h3>
                <p>开启后每周自动检查友链可访问性。无法访问时，友人帐头像会变灰；不会自动删除或隐藏友链。</p>
              </div>
              <div class="sc-settings-inline-actions">
                <label class="sc-switch">
                  <input id="friend-health-enabled" type="checkbox" checked={settings.friendHealthEnabled} />
                  <span></span>
                </label>
                <button class="sc-settings-link" id="friend-health-check-button" type="button" disabled={!settings.friendHealthEnabled}>立即检查</button>
              </div>
            </article>
          </div>
        </section>

        <section class="sc-settings-group">
          <h2>其他设置</h2>
          <div class="sc-settings-row-list">
            <article class="sc-settings-compact-row sc-settings-compact-row-top">
              <div>
                <h3>评论</h3>
                <p>开启或关闭文章底部评论入口。</p>
              </div>
              <label class="sc-switch">
                <input id="comment-enabled" type="checkbox" checked={settings.commentEnabled} />
                <span></span>
              </label>
            </article>

            <article class="sc-settings-compact-row">
              <div>
                <h3>访问量统计</h3>
                <p>关闭时不统计、不显示；开启时记录并显示文章 PV。</p>
              </div>
              <label class="sc-switch">
                <input id="view-count-enabled" type="checkbox" checked={settings.viewCountEnabled} />
                <span></span>
              </label>
            </article>

            <article class="sc-settings-compact-row">
              <div>
                <h3>网站图标</h3>
                <p>使用外部 favicon URL，不上传图片。</p>
              </div>
              <input class="sc-input sc-settings-url-input" id="favicon-url" placeholder="https://example.com/favicon.png" value={settings.faviconUrl} />
            </article>

            <article class="sc-settings-compact-row">
              <div>
                <h3>站点维护</h3>
                <p>清理超过 24 小时、未引用的临时图片。不会删除文章、清空 R2 或清空 D1。</p>
                {settings.maintenanceLastRunAt ? <small>上次执行：{new Date(settings.maintenanceLastRunAt).toLocaleString()}</small> : null}
              </div>
              <button class="sc-settings-link" id="cleanup-assets-button" type="button">清理过期图片</button>
            </article>

            <article class="sc-settings-compact-row">
              <div>
                <h3>WordPress 导入</h3>
              </div>
              <span class="sc-settings-status">待定</span>
            </article>
          </div>

          <div class="sc-settings-savebar">
            <button class="sc-button sc-button-primary" id="settings-save-button" type="button">保存设置</button>
            <p id="settings-message" role="status"></p>
          </div>
        </section>
      </div>
    </div>
  </section>

  <script id="sc-settings-data" type="application/json" set:html={settingsJson}></script>
  <script>
    const message = document.getElementById('settings-message');
    const saveButton = document.getElementById('settings-save-button');
    const cleanupButton = document.getElementById('cleanup-assets-button');
    const friendHealthEnabled = document.getElementById('friend-health-enabled');
    const friendHealthCheckButton = document.getElementById('friend-health-check-button');

    function setMessage(text, isError = false) {
      if (!message) {
        return;
      }

      message.textContent = text;
      message.dataset.state = isError ? 'error' : 'success';
    }

    function fieldValue(id) {
      const field = document.getElementById(id);
      return field && 'value' in field ? field.value : '';
    }

    function checkedValue(id) {
      const field = document.getElementById(id);
      return field instanceof HTMLInputElement ? field.checked : false;
    }

    function syncFriendHealthCheckButton() {
      if (friendHealthEnabled instanceof HTMLInputElement && friendHealthCheckButton instanceof HTMLButtonElement) {
        friendHealthCheckButton.disabled = !friendHealthEnabled.checked;
      }
    }

    async function readError(response, fallback) {
      const payload = await response.json().catch(() => null);
      return payload?.error?.message || fallback;
    }

    saveButton?.addEventListener('click', async () => {
      saveButton.disabled = true;
      saveButton.textContent = '保存中...';
      setMessage('');

      try {
        const response = await fetch('/api/admin/settings', {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json'
          },
          credentials: 'same-origin',
          body: JSON.stringify({
            friendApplyEnabled: checkedValue('friend-apply-enabled'),
            friendHealthEnabled: checkedValue('friend-health-enabled'),
            commentEnabled: checkedValue('comment-enabled'),
            viewCountEnabled: checkedValue('view-count-enabled'),
            faviconUrl: fieldValue('favicon-url')
          })
        });

        if (!response.ok) {
          throw new Error(await readError(response, '保存失败。'));
        }

        setMessage('已保存');
      } catch (error) {
        setMessage(error instanceof Error ? error.message : '保存失败。', true);
      } finally {
        saveButton.disabled = false;
        saveButton.textContent = '保存设置';
      }
    });

    friendHealthEnabled?.addEventListener('change', syncFriendHealthCheckButton);
    syncFriendHealthCheckButton();

    friendHealthCheckButton?.addEventListener('click', async (event) => {
      const button = event.currentTarget;

      if (!(button instanceof HTMLButtonElement)) {
        return;
      }

      button.disabled = true;
      button.textContent = '检查中...';
      setMessage('');

      try {
        const response = await fetch('/api/admin/friends/check-health', {
          method: 'POST',
          credentials: 'same-origin'
        });

        if (!response.ok) {
          throw new Error(await readError(response, '检查失败。'));
        }

        const payload = await response.json();
        const stats = payload.data.stats;
        setMessage(`已检查 ${stats.scanned} 个：正常 ${stats.ok}，受限 ${stats.warning}，不可达 ${stats.down}。`);
      } catch (error) {
        setMessage(error instanceof Error ? error.message : '检查失败。', true);
      } finally {
        button.textContent = '立即检查';
        syncFriendHealthCheckButton();
      }
    });

    cleanupButton?.addEventListener('click', async () => {
      cleanupButton.disabled = true;
      cleanupButton.textContent = '清理中...';
      setMessage('');

      try {
        const response = await fetch('/api/admin/maintenance/cleanup-assets', {
          method: 'POST',
          credentials: 'same-origin'
        });

        if (!response.ok) {
          throw new Error(await readError(response, '清理失败。'));
        }

        const payload = await response.json();
        setMessage(`已清理 ${payload.data.stats.deleted} 个，失败 ${payload.data.stats.failed} 个。`);
      } catch (error) {
        setMessage(error instanceof Error ? error.message : '清理失败。', true);
      } finally {
        cleanupButton.disabled = false;
        cleanupButton.textContent = '清理过期图片';
      }
    });
  </script>
</SiteLayout>
