---
import SiteLayout from '@/components/layout/SiteLayout.astro';
import { getPublicPostsPage } from '@/features/posts/post.service';
import { ROBOTS_INDEX_FOLLOW, ROBOTS_NOINDEX_FOLLOW, absoluteSiteUrl } from '@/lib/seo';
import PageHero from '@/components/editorial/PageHero.astro';
import PostIndex from '@/components/editorial/PostIndex.astro';
import Pagination from '@/components/editorial/Pagination.astro';

export const prerender = false;

const pageSize = 5;
const pageValue = Number.parseInt(Astro.url.searchParams.get('page') ?? '1', 10);
const currentPage = Number.isFinite(pageValue) && pageValue > 0 ? pageValue : 1;
const { posts: pagePosts, totalCount, newer, older } = await getPublicPostsPage(currentPage, pageSize);
const totalPages = Math.max(1, Math.ceil(totalCount / pageSize));
const isOutOfRange = totalCount > 0 && currentPage > totalPages;
const canonicalUrl = currentPage > 1 ? absoluteSiteUrl(`/articles?page=${currentPage}`) : absoluteSiteUrl('/articles');
const robots = currentPage === 1 && !isOutOfRange ? ROBOTS_INDEX_FOLLOW : ROBOTS_NOINDEX_FOLLOW;

---

<SiteLayout title="文章 | Sakura Cactus" description="我收录的文章。" canonicalUrl={canonicalUrl} robots={robots} folio={{ current: Math.min(currentPage, totalPages), total: totalPages }}>
  <section class="sc-page">
    <div class="sc-page-shell">
      <PageHero label="The Archive" title="文章" subtitle="我收录的文章。慢慢写，慢慢读。" count={totalCount} />

      {totalCount === 0 ? (
        <div class="sc-empty">
          <p>暂无公开文章。</p>
        </div>
      ) : isOutOfRange ? (
        <div class="sc-empty">
          <p>这一页暂时没有文章。</p>
          <a class="sc-inline-link sc-draw-link" href="/articles">返回第一页 →</a>
        </div>
      ) : (
        <>
          <PostIndex posts={pagePosts} startNumber={(currentPage - 1) * pageSize + 1} />
          {totalPages > 1 ? <Pagination currentPage={currentPage} totalPages={totalPages} basePath="/articles" newer={newer} older={older} /> : null}
        </>
      )}
    </div>
  </section>
</SiteLayout>
