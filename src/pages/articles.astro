---
import SiteLayout from '@/components/layout/SiteLayout.astro';
import { getPublicPosts } from '@/features/posts/post.service';

export const prerender = false;

function isAboutPost(post: Awaited<ReturnType<typeof getPublicPosts>>[number]) {
  return post.tags.some((tag) => tag.slug === 'about' || tag.name.toLowerCase() === 'about');
}

const posts = (await getPublicPosts()).filter((post) => !isAboutPost(post));

const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit'
});

function formatDate(value: string | null) {
  return value ? dateFormatter.format(new Date(value)) : '';
}
---

<SiteLayout title="文章 | Sakura Cactus" description="我发布的所有文章。">
  <section class="sc-page">
    <div class="sc-public-shell sc-list-shell">
      <nav class="sc-breadcrumb" aria-label="面包屑">
        <a href="/">首页</a>
        <span>»</span>
        <span>文章</span>
      </nav>

      <header class="sc-page-header sc-list-header">
        <h1>文章</h1>
        <p>我发布的所有文章。</p>
      </header>

      {posts.length === 0 ? (
        <div class="sc-empty">
          <p>暂无公开文章。</p>
        </div>
      ) : (
        <div class="sc-post-list sc-compact-post-list">
          {posts.map((post) => (
            <article class="sc-post-entry">
              <h2>
                <a href={`/posts/${post.slug}`}>{post.title}</a>
              </h2>
              {post.publishedAt ? (
                <p class="sc-post-meta">
                  <span class="sc-calendar-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M8 2v4" />
                      <path d="M16 2v4" />
                      <path d="M3 10h18" />
                      <rect x="3" y="4" width="18" height="18" rx="2" />
                    </svg>
                  </span>
                  <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
                </p>
              ) : null}
              {post.excerpt ? <p class="sc-post-excerpt">{post.excerpt}</p> : null}
              {post.tags.length > 0 ? (
                <div class="sc-tag-list">
                  {post.tags.map((tag) => (
                    <a class="sc-tag-link" href={`/tags/${tag.slug}`}>{tag.name}</a>
                  ))}
                </div>
              ) : null}
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</SiteLayout>
