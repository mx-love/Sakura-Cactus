---
import SiteLayout from '@/components/layout/SiteLayout.astro';
import { getPublicPostsPage } from '@/features/posts/post.service';
import { ROBOTS_INDEX_FOLLOW, ROBOTS_NOINDEX_FOLLOW, absoluteSiteUrl } from '@/lib/seo';
import { formatSiteDate as formatDate } from '@/lib/site-time';

export const prerender = false;

const pageSize = 5;
const pageValue = Number.parseInt(Astro.url.searchParams.get('page') ?? '1', 10);
const currentPage = Number.isFinite(pageValue) && pageValue > 0 ? pageValue : 1;
const { posts: pagePosts, totalCount } = await getPublicPostsPage(currentPage, pageSize);
const totalPages = Math.max(1, Math.ceil(totalCount / pageSize));
const isOutOfRange = totalCount > 0 && currentPage > totalPages;
const canonicalUrl = currentPage > 1 ? absoluteSiteUrl(`/articles?page=${currentPage}`) : absoluteSiteUrl('/articles');
const robots = currentPage === 1 && !isOutOfRange ? ROBOTS_INDEX_FOLLOW : ROBOTS_NOINDEX_FOLLOW;

---

<SiteLayout title="文章 | Sakura Cactus" description="我收录的文章。" canonicalUrl={canonicalUrl} robots={robots}>
  <section class="sc-page">
    <div class="sc-page-shell sc-list-shell">
      <div class="sc-paper-public-shell sc-public-page-paper">
      <nav class="sc-breadcrumb" aria-label="面包屑">
        <a href="/">首页</a>
        <span>»</span>
        <span>文章</span>
      </nav>

      <header class="sc-page-header sc-list-header">
        <h1>文章</h1>
        <p>我收录的文章。</p>
      </header>

      {totalCount === 0 ? (
        <div class="sc-empty">
          <p>暂无公开文章。</p>
        </div>
      ) : isOutOfRange ? (
        <div class="sc-empty">
          <p>这一页暂时没有文章。</p>
          <a class="sc-inline-link" href="/articles?page=1">返回第一页 →</a>
        </div>
      ) : (
        <>
          <div class="sc-post-list sc-compact-post-list sc-paper-index-list sc-article-card-list">
            {pagePosts.map((post) => (
              <article class:list={['sc-post-entry', 'sc-article-list-card', post.coverImageUrl && 'sc-article-list-card-with-cover']}>
                <a class="sc-article-card-main" href={`/posts/${post.slug}`} data-astro-prefetch>
                  <h2>{post.title}</h2>
                  {post.publishedAt ? (
                    <p class="sc-post-meta">
                      <span class="sc-calendar-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M8 2v4" />
                          <path d="M16 2v4" />
                          <path d="M3 10h18" />
                          <rect x="3" y="4" width="18" height="18" rx="2" />
                        </svg>
                      </span>
                      <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
                    </p>
                  ) : null}
                  {post.excerpt ? <p class="sc-post-excerpt">{post.excerpt}</p> : null}
                  {post.tags.length > 0 ? (
                    <div class="sc-tag-list">
                      {post.tags.map((tag) => (
                        <span class="sc-tag-link sc-tag-link-static">{tag.name}</span>
                      ))}
                    </div>
                  ) : null}
                </a>
                {post.coverImageUrl ? (
                  <a class="sc-article-card-cover" href={`/posts/${post.slug}`} aria-label={post.title} data-astro-prefetch>
                    <img src={post.coverImageUrl} alt="" loading="lazy" />
                  </a>
                ) : null}
              </article>
            ))}
          </div>

          <nav class="sc-article-pagination" aria-label="文章分页">
            {currentPage > 1 ? (
              <a class="sc-pagination-link sc-pagination-prev" href={`/articles?page=${currentPage - 1}`} rel="prev" data-astro-prefetch>
                <span aria-hidden="true">←</span><span>上一页</span>
              </a>
            ) : (
              <span class="sc-pagination-link sc-pagination-prev sc-pagination-disabled" aria-disabled="true">
                <span aria-hidden="true">←</span><span>上一页</span>
              </span>
            )}
            <span class="sc-pagination-position">
              <span class="sr-only">第 {currentPage} 页，共 {totalPages} 页</span>
              <span class="sc-pagination-numbers" aria-hidden="true">
                <span class="sc-pagination-current">{String(currentPage).padStart(2, '0')}</span>
                <span class="sc-pagination-divider">/</span>
                <span>{String(totalPages).padStart(2, '0')}</span>
              </span>
            </span>
            {currentPage < totalPages ? (
              <a class="sc-pagination-link sc-pagination-next" href={`/articles?page=${currentPage + 1}`} rel="next" data-astro-prefetch>
                <span>下一页</span><span aria-hidden="true">→</span>
              </a>
            ) : (
              <span class="sc-pagination-link sc-pagination-next sc-pagination-disabled" aria-disabled="true">
                <span>下一页</span><span aria-hidden="true">→</span>
              </span>
            )}
          </nav>
        </>
      )}
      </div>
    </div>
  </section>
</SiteLayout>
