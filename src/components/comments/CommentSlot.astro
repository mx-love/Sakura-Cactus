---
interface Props {
  enabled: boolean;
  serverURL?: string;
  path: string;
}

const { enabled, serverURL = '', path } = Astro.props;
const safeServerURL = serverURL.startsWith('https://') ? serverURL : '';
const shouldRender = enabled && safeServerURL;
---

{shouldRender ? (
  <section class="sc-comments sc-article-inner" aria-label="评论" data-waline-section>
    <div data-waline-controls>
      <p class="sc-field-hint" role="status" aria-live="polite" data-waline-status>评论将在接近此处时加载。</p>
      <button class="sc-button sc-button-secondary sc-button-small" type="button" data-waline-load>加载评论</button>
    </div>
    <div id="sakura-comments" data-server-url={safeServerURL} data-page-path={path}></div>
    <script>
      import { setupWalineComments } from '@/lib/comments-client';

      setupWalineComments();
    </script>
  </section>
) : null}
