---
import SiteLayout from './SiteLayout.astro';
import { SignOutButton } from '@/components/admin/SignOutButton';
import { getCurrentAdminUser } from '@/features/auth/auth.service';

interface Props {
  title?: string;
  heading?: string;
  eyebrow?: string;
  wide?: boolean;
  bare?: boolean;
}

const {
  title = 'Sakura Cactus',
  heading = '写作',
  eyebrow = 'Private',
  wide = false,
  bare = false
} = Astro.props;

const user = await getCurrentAdminUser(Astro);

if (!user) {
  return Astro.redirect(`/admin/login?next=${encodeURIComponent(`${Astro.url.pathname}${Astro.url.search}`)}`);
}

const pathname = Astro.url.pathname;
---

<SiteLayout title={title} showHeader={false}>
  <section class="sc-admin-page">
    {
      !bare ? (
        <header class="sc-admin-bar sticky top-0 z-30">
          <div class="mx-auto flex max-w-[1080px] items-center justify-between gap-4 px-4 py-3">
            <a class="font-extrabold tracking-tight" href="/">Sakura Cactus</a>
            <nav class="flex items-center gap-1">
              <a class={`sc-admin-nav-link ${pathname.startsWith('/write') ? 'sc-admin-nav-link-active' : ''}`} href="/write">写作</a>
              <a class={`sc-admin-nav-link ${pathname === '/settings' ? 'sc-admin-nav-link-active' : ''}`} href="/settings">设置</a>
              <a class="sc-admin-nav-link" href="/articles">查看</a>
            </nav>
            <div class="hidden sm:block">
              <SignOutButton client:load />
            </div>
          </div>
        </header>
      ) : null
    }

    <div class={wide ? 'mx-auto max-w-[1180px] px-4 py-5' : 'sc-shell'}>
      {
        !bare ? (
          <header class="mb-8">
            <p class="text-sm font-bold uppercase tracking-[0.12em] text-[var(--color-subtle)]">{eyebrow}</p>
            <h1 class="mt-2 text-3xl font-extrabold tracking-tight">{heading}</h1>
          </header>
        ) : null
      }
      <slot />
    </div>
  </section>
</SiteLayout>
