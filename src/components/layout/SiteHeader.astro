---
import { getCurrentAdminUser } from '@/features/auth/auth.service';
import { env } from 'cloudflare:workers';

const leadingNavItems = [
  { href: '/articles', label: '文章' },
  { href: '/timeline', label: '时间轴' },
  { href: '/tags', label: '标签' }
];

const trailingNavItems = [
  { href: '/friends', label: '友人帐' },
  { href: '/about', label: '关于' }
];

const publicNavItems = [...leadingNavItems, ...trailingNavItems];

const adminUser = await getCurrentAdminUser(Astro);
const pathname = Astro.url.pathname;
const nextPath = `${Astro.url.pathname}${Astro.url.search}`;
const accountHref = `/admin/login?next=${encodeURIComponent(nextPath)}`;
const avatarUrl = adminUser ? env.SITE_AVATAR_URL?.trim() : '';
const siteName = env.SITE_NAME?.trim() || 'Sakura Cactus';
const shouldReloadAdminBfcache = Boolean(adminUser) && !(
  pathname.startsWith('/admin') ||
  pathname.startsWith('/write') ||
  pathname.startsWith('/settings')
);

function isActive(href: string) {
  return pathname === href || (href !== '/' && pathname.startsWith(`${href}/`));
}
---

<header class="sc-site-header">
  <div class="sc-site-header-inner">
    <a class="sc-site-title" href="/" aria-current={pathname === '/' ? 'page' : undefined} data-astro-prefetch>{siteName}</a>

    <nav class="sc-site-nav" aria-label="主导航">
      {leadingNavItems.map((item) => (
        <a
          class={`sc-site-nav-link ${isActive(item.href) ? 'sc-site-nav-link-active' : ''}`}
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          data-astro-prefetch
        >
          {item.label}
        </a>
      ))}
      {adminUser ? (
        <a class={`sc-site-nav-link ${pathname.startsWith('/write') ? 'sc-site-nav-link-active' : ''}`} href="/write" aria-current={pathname.startsWith('/write') ? 'page' : undefined}>写作</a>
      ) : null}
      {trailingNavItems.map((item) => (
        <a
          class={`sc-site-nav-link ${isActive(item.href) ? 'sc-site-nav-link-active' : ''}`}
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          data-astro-prefetch
        >
          {item.label}
        </a>
      ))}
      {adminUser ? (
        <a class={`sc-site-nav-link ${pathname === '/settings' ? 'sc-site-nav-link-active' : ''}`} href="/settings" aria-current={isActive('/settings') ? 'page' : undefined}>设置</a>
      ) : null}
    </nav>

    <div class="sc-site-actions">
      <a class="sc-icon-link" href="/search" aria-label="搜索" title="搜索" data-search-open>
        <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m21 21-4.35-4.35" />
          <circle cx="11" cy="11" r="7" />
        </svg>
      </a>
      <a class="sc-icon-link" href="/rss.xml" aria-label="RSS" title="RSS">
        <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 11a9 9 0 0 1 9 9" />
          <path d="M4 4a16 16 0 0 1 16 16" />
          <circle cx="5" cy="19" r="1" />
        </svg>
      </a>
      {adminUser ? (
        <button class="sc-icon-link sc-account-button" type="button" aria-label="账号" title="账号" data-account-logout>
          <span class="sc-account-default" data-account-default>
            {avatarUrl ? (
              <>
                <img class="sc-account-avatar" src={avatarUrl} alt="" width="32" height="32" loading="eager" decoding="async" data-account-avatar />
                <span class="sc-account-fallback" data-account-fallback>
                  <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 21a8 8 0 0 0-16 0" />
                    <circle cx="12" cy="7" r="4" />
                  </svg>
                </span>
              </>
            ) : (
              <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21a8 8 0 0 0-16 0" />
                <circle cx="12" cy="7" r="4" />
              </svg>
            )}
          </span>
          <span class="sc-account-logout-icon" aria-hidden="true">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
              <path d="M16 17l5-5-5-5" />
              <path d="M21 12H9" />
            </svg>
          </span>
        </button>
      ) : (
        <a class="sc-icon-link" href={accountHref} aria-label="登录" title="登录">
          <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 21a8 8 0 0 0-16 0" />
            <circle cx="12" cy="7" r="4" />
          </svg>
        </a>
      )}

      <details class="relative md:hidden" data-mobile-menu>
        <summary class="sc-icon-link list-none" aria-label="菜单" aria-expanded="false" data-mobile-menu-toggle>
          <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 7h16" />
            <path d="M4 12h16" />
            <path d="M4 17h16" />
          </svg>
        </summary>
        <div class="sc-mobile-menu">
          {publicNavItems.map((item) => (
            <a class="sc-mobile-menu-link" href={item.href} aria-current={isActive(item.href) ? 'page' : undefined} data-astro-prefetch>
              {item.label}
            </a>
          ))}
          {adminUser ? (
            <>
              <div class="sc-mobile-menu-divider"></div>
              <a class="sc-mobile-menu-link" href="/write" aria-current={isActive('/write') ? 'page' : undefined}>写作</a>
              <a class="sc-mobile-menu-link" href="/settings" aria-current={isActive('/settings') ? 'page' : undefined}>设置</a>
            </>
          ) : null}
        </div>
      </details>
    </div>
  </div>
  <div class="sc-search-overlay" hidden data-search-overlay data-site-search="overlay">
    <button class="sc-search-backdrop" type="button" aria-label="关闭搜索" data-search-close></button>
    <section class="sc-search-dialog" role="dialog" aria-modal="true" aria-label="搜索">
      <div class="sc-search-box">
        <div class="sc-search-overlay-input-row">
          <input id="site-search-overlay-input" class="sc-search-overlay-input" type="search" placeholder="请输入关键字" autocomplete="off" aria-label="搜索公开文章" aria-controls="site-search-overlay-results" data-search-input />
          <button class="sc-search-close" type="button" aria-label="关闭搜索" data-search-close>关闭</button>
        </div>
        <p class="sc-search-overlay-status" role="status" aria-live="polite" aria-atomic="true" data-search-status hidden></p>
        <button class="sc-button sc-button-secondary sc-button-small" type="button" data-search-retry hidden>重新搜索</button>
        <div id="site-search-overlay-results" class="sc-search-overlay-results" data-search-results></div>
      </div>
    </section>
  </div>
  <script is:inline>
    (() => {
      const menu = document.querySelector('[data-mobile-menu]');
      const toggle = menu?.querySelector('[data-mobile-menu-toggle]');

      if (!(menu instanceof HTMLDetailsElement) || !(toggle instanceof HTMLElement)) return;

      function syncExpanded() {
        toggle.setAttribute('aria-expanded', menu.open ? 'true' : 'false');
      }

      function closeMenu() {
        if (!menu.open) return;
        menu.open = false;
        syncExpanded();
      }

      menu.addEventListener('toggle', syncExpanded);

      document.addEventListener('click', (event) => {
        if (!menu.open) return;
        const target = event.target;

        if (target instanceof Node && menu.contains(target)) {
          if (target instanceof HTMLAnchorElement) {
            closeMenu();
          }
          return;
        }

        closeMenu();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          closeMenu();
        }
      });

      syncExpanded();
    })();
  </script>
  <script>
    import { bindSiteSearch } from '@/lib/site-search';
    bindSiteSearch();
  </script>
  {adminUser ? (
    <script is:inline>
      (() => {
        const button = document.querySelector('[data-account-logout]');
        if (!(button instanceof HTMLButtonElement)) return;

        const avatar = button.querySelector('[data-account-avatar]');
        const fallback = button.querySelector('[data-account-fallback]');
        let armed = false;
        let timer = 0;

        function setArmed(nextArmed) {
          armed = nextArmed;
          button.classList.toggle('sc-account-armed', armed);
          button.setAttribute('aria-label', armed ? '再次点击退出' : '账号');
          button.setAttribute('title', armed ? '再次点击退出' : '账号');

          if (timer) {
            window.clearTimeout(timer);
            timer = 0;
          }

          if (armed) {
            timer = window.setTimeout(() => setArmed(false), 3000);
          }
        }

        if (avatar instanceof HTMLImageElement && fallback instanceof HTMLElement) {
          function showAvatar() {
            button.classList.add('sc-account-avatar-ready');
          }

          function showFallback() {
            avatar.hidden = true;
            fallback.hidden = false;
            button.classList.remove('sc-account-avatar-ready');
          }

          if (avatar.complete) {
            if (avatar.naturalWidth > 0) {
              showAvatar();
            } else {
              showFallback();
            }
          }

          avatar.addEventListener('load', showAvatar, { once: true });
          avatar.addEventListener('error', () => {
            showFallback();
          }, { once: true });
        }

        button.addEventListener('click', async () => {
          if (!armed) {
            setArmed(true);
            return;
          }

          setArmed(false);

          try {
            const response = await fetch('/api/auth/logout', {
              method: 'POST',
              credentials: 'same-origin'
            });

            if (response.ok) {
              window.location.assign('/');
            }
          } catch {
            setArmed(false);
          }
        });
      })();
    </script>
  ) : null}
  {shouldReloadAdminBfcache ? (
    <script is:inline>
      window.addEventListener('pageshow', (event) => {
        if (event.persisted) {
          window.location.reload();
        }
      });
    </script>
  ) : null}
</header>
