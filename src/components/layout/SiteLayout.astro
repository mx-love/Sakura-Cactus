---
import '@/styles/global.css';
import SiteHeader from './SiteHeader.astro';

interface Props {
  title?: string;
  description?: string;
  showHeader?: boolean;
}

const {
  title = 'Sakura Cactus',
  description = 'A Cloudflare-native personal blog with an admin dashboard.',
  showHeader = true
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    {showHeader ? <SiteHeader /> : null}
    <main>
      <slot />
    </main>
  </body>
</html>
