---
import '@/styles/article-image-viewer.css';
---

<dialog class="sc-article-image-viewer" id="sc-article-image-viewer" data-article-image-viewer aria-label="图片查看器">
  <div class="sc-article-image-viewer-shell" data-viewer-shell>
    <button class="sc-article-image-viewer-close" type="button" data-viewer-close aria-label="关闭图片查看器" autofocus>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>

    <div class="sc-article-image-viewer-stage" data-viewer-stage>
      <img class="sc-article-image-viewer-image" data-viewer-image alt="" draggable="false" />
    </div>

    <div class="sc-article-image-viewer-toolbar" role="toolbar" aria-label="图片查看工具">
      <button class="sc-article-image-viewer-control" type="button" data-viewer-zoom-out aria-label="缩小图片">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14" /></svg>
      </button>
      <button class="sc-article-image-viewer-control" type="button" data-viewer-fit aria-label="适合窗口">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5" /></svg>
      </button>
      <button class="sc-article-image-viewer-control" type="button" data-viewer-zoom-in aria-label="放大图片">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
      </button>
      <a class="sc-article-image-viewer-control" data-viewer-original target="_blank" rel="noopener noreferrer" aria-label="打开原图">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 5h5v5M19 5l-9 9" /><path d="M19 13v6H5V5h6" /></svg>
      </a>
    </div>
  </div>
</dialog>

<script>
  import { bindArticleImageViewer } from '@/lib/article-image-viewer';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => bindArticleImageViewer(), { once: true });
  } else {
    bindArticleImageViewer();
  }
</script>
