---
import '@/styles/article-image-viewer.css';
---

<dialog class="sc-article-image-viewer" id="sc-article-image-viewer" data-article-image-viewer aria-label="文章图片查看器">
  <div class="sc-article-image-viewer-shell" data-viewer-shell>
    <div class="sc-article-image-viewer-backdrop" data-viewer-backdrop aria-hidden="true"></div>

    <div class="sc-article-image-viewer-topbar">
      <button class="sc-article-image-viewer-close" type="button" data-viewer-close aria-label="关闭图片查看器" autofocus>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
      <output class="sc-article-image-viewer-count" data-viewer-count aria-live="polite"></output>
    </div>

    <div class="sc-article-image-viewer-stage" data-viewer-stage>
      <img class="sc-article-image-viewer-image" data-viewer-image alt="" draggable="false" />
      <div class="sc-article-image-viewer-status" data-viewer-status role="status" aria-live="polite"></div>
    </div>

    <button class="sc-article-image-viewer-nav sc-article-image-viewer-prev" type="button" data-viewer-prev aria-label="上一张图片">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
    </button>
    <button class="sc-article-image-viewer-nav sc-article-image-viewer-next" type="button" data-viewer-next aria-label="下一张图片">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
    </button>

    <p class="sc-article-image-viewer-caption" data-viewer-caption></p>

    <div class="sc-article-image-viewer-toolbar" role="toolbar" aria-label="图片查看工具">
      <button class="sc-article-image-viewer-control sc-article-image-viewer-zoom" type="button" data-viewer-zoom aria-label="放大图片">
        <svg class="sc-viewer-icon-zoom-in" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 5 5M10.5 7.5v6M7.5 10.5h6" />
        </svg>
        <svg class="sc-viewer-icon-fit" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5" />
        </svg>
      </button>
      <a class="sc-article-image-viewer-control sc-article-image-viewer-original" data-viewer-original target="_blank" rel="noopener noreferrer" aria-label="在新标签页打开原图">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 5h5v5M19 5l-9 9" /><path d="M19 13v6H5V5h6" /></svg>
        <span>查看原图</span>
      </a>
    </div>

    <p class="sc-article-image-viewer-hint" data-viewer-hint>双指缩放 · 双击放大</p>
  </div>
</dialog>

<script>
  import { bindArticleImageViewer } from '@/lib/article-image-viewer';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => bindArticleImageViewer(), { once: true });
  } else {
    bindArticleImageViewer();
  }
</script>
