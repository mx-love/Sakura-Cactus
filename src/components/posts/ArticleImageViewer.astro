---
import '@/styles/article-image-viewer.css';
---

<dialog
  id="sc-article-image-viewer"
  class="sc-article-image-viewer"
  data-article-image-viewer
  aria-modal="true"
  aria-labelledby="sc-article-image-viewer-title"
>
  <h2 id="sc-article-image-viewer-title" class="sc-article-image-viewer-title">图片查看器</h2>

  <div class="sc-article-image-viewer-stage" data-viewer-stage>
    <img
      class="sc-article-image-viewer-image"
      data-viewer-image
      alt=""
      draggable="false"
    />
  </div>

  <p class="sc-article-image-viewer-caption" data-viewer-caption hidden></p>

  <div class="sc-article-image-viewer-toolbar" role="toolbar" aria-label="图片查看工具">
    <button
      class="sc-article-image-viewer-control"
      type="button"
      data-viewer-close
      aria-label="关闭图片查看器"
    >
      ×
    </button>
    <button
      class="sc-article-image-viewer-control"
      type="button"
      data-viewer-zoom-out
      aria-label="缩小图片"
    >
      −
    </button>
    <button
      class="sc-article-image-viewer-control"
      type="button"
      data-viewer-reset
      aria-label="恢复图片以适合窗口"
    >
      适合
    </button>
    <button
      class="sc-article-image-viewer-control"
      type="button"
      data-viewer-zoom-in
      aria-label="放大图片"
    >
      +
    </button>
    <a
      class="sc-article-image-viewer-control sc-article-image-viewer-source"
      data-viewer-source
      target="_blank"
      rel="noopener noreferrer"
      aria-label="打开原图"
      hidden
    >
      原图
    </a>
  </div>
</dialog>
