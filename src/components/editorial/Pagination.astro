---
import EntryNav from './EntryNav.astro';
import type { PublicPageNeighbor } from '@/features/posts/post.service';
import { formatSiteDotDate } from '@/lib/site-time';

// List pagination without page numbers or ornaments: the masthead strip
// carries "Page 06 / 42"; here only the Newer/Older neighbours, each labelled
// by the first post on that page. The year index lives in the nav (时间轴).
interface Props {
  currentPage: number;
  totalPages: number;
  basePath: string;
  newer: PublicPageNeighbor | null;
  older: PublicPageNeighbor | null;
  label?: string;
}

const { currentPage, totalPages, basePath, newer, older, label = '文章分页' } = Astro.props;
const pageHref = (page: number) => (page <= 1 ? basePath : `${basePath}?page=${page}`);
const detail = (item: PublicPageNeighbor) =>
  [`No.${String(item.firstNumber).padStart(2, '0')} 起`, item.publishedAt ? formatSiteDotDate(item.publishedAt) : null]
    .filter(Boolean)
    .join(' · ');
const toItem = (item: PublicPageNeighbor | null, labelText: string) =>
  item
    ? {
        href: pageHref(item.page),
        label: labelText,
        title: item.title,
        detail: detail(item),
        ariaLabel: `${labelText}：第 ${item.page} 页，共 ${totalPages} 页，从《${item.title}》开始`
      }
    : null;
---

<div class="sc-pagination">
  <p class="sr-only">第 {currentPage} 页，共 {totalPages} 页</p>
  <EntryNav ariaLabel={label} newer={toItem(newer, 'Newer · 较新的一页')} older={toItem(older, 'Older · 较早的一页')} />
</div>
